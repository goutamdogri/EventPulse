# Stage 2 Kafka (docker-compose.kafka.yml).
# REQUIRED: KRaft cluster id shared by the 3 brokers. Generate once with
#   docker run --rm apache/kafka:4.3.2 /opt/kafka/bin/kafka-storage.sh random-uuid
# and never change it while the broker volumes exist. The rest are optional.
