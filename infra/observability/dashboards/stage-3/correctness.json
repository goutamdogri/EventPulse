        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(rate(ep_idem_requests_total{job=\"eventpulse-nodejs\",result=\"in_progress\"}[1m]))",
          "legendFormat": "API: in progress (409)"
