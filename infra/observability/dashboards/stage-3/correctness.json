        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum by (cause) (rate(ep_sink_duplicates_total{job=\"eventpulse-consumer-sink\"}[1m]))",
          "legendFormat": "sink: {{cause}}"
        }
      ]
