  "timezone": "",
  "panels": [
    {
      "type": "row",
      "title": "Duplicates by layer (S3-F3): every duplicate is counted where it was stopped",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
