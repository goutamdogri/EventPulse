   "link": null,
   "locked": false,
   "fontSize": 21,
   "fontFamily": 5,
   "text": "3. NEVER return 5xx for a duplicate of a SUCCESSFUL request\nThat trains the client to retry forever.",
   "originalText": "3. NEVER return 5xx for a duplicate of a SUCCESSFUL request\nThat trains the client to retry forever.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "d15_0080",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
