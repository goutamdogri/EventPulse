   "link": null,
   "locked": false,
   "fontSize": 21,
   "fontFamily": 5,
   "text": "2. MARK REPLAYS with a response header\nClients and dashboards can then tell replays apart (useful for S3-F3\nvisibility).",
   "originalText": "2. MARK REPLAYS with a response header\nClients and dashboards can then tell replays apart (useful for S3-F3\nvisibility).",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "d15_0078",
   "autoResize": true,
   "lineHeight": 1.25
  },
