   "fontSize": 21,
   "fontFamily": 5,
   "text": "OPTION B  (extra lookup only on the conflict path)\nINSERT INTO events (...) VALUES (...)\nON CONFLICT (tenant_id, event_id) DO NOTHING\nRETURNING event_id;\n-- 0 rows? SELECT the existing payload_hash\n--         and compare it with the new one",
   "originalText": "OPTION B  (extra lookup only on the conflict path)\nINSERT INTO events (...) VALUES (...)\nON CONFLICT (tenant_id, event_id) DO NOTHING\nRETURNING event_id;\n-- 0 rows? SELECT the existing payload_hash\n--         and compare it with the new one",
   "textAlign": "left",
   "verticalAlign": "middle",
