   "link": null,
   "locked": false,
   "fontSize": 20,
   "fontFamily": 5,
   "text": "REDIS\nSET idem:{tenant}:{op}:{key}\n  \"{state:IN_PROGRESS, hash:H,\n    started:T}\"\n  NX  EX 86400\n\nOK    : you own the claim, proceed\n(nil) : someone else has it;\n        GET the value and decide",
   "originalText": "REDIS\nSET idem:{tenant}:{op}:{key}\n  \"{state:IN_PROGRESS, hash:H,\n    started:T}\"\n  NX  EX 86400\n\nOK    : you own the claim, proceed\n(nil) : someone else has it;\n        GET the value and decide",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "d16_0050",
   "autoResize": true,
   "lineHeight": 1.25
  },
