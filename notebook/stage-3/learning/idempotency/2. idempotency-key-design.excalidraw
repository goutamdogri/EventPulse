   "fontSize": 20,
   "fontFamily": 5,
   "text": "POST /v1/events\nAuthorization: <tenant credentials>\nIdempotency-Key: <optional; if absent, event_id\n                  from the body is the key>\n{ 'event_id': '...', 'type': '...', 'occurred_at': '...', ... }",
   "originalText": "POST /v1/events\nAuthorization: <tenant credentials>\nIdempotency-Key: <optional; if absent, event_id\n                  from the body is the key>\n{ 'event_id': '...', 'type': '...', 'occurred_at': '...', ... }",
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d21_0003",
   "autoResize": true,
   "lineHeight": 1.25
  },
