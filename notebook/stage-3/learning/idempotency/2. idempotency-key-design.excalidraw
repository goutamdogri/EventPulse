   "fontSize": 21,
   "fontFamily": 5,
   "text": "DERIVED KEY per downstream effect ({event_id}:{target}) lets each target dedup independently and stops one key\ncolliding across two DIFFERENT effects (charging and emailing are not 'duplicates' of each other).",
   "originalText": "DERIVED KEY per downstream effect ({event_id}:{target}) lets each target dedup independently and stops one key\ncolliding across two DIFFERENT effects (charging and emailing are not 'duplicates' of each other).",
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "d19_0044",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d19_0046",
   "type": "text",
   "x": 50,
   "y": 27798.5,
   "width": 389.3,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#c92a2a",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_19",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1526246282,
   "version": 1,
   "versionNonce": 909278666,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "fontSize": 26,
   "fontFamily": 5,
   "text": "Do not confuse the two 'keys'",
   "originalText": "Do not confuse the two 'keys'",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
