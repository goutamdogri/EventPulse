   "fontSize": 21,
   "fontFamily": 5,
   "text": "Contract wording: 'A key older than the window is treated as new at the API; storage is still protected by the sink's unique constraint.'\nTrue ONLY if that constraint exists. A system with only a TTL'd key store has a BOUNDED idempotency guarantee.",
   "originalText": "Contract wording: 'A key older than the window is treated as new at the API; storage is still protected by the sink's unique constraint.'\nTrue ONLY if that constraint exists. A system with only a TTL'd key store has a BOUNDED idempotency guarantee.",
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "d14_0058",
   "autoResize": true,
   "lineHeight": 1.25
  },
