   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "fontSize": 21,
   "fontFamily": 5,
   "text": "A 409 for an in-progress duplicate is NOT a failure of the design: it is a defined state, to be retried with the same key.",
   "originalText": "A 409 for an in-progress duplicate is NOT a failure of the design: it is a defined state, to be retried with the same key.",
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "d15_0084",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "link15_0001",
   "type": "arrow",
