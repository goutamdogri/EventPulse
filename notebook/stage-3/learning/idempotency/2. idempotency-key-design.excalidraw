   "link": null,
   "locked": false,
   "fontSize": 21,
   "fontFamily": 5,
   "text": "4. After a 5xx, retry with the SAME key, and document it\nA client that mints a new key on 5xx recreates the duplicate problem.",
   "originalText": "4. After a 5xx, retry with the SAME key, and document it\nA client that mints a new key on 5xx recreates the duplicate problem.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "d15_0082",
   "autoResize": true,
   "lineHeight": 1.25
  },
