   "versionNonce": 469594568,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "fontSize": 21,
   "fontFamily": 5,
   "text": "WITHOUT canonicalisation, key order, whitespace and 1.0 vs 1 give different hashes: harmless retries become FALSE mismatches.\nStore only the HASH, not the body: saves space and avoids keeping sensitive data.",
   "originalText": "WITHOUT canonicalisation, key order, whitespace and 1.0 vs 1 give different hashes: harmless retries become FALSE mismatches.\nStore only the HASH, not the body: saves space and avoids keeping sensitive data.",
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "d12_0040",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d12_0042",
   "type": "text",
   "x": 50,
   "y": 16720.75,
   "width": 1313.74,
   "height": 30.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_12",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 527427271,
   "version": 1,
   "versionNonce": 1862243927,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "fontSize": 24,
   "fontFamily": 5,
   "text": "Mismatch at the SINK: ON CONFLICT DO NOTHING cannot tell same from different content (both are no-ops)",
   "originalText": "Mismatch at the SINK: ON CONFLICT DO NOTHING cannot tell same from different content (both are no-ops)",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
