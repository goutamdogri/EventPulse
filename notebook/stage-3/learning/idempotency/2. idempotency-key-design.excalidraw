   "fontSize": 21,
   "fontFamily": 5,
   "text": "FENCING TOKEN = the claim's version number, compared when completing. It stops a late, stale owner from overwriting\nthe new owner's DONE record. (It protects the RECORD; the idempotent effect protects the DATA.)",
   "originalText": "FENCING TOKEN = the claim's version number, compared when completing. It stops a late, stale owner from overwriting\nthe new owner's DONE record. (It protects the RECORD; the idempotent effect protects the DATA.)",
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "d17_0043",
   "autoResize": true,
   "lineHeight": 1.25
  },
