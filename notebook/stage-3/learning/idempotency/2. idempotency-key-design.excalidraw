   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "fontSize": 20,
   "fontFamily": 5,
   "text": "POSTGRES\nINSERT INTO idempotency_keys\n  (tenant_id, op, key, request_hash, state, locked_until)\nVALUES ($1, $2, $3, $4, 'IN_PROGRESS',\n        now() + interval '30 seconds')\nON CONFLICT (tenant_id, op, key) DO NOTHING\nRETURNING 1;\n-- row returned: you own the claim\n-- zero rows: read the existing row and decide",
   "originalText": "POSTGRES\nINSERT INTO idempotency_keys\n  (tenant_id, op, key, request_hash, state, locked_until)\nVALUES ($1, $2, $3, $4, 'IN_PROGRESS',\n        now() + interval '30 seconds')\nON CONFLICT (tenant_id, op, key) DO NOTHING\nRETURNING 1;\n-- row returned: you own the claim\n-- zero rows: read the existing row and decide",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "d16_0052",
   "autoResize": true,
   "lineHeight": 1.25
  },
