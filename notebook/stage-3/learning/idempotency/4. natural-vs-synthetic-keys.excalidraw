   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Can timestamps or a sequence save it?",
   "originalText": "Can timestamps or a sequence save it?",
   "fontSize": 22,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "d08_t022",
   "type": "text",
   "x": 876,
   "y": 10906.75,
   "width": 712.22,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_08",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 657005937,
   "version": 1,
   "versionNonce": 414626515,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Timestamps help only down to the clock's resolution. Adding a client\nsequence number or id into the hash fixes it, but then you are back to a\nNATURAL key.",
   "originalText": "Timestamps help only down to the clock's resolution. Adding a client\nsequence number or id into the hash fixes it, but then you are back to a\nNATURAL key.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
