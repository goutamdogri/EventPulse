   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Two DIFFERENT inputs yield the SAME hash value.\nA MATH risk. Negligible for SHA-256.",
   "originalText": "Two DIFFERENT inputs yield the SAME hash value.\nA MATH risk. Negligible for SHA-256.",
