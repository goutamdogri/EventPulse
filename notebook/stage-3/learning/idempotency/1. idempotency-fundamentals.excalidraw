   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Exactly-once effect IS idempotency (or atomicity) applied at the right place.",
   "originalText": "Exactly-once effect IS idempotency (or atomicity) applied at the right place.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
