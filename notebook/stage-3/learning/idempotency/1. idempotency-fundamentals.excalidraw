   "strokeColor": "#e67700",
   "backgroundColor": "#fff3bf",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_12",
    "grp_column"
   ],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1377248966,
   "version": 1,
   "versionNonce": 1973691421,
