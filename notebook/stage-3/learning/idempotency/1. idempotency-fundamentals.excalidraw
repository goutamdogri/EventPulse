   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Two identical requests at once, and the atomic claim that fixes it",
   "originalText": "Two identical requests at once, and the atomic claim that fixes it",
