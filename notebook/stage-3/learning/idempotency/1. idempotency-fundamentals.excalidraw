   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Never \"read, then write\". The check and the claim must be one atomic step: a unique constraint, SET NX, a conditional put or a compare-and-set.",
   "originalText": "Never \"read, then write\". The check and the claim must be one atomic step: a unique constraint, SET NX, a conditional put or a compare-and-set.",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rectangle_00927",
   "autoResize": true,
   "lineHeight": 1.25
  },
