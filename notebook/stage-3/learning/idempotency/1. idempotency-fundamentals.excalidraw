   "version": 1,
   "versionNonce": 1763036739,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Idempotency is about the effect on STATE, not the return value. Say in the API contract which style you offer. EventPulse: same key + same\npayload, original complete -> return the original result (202), no new event.",
   "originalText": "Idempotency is about the effect on STATE, not the return value. Say in the API contract which style you offer. EventPulse: same key + same\npayload, original complete -> return the original result (202), no new event.",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rectangle_00268",
   "autoResize": true,
   "lineHeight": 1.25
  },
