   "frameId": null,
   "roundness": null,
   "seed": 1586472950,
   "version": 1,
   "versionNonce": 614157015,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Isolation: under PostgreSQL's default READ COMMITTED, INSERT ... ON CONFLICT is already safe, because the unique index serializes inserters of the\nsame key. SERIALIZABLE (or other stronger isolation) is needed only for read-then-write logic that cannot be reduced to a unique claim.",
   "originalText": "Isolation: under PostgreSQL's default READ COMMITTED, INSERT ... ON CONFLICT is already safe, because the unique index serializes inserters of the\nsame key. SERIALIZABLE (or other stronger isolation) is needed only for read-then-write logic that cannot be reduced to a unique claim.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rectangle_00925",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rectangle_00927",
   "type": "rectangle",
   "x": 50,
   "y": 17547.25,
   "width": 1580,
   "height": 62.25,
