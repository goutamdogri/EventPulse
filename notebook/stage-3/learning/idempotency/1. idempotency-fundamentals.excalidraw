   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Retrying still costs: use backoff and budgets.",
   "originalText": "Retrying still costs: use backoff and budgets.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
