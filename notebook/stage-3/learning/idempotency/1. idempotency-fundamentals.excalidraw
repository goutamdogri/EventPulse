   "link": null,
   "locked": false,
   "text": "Idempotent: abs, round, max(x, c), \"set to uppercase\".      Not idempotent: x + 1, x * 2, append(list, item).",
   "originalText": "Idempotent: abs, round, max(x, c), \"set to uppercase\".      Not idempotent: x + 1, x * 2, append(list, item).",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
