   "text": "Also consumers, jobs, migrations, deployment scripts and schedulers.",
   "originalText": "Also consumers, jobs, migrations, deployment scripts and schedulers.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
