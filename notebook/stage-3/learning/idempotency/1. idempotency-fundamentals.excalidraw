  {
   "id": "text_00926",
   "type": "text",
   "x": 80.96,
   "y": 17447.25,
   "width": 1518.08,
   "height": 50.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_12",
