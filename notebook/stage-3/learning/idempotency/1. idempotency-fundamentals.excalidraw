   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "A PostgreSQL unique constraint there must include the partition key, so the table alone cannot enforce\nuniqueness of event_id across partitions.",
   "originalText": "A PostgreSQL unique constraint there must include the partition key, so the table alone cannot enforce\nuniqueness of event_id across partitions.",
   "fontSize": 19,
   "fontFamily": 5,
