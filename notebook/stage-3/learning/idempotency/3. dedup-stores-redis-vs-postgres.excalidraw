   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "WAIT helps, but not fully",
   "originalText": "WAIT helps, but not fully",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00386",
   "type": "text",
   "x": 868.0,
   "y": 6038.5,
   "width": 741.6,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_04",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 480395232,
   "version": 1,
   "versionNonce": 1923100789,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "WAIT blocks until N replicas ack a write. It reduces the loss window but\ndoes not remove it: the primary can fail before WAIT returns, and replicas\nmay not have fsynced.",
   "originalText": "WAIT blocks until N replicas ack a write. It reduces the loss window but does not remove it: the primary can fail before WAIT returns, and replicas may not have fsynced.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00387",
   "type": "text",
   "x": 50,
   "y": 6155.5,
   "width": 1002.64,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#087f5b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_04",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 2021071169,
   "version": 1,
   "versionNonce": 110296753,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "What a loss means for the pipeline: the window reopens at the API layer only",
   "originalText": "What a loss means for the pipeline: the window reopens at the API layer only",
   "fontSize": 26,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
