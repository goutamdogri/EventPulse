   "seed": 1593278414,
   "version": 1,
   "versionNonce": 1651156459,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "With ON CONFLICT DO NOTHING: the insert\nis skipped (nothing returned).\nWithout it: a unique-violation error is raised.",
   "originalText": "With ON CONFLICT DO NOTHING: the insert is skipped (nothing returned).\nWithout it: a unique-violation error is raised.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
