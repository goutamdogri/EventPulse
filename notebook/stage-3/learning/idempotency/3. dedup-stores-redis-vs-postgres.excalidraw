   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "The dedup entry IS the effect row (or lives in the same transaction).\nNo gap between \"recorded\" and \"applied\".\nA crash before COMMIT leaves nothing behind.",
   "originalText": "The dedup entry IS the effect row (or lives in the same transaction).\nNo gap between \"recorded\" and \"applied\".\nA crash before COMMIT leaves nothing behind.",
   "fontSize": 20,
   "fontFamily": 5,
