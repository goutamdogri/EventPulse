   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "About 50-100 bytes of overhead per key, plus\nkey and value size. Measure with MEMORY\nUSAGE on realistic entries.",
   "originalText": "About 50-100 bytes of overhead per key, plus key and value size. Measure with MEMORY USAGE on realistic entries.",
