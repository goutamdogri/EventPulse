   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Reject most duplicate requests early; replay recent responses; protect Kafka and\nPostgres from retry storms; detect a payload mismatch with a clear 422",
   "originalText": "Reject most duplicate requests early; replay recent responses; protect Kafka and Postgres from retry storms; detect a payload mismatch with a clear 422",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rect_01241",
   "autoResize": true,
   "lineHeight": 1.25
  },
