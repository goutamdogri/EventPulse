  },
  {
   "id": "text_00032",
   "type": "text",
   "x": 600.67,
   "y": 1207.5,
   "width": 145.12,
   "height": 28.75,
   "angle": 0,
   "strokeColor": "#5f3dc4",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_01",
    "grp_column"
   ],
   "frameId": null,
