   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Postgres constraint (or an equivalent durable conditional write) is\nMANDATORY.\nAdd Redis in front if request volume or retry storms are significant.",
   "originalText": "Postgres constraint (or an equivalent durable conditional write) is MANDATORY.\nAdd Redis in front if request volume or retry storms are significant.",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rect_01554",
   "autoResize": true,
   "lineHeight": 1.25
  },
