   "versionNonce": 208588767,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "P11  Index bloat and growth",
   "originalText": "P11  Index bloat and growth",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00885",
   "type": "text",
   "x": 66.0,
   "y": 15511.0,
   "width": 477.85,
   "height": 95.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_10",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1710980238,
   "version": 1,
   "versionNonce": 32959436,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Large indexes on random UUIDs cause page splits,\ncache misses and slower inserts. The table never\nshrinks without maintenance.\nTime-ordered ids (UUIDv7) improve locality.",
   "originalText": "Large indexes on random UUIDs cause page splits, cache misses and slower inserts. The table never shrinks without maintenance.\nTime-ordered ids (UUIDv7) improve locality.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rect_00886",
   "type": "rectangle",
   "x": 584.67,
   "y": 15464.75,
   "width": 510.67,
   "height": 153.25,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "#fff3bf",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_10",
    "grp_column"
   ],
   "frameId": null,
   "roundness": {
    "type": 3
   },
