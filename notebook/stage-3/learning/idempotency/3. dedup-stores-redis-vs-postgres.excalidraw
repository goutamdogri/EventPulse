  {
   "id": "text_00740",
   "type": "text",
   "x": 66,
   "y": 13927.25,
   "width": 456.96,
   "height": 166.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
