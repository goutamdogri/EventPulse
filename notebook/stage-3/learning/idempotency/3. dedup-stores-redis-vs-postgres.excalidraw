   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "3. An UNCOMMITTED entry (another\ntransaction in flight)",
   "originalText": "3. An UNCOMMITTED entry (another transaction in flight)",
   "fontSize": 22,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
