   "seed": 1458686906,
   "version": 1,
   "versionNonce": 243021034,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "UNIQUE (event_id) while you look up by\n(tenant_id, event_id), or a nullable column inside\nthe unique index.\nNULLs are DISTINCT by default, so NULL keys\nnever conflict.\nPostgreSQL 15+ offers NULLS NOT DISTINCT.\nBest: make dedup columns NOT NULL.",
   "originalText": "UNIQUE (event_id) while you look up by (tenant_id, event_id), or a nullable column inside the unique index.\nNULLs are DISTINCT by default, so NULL keys never conflict.\nPostgreSQL 15+ offers NULLS NOT DISTINCT.\nBest: make dedup columns NOT NULL.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
