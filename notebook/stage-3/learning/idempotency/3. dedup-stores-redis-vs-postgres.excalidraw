   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "A unique B-tree index is the serialization point for concurrent duplicates, with no explicit locking by you",
   "originalText": "A unique B-tree index is the serialization point for concurrent duplicates, with no explicit locking by you",
   "fontSize": 22,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
