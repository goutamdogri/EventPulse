   "roundness": null,
   "seed": 1511428077,
   "version": 1,
   "versionNonce": 1536996347,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "The failure mode here is not forgetting: it is slowing down, bloating and lock trouble. Batching is the main lever",
   "originalText": "The failure mode here is not forgetting: it is slowing down, bloating and lock trouble. Batching is the main lever",
   "fontSize": 22,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
