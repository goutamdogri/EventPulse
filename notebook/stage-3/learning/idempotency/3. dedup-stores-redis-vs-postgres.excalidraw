   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "That is a large Redis. Your options:",
   "originalText": "That is a large Redis. Your options:",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
