   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Redis expires keys lazily on access plus an active sampling cycle. Expired\nkeys can linger briefly in memory: memory is NOT freed at the exact TTL.",
   "originalText": "Redis expires keys lazily on access plus an active sampling cycle. Expired keys can linger briefly in memory: memory is NOT freed at the exact TTL.",
