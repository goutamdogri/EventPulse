  },
  {
   "id": "text_00779",
   "type": "text",
   "x": 132,
   "y": 14444.0,
   "width": 1224.17,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
