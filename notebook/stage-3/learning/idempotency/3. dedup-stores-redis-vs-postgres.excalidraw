  {
   "id": "text_01449",
   "type": "text",
   "x": 1135.33,
   "y": 22215.5,
   "width": 468.88,
   "height": 118.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
