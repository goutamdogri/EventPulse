  },
  {
   "id": "text_01443",
   "type": "text",
   "x": 66.0,
   "y": 22215.5,
   "width": 472.7,
   "height": 166.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_14",
