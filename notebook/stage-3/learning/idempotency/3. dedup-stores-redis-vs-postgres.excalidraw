   "versionNonce": 1372014166,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "P12  Write amplification",
   "originalText": "P12  Write amplification",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00888",
   "type": "text",
   "x": 600.67,
   "y": 15511.0,
   "width": 471.13,
   "height": 71.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_10",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 763994457,
   "version": 1,
   "versionNonce": 588489777,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Every claim writes WAL and the index. At extreme\nrates, primary write throughput CAPS dedup\nthroughput.",
   "originalText": "Every claim writes WAL and the index. At extreme rates, primary write throughput CAPS dedup throughput.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
