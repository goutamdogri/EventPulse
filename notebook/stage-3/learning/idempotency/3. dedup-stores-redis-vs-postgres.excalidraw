   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "A promoted standby can lack the\nlatest commits (replication lag), so\nthey are forgotten. Same shape as\nR6, typically narrower.\nEliminated by synchronous\nreplication.",
   "originalText": "A promoted standby can lack the latest commits (replication lag), so they are forgotten. Same shape as R6, typically narrower.\nEliminated by synchronous replication.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
