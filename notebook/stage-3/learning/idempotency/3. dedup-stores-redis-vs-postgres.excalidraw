   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Postgres does NOT give you",
   "originalText": "Postgres does NOT give you",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00683",
   "type": "text",
   "x": 868.0,
   "y": 12373.0,
   "width": 711.18,
   "height": 125.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_08",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 542279147,
   "version": 1,
   "versionNonce": 1727741699,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "- Sub-millisecond speed for a per-request claim at very high rates: fast,\nbut every claim costs WAL and index work\n- Automatic cleanup: you prune\n- Protection against a DROPPED constraint, or a bulk load that\nbypasses it",
   "originalText": "- Sub-millisecond speed for a per-request claim at very high rates: fast, but every claim costs WAL and index work\n- Automatic cleanup: you prune\n- Protection against a DROPPED constraint, or a bulk load that bypasses it",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
