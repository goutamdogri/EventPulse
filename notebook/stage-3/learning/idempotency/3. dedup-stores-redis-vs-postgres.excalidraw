   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "The replication lag at failure\ntime: often ms to seconds,\nlarger under load or network\ntrouble.\n\nMitigate with WAIT (reduces,\ndoes not eliminate) or simply\naccept it and keep the sink\nconstraint.",
   "originalText": "The replication lag at failure time: often ms to seconds, larger under load or network trouble.\n\nMitigate with WAIT (reduces, does not eliminate) or simply accept it and keep the sink constraint.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
