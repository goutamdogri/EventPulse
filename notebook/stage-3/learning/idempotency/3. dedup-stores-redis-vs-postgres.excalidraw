   "versionNonce": 9829962,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "How each one fails",
   "originalText": "How each one fails",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00036",
   "type": "text",
   "x": 1135.33,
   "y": 1244.25,
   "width": 466.13,
   "height": 95.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_01",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 893107561,
   "version": 1,
   "versionNonce": 383042674,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Redis FORGETS (a duplicate is treated as new).\nPostgres SLOWS DOWN: the constraint can\nbecome the bottleneck. A rolled-back transaction\nreleases the claim, which is correct.",
   "originalText": "Redis FORGETS (a duplicate is treated as new).\nPostgres SLOWS DOWN: the constraint can become the bottleneck. A rolled-back transaction releases the claim, which is correct.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rect_00037",
   "type": "rectangle",
   "x": 50,
   "y": 1405.0,
   "width": 1580,
   "height": 139.0,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "#fff3bf",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_01",
    "grp_column"
   ],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 714306589,
   "version": 1,
   "versionNonce": 605199522,
   "isDeleted": false,
   "boundElements": [
