   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Keep dedup keys on an instance (or DB) apart\nfrom caches, so a cache eviction storm cannot\nevict dedup keys.",
   "originalText": "Keep dedup keys on an instance (or DB) apart from caches, so a cache eviction storm cannot evict dedup keys.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
