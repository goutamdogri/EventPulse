   "link": null,
   "locked": false,
   "text": "Why XX KEEPTTL?",
   "originalText": "Why XX KEEPTTL?",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00245",
   "type": "text",
   "x": 116,
   "y": 4344.25,
   "width": 604.85,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_03",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 983947469,
   "version": 1,
   "versionNonce": 571578312,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "XX = only if the key still exists, so the update cannot resurrect an\nexpired key.\nKEEPTTL = do not change its expiry.\nCompare-and-set on the previous VALUE needs a Lua script or\nWATCH/MULTI: plain commands are not conditional on value.",
   "originalText": "XX = only if the key still exists, so the update cannot resurrect an expired key.\nKEEPTTL = do not change its expiry.\nCompare-and-set on the previous VALUE needs a Lua script or WATCH/MULTI: plain commands are not conditional on value.",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
