   "versionNonce": 190742307,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "P13  Dead tuples on the conflict path",
   "originalText": "P13  Dead tuples on the conflict path",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00891",
   "type": "text",
   "x": 1135.33,
   "y": 15511.0,
   "width": 466.46,
   "height": 95.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_10",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1912205284,
   "version": 1,
   "versionNonce": 1174512624,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "A conflicting DO NOTHING insert can still\nconsume a speculative heap tuple that dies and\nneeds vacuum. High duplicate rate -> more vacuum\nwork.",
   "originalText": "A conflicting DO NOTHING insert can still consume a speculative heap tuple that dies and needs vacuum. High duplicate rate -> more vacuum work.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
