   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "INCORRECTNESS: duplicates are stored",
   "originalText": "INCORRECTNESS: duplicates are stored",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rect_01249",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_01251",
   "type": "text",
   "x": 50,
   "y": 19813.25,
   "width": 346.88,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
