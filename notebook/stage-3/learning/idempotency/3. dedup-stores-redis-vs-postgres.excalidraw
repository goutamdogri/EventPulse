   "roundness": null,
   "seed": 1575521365,
   "version": 1,
   "versionNonce": 1739789522,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "False negatives: NONE\nFalse positives: yes, tunable (e.g. 1% at ~9.6 bits\nper element)\nDeletion: not supported in the basic form\nMemory: tiny compared with storing keys\nVariants: counting Bloom (deletable), cuckoo\nfilters; Redis offers them via RedisBloom",
   "originalText": "False negatives: NONE\nFalse positives: yes, tunable (e.g. 1% at ~9.6 bits per element)\nDeletion: not supported in the basic form\nMemory: tiny compared with storing keys\nVariants: counting Bloom (deletable), cuckoo filters; Redis offers them via RedisBloom",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
