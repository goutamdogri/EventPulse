   "locked": false
  },
  {
   "id": "text_00887",
   "type": "text",
   "x": 600.67,
   "y": 15476.75,
   "width": 247.32,
   "height": 26.25,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "transparent",
