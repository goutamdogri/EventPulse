   "link": null,
   "locked": false,
   "text": "Redis: ~0.1-1 ms, best-effort, TTL-bounded, RAM. Postgres: ~1-10 ms single, durable, kept\nwhile the row lives, disk.",
   "originalText": "Redis: ~0.1-1 ms, best-effort, TTL-bounded, RAM. Postgres: ~1-10 ms single, durable, kept while the row lives, disk.",
