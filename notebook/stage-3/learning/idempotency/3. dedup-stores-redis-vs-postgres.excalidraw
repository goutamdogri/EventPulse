   "version": 1,
   "versionNonce": 1242696754,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "1. Shorten the TTL\n2. Store only a hash (e.g. 16 bytes) instead of the response\n3. Dedup only keys that carry side effects\n4. Accept Postgres as the only layer for high-volume, low-risk streams",
   "originalText": "1. Shorten the TTL\n2. Store only a hash (e.g. 16 bytes) instead of the response\n3. Dedup only keys that carry side effects\n4. Accept Postgres as the only layer for high-volume, low-risk streams",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
