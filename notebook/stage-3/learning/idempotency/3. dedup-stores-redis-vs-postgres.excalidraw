  },
  {
   "id": "text_00583",
   "type": "text",
   "x": 600.67,
   "y": 10228.0,
   "width": 469.91,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_07",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1244062328,
   "version": 1,
   "versionNonce": 875185138,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Short key names, short values. Do not store\nfull responses if you can avoid it. Use hashes\nsparingly (small hashes use compact encodings).",
   "originalText": "Short key names, short values. Do not store full responses if you can avoid it. Use hashes sparingly (small hashes use compact encodings).",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
