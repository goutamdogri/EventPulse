   "versionNonce": 379239674,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Postgres gives you",
   "originalText": "Postgres gives you",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00680",
   "type": "text",
   "x": 66.0,
   "y": 12373.0,
   "width": 733.83,
   "height": 225.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_08",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 651355124,
   "version": 1,
   "versionNonce": 1549316842,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "- Durability: the entry is in WAL, fsynced at commit\n(synchronous_commit=on by default); replicated if you use synchronous\nreplication\n- Atomic with the effect: the entry IS the effect row, or shares its\ntransaction. No gap\n- No expiry, no eviction: the claim lasts as long as the row\n- Rollback safety: an aborted transaction takes its claim with it\n- Multi-row atomic claims: one batch statement, one transaction (how the\nEventPulse sink batches)",
   "originalText": "- Durability: the entry is in WAL, fsynced at commit (synchronous_commit=on by default); replicated if you use synchronous replication\n- Atomic with the effect: the entry IS the effect row, or shares its transaction. No gap\n- No expiry, no eviction: the claim lasts as long as the row\n- Rollback safety: an aborted transaction takes its claim with it\n- Multi-row atomic claims: one batch statement, one transaction (how the EventPulse sink batches)",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
