  },
  {
   "id": "text_00629",
   "type": "text",
   "x": 1143.33,
   "y": 11552.75,
   "width": 451.55,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_08",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1040695670,
   "version": 1,
   "versionNonce": 261368771,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "The inserter WAITS for that transaction to\nfinish.\nIf it commits -> this insert conflicts.\nIf it rolls back -> this insert proceeds.",
   "originalText": "The inserter WAITS for that transaction to finish.\nIf it commits -> this insert conflicts.\nIf it rolls back -> this insert proceeds.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00630",
   "type": "text",
   "x": 50,
   "y": 11698.75,
   "width": 958.41,
   "height": 22.5,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_08",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 729403844,
   "version": 1,
   "versionNonce": 187331637,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "(A plain insert writes the heap tuple and then probes the index; ON CONFLICT checks first, then inserts.)",
   "originalText": "(A plain insert writes the heap tuple and then probes the index; ON CONFLICT checks first, then inserts.)",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
