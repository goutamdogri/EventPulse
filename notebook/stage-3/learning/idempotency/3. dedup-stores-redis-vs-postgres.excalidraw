  {
   "id": "text_00890",
   "type": "text",
   "x": 1135.33,
   "y": 15476.75,
   "width": 399.33,
   "height": 26.25,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
