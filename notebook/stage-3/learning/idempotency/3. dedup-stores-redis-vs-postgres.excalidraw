  {
   "id": "text_00881",
   "type": "text",
   "x": 1335.47,
   "y": 15247.75,
   "width": 239.05,
   "height": 50.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_10",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1200833499,
   "version": 1,
   "versionNonce": 1878503253,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Y waits on a, X finishes,\nthen Y continues",
   "originalText": "Y waits on a, X finishes, then Y continues",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rect_00880",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00882",
   "type": "text",
   "x": 880,
   "y": 15354.75,
   "width": 544.82,
   "height": 50.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_10",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 2076887658,
   "version": 1,
   "versionNonce": 214945214,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "A single lock order means a wait, never a cycle.\nThis lowers deadlock risk between concurrent batches.",
   "originalText": "A single lock order means a wait, never a cycle.\nThis lowers deadlock risk between concurrent batches.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rect_00883",
   "type": "rectangle",
   "x": 50.0,
   "y": 15464.75,
   "width": 510.67,
   "height": 153.25,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "#fff3bf",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_10",
    "grp_column"
   ],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 61490698,
   "version": 1,
   "versionNonce": 437794850,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false
  },
  {
   "id": "text_00884",
   "type": "text",
   "x": 66.0,
   "y": 15476.75,
   "width": 298.85,
   "height": 26.25,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
