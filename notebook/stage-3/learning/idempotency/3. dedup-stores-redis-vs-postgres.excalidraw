   "link": null,
   "locked": false
  },
  {
   "id": "text_00038",
   "type": "text",
   "x": 98.15,
   "y": 1417.0,
   "width": 1483.7,
   "height": 115.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_01",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1973131079,
   "version": 1,
   "versionNonce": 776307289,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "The rule that falls out: the faster, forgetful layer may only REDUCE COST; the slower, durable layer must PROVIDE\nCORRECTNESS.\nOne line: Redis remembers fast but not forever. Postgres remembers forever but not as fast. Correctness rests on the one that\ndoes not forget.",
   "originalText": "The rule that falls out: the faster, forgetful layer may only REDUCE COST; the slower, durable layer must PROVIDE CORRECTNESS.\nOne line: Redis remembers fast but not forever. Postgres remembers forever but not as fast. Correctness rests on the one that does not forget.",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rect_00037",
   "autoResize": true,
   "lineHeight": 1.25
  },
