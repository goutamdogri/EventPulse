   "seed": 1578233508,
   "version": 1,
   "versionNonce": 1475056125,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Never drop events on the filter alone: a false\npositive silently DISCARDS a genuinely new event\n(data loss).\nDropping must be exact; probabilistic structures\nonly speed up the \"new\" path.",
   "originalText": "Never drop events on the filter alone: a false positive silently DISCARDS a genuinely new event (data loss).\nDropping must be exact; probabilistic structures only speed up the \"new\" path.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
