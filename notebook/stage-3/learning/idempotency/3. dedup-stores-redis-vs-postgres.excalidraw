   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Hot keys / hot shard",
   "originalText": "Hot keys / hot shard",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00586",
   "type": "text",
   "x": 1135.33,
   "y": 10228.0,
   "width": 455.39,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_07",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1668225638,
   "version": 1,
   "versionNonce": 2088916775,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "One key hammered by duplicates is fine\n(single-threaded atomic ops). A hot SHARD in\ncluster mode may bottleneck.",
   "originalText": "One key hammered by duplicates is fine (single-threaded atomic ops). A hot SHARD in cluster mode may bottleneck.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
