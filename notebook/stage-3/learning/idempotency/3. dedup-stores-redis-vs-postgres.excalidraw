   "versionNonce": 1579598874,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "1. Atomic claim",
   "originalText": "1. Atomic claim",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00030",
   "type": "text",
   "x": 66.0,
   "y": 1244.25,
   "width": 469.27,
   "height": 95.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_01",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 942484497,
   "version": 1,
   "versionNonce": 987721451,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "No race between \"check\" and \"write\". Two\nsimultaneous duplicates cannot both win.\nBoth stores give this: Redis via NX, Postgres via\nthe unique index.",
   "originalText": "No race between \"check\" and \"write\". Two simultaneous duplicates cannot both win.\nBoth stores give this: Redis via NX, Postgres via the unique index.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rect_00031",
   "type": "rectangle",
   "x": 584.67,
   "y": 1195.5,
   "width": 510.67,
   "height": 179.5,
   "angle": 0,
   "strokeColor": "#5f3dc4",
   "backgroundColor": "#e5dbff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_01",
    "grp_column"
   ],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 344886240,
