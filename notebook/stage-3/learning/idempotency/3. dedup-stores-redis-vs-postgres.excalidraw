   "versionNonce": 1529514084,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Redis is availability- and latency-optimized. Replication is asynchronous\nand default durability is best-effort.",
   "originalText": "Redis is availability- and latency-optimized. Replication is asynchronous and default durability is best-effort.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
