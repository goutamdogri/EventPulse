   "versionNonce": 1592295015,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "2. Retention",
   "originalText": "2. Retention",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00033",
   "type": "text",
   "x": 600.67,
   "y": 1244.25,
   "width": 451.01,
   "height": 118.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_01",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1364505762,
   "version": 1,
   "versionNonce": 2054813661,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "How long and how reliably it remembers.\nRedis: bounded in time (TTL), bounded in space\n(RAM, eviction) and loseable (restart, failover,\nflush).\nPostgres: as long as the row exists.",
   "originalText": "How long and how reliably it remembers.\nRedis: bounded in time (TTL), bounded in space (RAM, eviction) and loseable (restart, failover, flush).\nPostgres: as long as the row exists.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rect_00034",
   "type": "rectangle",
   "x": 1119.33,
   "y": 1195.5,
   "width": 510.67,
   "height": 179.5,
   "angle": 0,
   "strokeColor": "#5f3dc4",
   "backgroundColor": "#e5dbff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_01",
    "grp_column"
   ],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1591318695,
   "version": 1,
   "versionNonce": 1205691025,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false
  },
  {
   "id": "text_00035",
   "type": "text",
   "x": 1135.33,
   "y": 1207.5,
   "width": 211.09,
   "height": 28.75,
   "angle": 0,
   "strokeColor": "#5f3dc4",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_01",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 638893634,
