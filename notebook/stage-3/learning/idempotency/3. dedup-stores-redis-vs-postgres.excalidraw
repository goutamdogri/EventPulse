   "link": null,
   "locked": false
  },
  {
   "id": "text_00029",
   "type": "text",
   "x": 66.0,
   "y": 1207.5,
   "width": 163.12,
   "height": 28.75,
   "angle": 0,
   "strokeColor": "#5f3dc4",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
