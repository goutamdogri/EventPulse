   "text": "CREATE TABLE events (\n  event_id   uuid  PRIMARY KEY,   -- unique B-tree index\n  tenant_id  text  NOT NULL,\n  ...\n);",
   "originalText": "CREATE TABLE events (\n  event_id   uuid  PRIMARY KEY,   -- unique B-tree index\n  tenant_id  text  NOT NULL,\n  ...\n);",
