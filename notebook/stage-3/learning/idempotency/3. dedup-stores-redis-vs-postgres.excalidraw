   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Claimed but no effect: retries must wait or take over.\nEffect but no claim: a retry repeats the effect.\nThere is ALWAYS a gap between \"recorded\" and \"done\".",
   "originalText": "Claimed but no effect: retries must wait or take over.\nEffect but no claim: a retry repeats the effect.\nThere is ALWAYS a gap between \"recorded\" and \"done\".",
