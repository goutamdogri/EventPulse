   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "P9  Partitioned table",
   "originalText": "P9  Partitioned table",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text_00774",
   "type": "text",
   "x": 1196,
   "y": 13927.25,
   "width": 389.19,
   "height": 190.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp_diagram_09",
    "grp_column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 440845462,
   "version": 1,
   "versionNonce": 712121997,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "If the unique key does not include the\npartition key, Postgres will not allow the\nconstraint, or uniqueness is only PER\nPARTITION.\n\nSo include the partition key in the unique\nkey, or keep the dedup constraint in a\nnon-partitioned key table.",
   "originalText": "If the unique key does not include the partition key, Postgres will not allow the constraint, or uniqueness is only PER PARTITION.\n\nSo include the partition key in the unique key, or keep the dedup constraint in a non-partitioned key table.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
