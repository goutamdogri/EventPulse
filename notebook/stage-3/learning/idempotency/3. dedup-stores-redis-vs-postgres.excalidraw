  },
  {
   "id": "text_00626",
   "type": "text",
   "x": 604.67,
   "y": 11525.25,
   "width": 454.53,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
