   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "The only legal schema edit is ADDING vN+1.avsc.  Practical detail: scope the rule to events/*.avsc, because subjects.json (and the lock file) must\nchange when you add that version.",
   "fontSize": 30,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec-00419",
   "originalText": "The only legal schema edit is ADDING vN+1.avsc.  Practical detail: scope the rule to events/*.avsc, because subjects.json (and the lock file) must change when you add that version.",
   "autoResize": true,
   "lineHeight": 1.25
  },
