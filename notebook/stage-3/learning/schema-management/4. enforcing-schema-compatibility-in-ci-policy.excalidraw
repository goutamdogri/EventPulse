   "text": "Why int -> long flips: a long reader can read int data (backward OK), but an int reader cannot read long data (forward fails).",
   "fontSize": 29,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Why int -> long flips: a long reader can read int data (backward OK), but an int reader cannot read long data (forward fails).",
   "autoResize": true,
   "lineHeight": 1.25
  },
