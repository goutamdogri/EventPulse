   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Confirm registry identity and _schemas health; restore from\nbackup; stop a producer using a foreign id. Messages are NOT lost:\nkeep them parked (transient handling), do not drop.",
   "fontSize": 28,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec-01904",
   "originalText": "Confirm registry identity and _schemas health; restore from backup; stop a producer using a foreign id. Messages are NOT lost: keep them parked (transient handling), do not drop.",
