   "text": "POST /compatibility/subjects/\n     events.raw-value/versions/latest\n     ?verbose=true\n\nbody: { \"schema\": \"<raw .avsc text>\",\n        \"schemaType\": \"AVRO\" }\n\nreply: { \"is_compatible\": false,\n         \"messages\": [ ... ] }\n\n ",
   "fontSize": 28,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "POST /compatibility/subjects/\n     events.raw-value/versions/latest\n     ?verbose=true\n\nbody: { \"schema\": \"<raw .avsc text>\",\n        \"schemaType\": \"AVRO\" }\n\nreply: { \"is_compatible\": false,\n         \"messages\": [ ... ] }\n\n ",
