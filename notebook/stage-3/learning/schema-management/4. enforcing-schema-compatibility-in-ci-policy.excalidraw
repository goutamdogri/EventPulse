   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "The same (tenant_id, event_id) arriving via two topics yields ONE row. That is what makes dual publishing and overlapping consumption safe.",
   "fontSize": 30,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec-01861",
   "originalText": "The same (tenant_id, event_id) arriving via two topics yields ONE row. That is what makes dual publishing and overlapping consumption safe.",
   "autoResize": true,
   "lineHeight": 1.25
  },
