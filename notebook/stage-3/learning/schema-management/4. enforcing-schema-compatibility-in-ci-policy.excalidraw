   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "FULL_TRANSITIVE on the subject is the final\nautomated guard. No NONE in any shared\nenvironment. Any PUT /config outside the pipeline\nraises an alert.",
   "fontSize": 28,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "FULL_TRANSITIVE on the subject is the final\nautomated guard. No NONE in any shared\nenvironment. Any PUT /config outside the pipeline\nraises an alert.",
   "autoResize": true,
   "lineHeight": 1.25
  },
