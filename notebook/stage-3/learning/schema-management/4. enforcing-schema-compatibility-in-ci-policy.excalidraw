   "text": "One line: write the schema in git, check it by machine in CI against the real registry rules, register it only from the pipeline, and make\nevery way around that path loud.",
   "fontSize": 34,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec-00127",
   "originalText": "One line: write the schema in git, check it by machine in CI against the real registry rules, register it only from the pipeline, and make every way around that path loud.",
   "autoResize": true,
   "lineHeight": 1.25
  },
