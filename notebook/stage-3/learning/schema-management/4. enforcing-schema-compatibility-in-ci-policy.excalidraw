   "strokeColor": "#a61e4d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp-d06",
    "grp-column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 890050788,
   "version": 1,
   "versionNonce": 109116526,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Combine the two verdicts",
   "fontSize": 40,
