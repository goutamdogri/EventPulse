   "link": null,
   "locked": false,
   "text": "name: schema-check\non:\n  pull_request:\n    paths: [\"schemas/**\",\n            \"tools/schema-check/**\",\n            \"packages/kafka-config/**\"]\njobs:\n  schema-check:\n    runs-on: ubuntu-latest\n    services:      # ephemeral Kafka + registry\n      # kafka: ...      # schema-registry: ...\n    steps:\n      - uses: actions/checkout@v4\n        with: { fetch-depth: 0 }  # diff vs main\n      - run: pnpm install --frozen-lockfile\n      - run: pnpm --filter schema-check run all\n        env:\n          SCHEMA_REGISTRY_URL: http://localhost:8081",
   "fontSize": 28,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "name: schema-check\non:\n  pull_request:\n    paths: [\"schemas/**\",\n            \"tools/schema-check/**\",\n            \"packages/kafka-config/**\"]\njobs:\n  schema-check:\n    runs-on: ubuntu-latest\n    services:      # ephemeral Kafka + registry\n      # kafka: ...      # schema-registry: ...\n    steps:\n      - uses: actions/checkout@v4\n        with: { fetch-depth: 0 }  # diff vs main\n      - run: pnpm install --frozen-lockfile\n      - run: pnpm --filter schema-check run all\n        env:\n          SCHEMA_REGISTRY_URL: http://localhost:8081",
   "autoResize": true,
   "lineHeight": 1.25
  },
