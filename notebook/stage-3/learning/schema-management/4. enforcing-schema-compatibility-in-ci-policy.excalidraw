   ],
   "frameId": null,
   "roundness": null,
   "seed": 460034649,
   "version": 1,
   "versionNonce": 562457856,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "What only real bytes reveal: silent data loss from a rename",
   "fontSize": 40,
