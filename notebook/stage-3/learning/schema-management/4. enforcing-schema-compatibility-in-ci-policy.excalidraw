   "text": "const res = await fetch(\n  `${REGISTRY}/compatibility/subjects/${subject}/versions/latest?verbose=true`,\n  { method: \"POST\",\n    headers: { \"Content-Type\": \"application/vnd.schemaregistry.v1+json\" },\n    body: JSON.stringify({ schema: candidateText, schemaType: \"AVRO\" }) });\nif (res.status === 404) return;                      // subject not found: first version\nif (!res.ok) throw new Error(`registry error ${res.status}`);          // fail closed\nconst body = await res.json();\nif (!body.is_compatible)\n  throw new Error(`INCOMPATIBLE with ${subject}: ${(body.messages ?? []).join(\"; \")}`);",
   "fontSize": 28,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "const res = await fetch(\n  `${REGISTRY}/compatibility/subjects/${subject}/versions/latest?verbose=true`,\n  { method: \"POST\",\n    headers: { \"Content-Type\": \"application/vnd.schemaregistry.v1+json\" },\n    body: JSON.stringify({ schema: candidateText, schemaType: \"AVRO\" }) });\nif (res.status === 404) return;                      // subject not found: first version\nif (!res.ok) throw new Error(`registry error ${res.status}`);          // fail closed\nconst body = await res.json();\nif (!body.is_compatible)\n  throw new Error(`INCOMPATIBLE with ${subject}: ${(body.messages ?? []).join(\"; \")}`);",
   "autoResize": true,
   "lineHeight": 1.25
  },
