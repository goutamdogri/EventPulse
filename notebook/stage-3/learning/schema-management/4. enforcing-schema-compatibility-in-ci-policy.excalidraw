   "versionNonce": 111421124,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "The registry rejects only at registration (deploy time). CI gives review-time feedback and\nchecks policy the registry cannot express.",
   "fontSize": 29,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The registry rejects only at registration (deploy time). CI gives review-time feedback and\nchecks policy the registry cannot express.",
   "autoResize": true,
   "lineHeight": 1.25
  },
