   "versionNonce": 1776305358,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Least privilege: each identity gets only the\noperations it needs (table below). Application, PR\njob and humans never register.",
   "fontSize": 28,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Least privilege: each identity gets only the\noperations it needs (table below). Application, PR\njob and humans never register.",
