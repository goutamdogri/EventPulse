   "text": "BACKWARD (non-transitive) compares v3 with v2 only\n-> ACCEPTS. A replay from earliest later crashes on a v1 record.",
   "fontSize": 30,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec-00693",
   "originalText": "BACKWARD (non-transitive) compares v3 with v2 only\n-> ACCEPTS. A replay from earliest later crashes on a v1 record.",
   "autoResize": true,
   "lineHeight": 1.25
  },
