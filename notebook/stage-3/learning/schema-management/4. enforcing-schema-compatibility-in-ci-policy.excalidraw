   "version": 1,
   "versionNonce": 684814612,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Edit the file; CI compares the PR version with registered ones and with\nmain.\n+ No file pile-up, simple diffs\n- Offline transitive checks need the registry or git history\n- Harder to test old versions\n- Easy to edit history by accident",
   "fontSize": 28,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Edit the file; CI compares the PR version with registered ones and with\nmain.\n+ No file pile-up, simple diffs\n- Offline transitive checks need the registry or git history\n- Harder to test old versions\n- Easy to edit history by accident",
   "autoResize": true,
   "lineHeight": 1.25
  },
