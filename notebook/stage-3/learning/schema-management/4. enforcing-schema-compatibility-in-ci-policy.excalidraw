   "seed": 787721796,
   "version": 1,
   "versionNonce": 1626435857,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "function check(n, earlier, mode, transitive): string[] {\n  const targets = transitive ? earlier : earlier.slice(-1);\n  const errors = [];\n  targets.forEach((p, i) => {\n    if ((mode === \"BACKWARD\" || mode === \"FULL\") && !canRead(n, p))\n      errors.push(\"NOT BACKWARD vs version ...\");\n    if ((mode === \"FORWARD\" || mode === \"FULL\") && !canRead(p, n))\n      errors.push(\"NOT FORWARD vs version ...\");\n  });\n  return errors;   // empty list = compatible\n}",
   "fontSize": 28,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "function check(n, earlier, mode, transitive): string[] {\n  const targets = transitive ? earlier : earlier.slice(-1);\n  const errors = [];\n  targets.forEach((p, i) => {\n    if ((mode === \"BACKWARD\" || mode === \"FULL\") && !canRead(n, p))\n      errors.push(\"NOT BACKWARD vs version ...\");\n    if ((mode === \"FORWARD\" || mode === \"FULL\") && !canRead(p, n))\n      errors.push(\"NOT FORWARD vs version ...\");\n  });\n  return errors;   // empty list = compatible\n}",
   "autoResize": true,
   "lineHeight": 1.25
  },
