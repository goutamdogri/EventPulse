   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Lock 1 · Producers cannot self-register",
   "fontSize": 32,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Lock 1 · Producers cannot self-register",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "tex-01503",
   "type": "text",
   "x": 92.0,
   "y": 36835.75,
   "width": 649.85,
   "height": 245.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp-d16",
    "grp-column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 974694678,
   "version": 1,
   "versionNonce": 43357793,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "auto.register.schemas=false (and\nuse.latest.version=false with explicit lookup) in\nstaging and prod.\nNode: getLatestSchemaId / getRegistryId, not\nregister. Fail READINESS if lookup fails.\nAdd a test or lint on the prod config so it\ncannot regress.",
   "fontSize": 28,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "auto.register.schemas=false (and\nuse.latest.version=false with explicit lookup) in\nstaging and prod.\nNode: getLatestSchemaId / getRegistryId, not\nregister. Fail READINESS if lookup fails.\nAdd a test or lint on the prod config so it\ncannot regress.",
   "autoResize": true,
   "lineHeight": 1.25
  },
