   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "\"v2 reads v1\" and \"v3 reads v2\" do NOT imply \"v3 reads v1\". Replayable topics therefore need transitive levels (policy P2).",
   "fontSize": 30,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec-00697",
   "originalText": "\"v2 reads v1\" and \"v3 reads v2\" do NOT imply \"v3 reads v1\". Replayable topics therefore need transitive levels (policy P2).",
   "autoResize": true,
   "lineHeight": 1.25
  },
