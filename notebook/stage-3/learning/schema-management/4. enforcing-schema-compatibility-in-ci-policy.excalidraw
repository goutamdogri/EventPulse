   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "schema-check: FAIL   subject events.raw-value (FULL_TRANSITIVE)\n  schemas/events/v4.avsc\n  - NOT BACKWARD vs v1..v3: field \"event_type\" (no default) is required by the new schema,\n                            but data written with v1..v3 does not contain it.\n  - NOT FORWARD  vs v3:     field \"type\" (no default) was removed, but readers of v3 require it.\n  - registry:               incompatible with an earlier schema (a register call would get 409)\n  hint: this is a rename (note 3, section 12). Use expand / contract (note 3, section 16.1).",
   "fontSize": 29,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "schema-check: FAIL   subject events.raw-value (FULL_TRANSITIVE)\n  schemas/events/v4.avsc\n  - NOT BACKWARD vs v1..v3: field \"event_type\" (no default) is required by the new schema,\n                            but data written with v1..v3 does not contain it.\n  - NOT FORWARD  vs v3:     field \"type\" (no default) was removed, but readers of v3 require it.\n  - registry:               incompatible with an earlier schema (a register call would get 409)\n  hint: this is a rename (note 3, section 12). Use expand / contract (note 3, section 16.1).",
   "autoResize": true,
   "lineHeight": 1.25
  },
