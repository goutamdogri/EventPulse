  },
  {
   "id": "tex-00386",
   "type": "text",
   "x": 1252.0,
   "y": 8649.0,
   "width": 797.75,
   "height": 175.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp-d04",
    "grp-column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 239754595,
   "version": 1,
   "versionNonce": 1160799742,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "A change is a NEW file; old files never change.\n+ Offline transitive check across all files\n+ Fixtures per version, auditable, matches the PRD layout\n- More files\n- \"Current\" version = the highest number",
   "fontSize": 28,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A change is a NEW file; old files never change.\n+ Offline transitive check across all files\n+ Fixtures per version, auditable, matches the PRD layout\n- More files\n- \"Current\" version = the highest number",
   "autoResize": true,
   "lineHeight": 1.25
  },
