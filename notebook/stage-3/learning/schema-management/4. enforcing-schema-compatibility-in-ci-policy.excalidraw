   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "import { Type } from \"avsc\";\n\n// can reader decode data written by writer?\nfunction canRead(reader: Type, writer: Type) {\n  try {\n    reader.createResolver(writer);\n    return true;\n  } catch {\n    return false;\n  }\n}",
   "fontSize": 28,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "import { Type } from \"avsc\";\n\n// can reader decode data written by writer?\nfunction canRead(reader: Type, writer: Type) {\n  try {\n    reader.createResolver(writer);\n    return true;\n  } catch {\n    return false;\n  }\n}",
   "autoResize": true,
   "lineHeight": 1.25
  },
