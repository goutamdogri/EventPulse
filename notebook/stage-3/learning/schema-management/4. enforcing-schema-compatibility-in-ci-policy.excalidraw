   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Mirrors production; call the read-only compatibility\nendpoint. Cheap and realistic; depends on staging\nbeing in sync and reachable; needs a read-only\ncredential.",
   "fontSize": 28,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Mirrors production; call the read-only compatibility\nendpoint. Cheap and realistic; depends on staging\nbeing in sync and reachable; needs a read-only\ncredential.",
