   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Proxy caveat (beyond the note): in the Confluent API, looking up an exact schema under a subject is a POST, and so is the compatibility test. Block write\noperations by method AND path, not every POST.",
   "fontSize": 28,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec-01603",
   "originalText": "Proxy caveat (beyond the note): in the Confluent API, looking up an exact schema under a subject is a POST, and so is the compatibility test. Block write operations by method AND path, not every POST.",
   "autoResize": true,
   "lineHeight": 1.25
  },
