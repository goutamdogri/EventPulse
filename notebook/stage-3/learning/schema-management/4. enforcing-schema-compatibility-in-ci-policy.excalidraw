   "link": null,
   "locked": false,
   "text": "\"The registry already checks, so CI is redundant.\"",
   "fontSize": 29,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\"The registry already checks, so CI is redundant.\"",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rec-02106",
   "type": "rectangle",
   "x": 1030,
