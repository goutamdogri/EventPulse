   "text": "- DIFFERENT Avro implementation (JavaScript vs Java): aliases, enum\ndefaults, logical types, unions may differ\n- Does not know the configured mode or the real history\n- You maintain it",
   "fontSize": 28,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "- DIFFERENT Avro implementation (JavaScript vs Java): aliases, enum\ndefaults, logical types, unions may differ\n- Does not know the configured mode or the real history\n- You maintain it",
   "autoResize": true,
   "lineHeight": 1.25
  },
