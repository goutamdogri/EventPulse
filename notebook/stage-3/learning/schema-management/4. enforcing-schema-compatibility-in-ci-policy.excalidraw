  {
   "id": "tex-01051",
   "type": "text",
   "x": 982,
   "y": 25470.5,
   "width": 1316.95,
   "height": 145.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp-d11",
