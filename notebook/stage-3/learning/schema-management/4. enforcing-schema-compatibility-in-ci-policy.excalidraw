   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "docker compose: Kafka + registry. Seed it by\nregistering v1..vN from git, in order, with the\nsubject's mode; then check the candidate.\nHermetic and reproducible, but matches production\nonly if git and production are in sync (drift\ncheck).",
   "fontSize": 28,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "docker compose: Kafka + registry. Seed it by\nregistering v1..vN from git, in order, with the\nsubject's mode; then check the candidate.\nHermetic and reproducible, but matches production\nonly if git and production are in sync (drift\ncheck).",
   "autoResize": true,
   "lineHeight": 1.25
  },
