   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Compatibility checks are necessary\nbut not sufficient: a compatible yet\nUNREVIEWED change (a field nobody\nexpected) can reach production\nthrough a stray deploy.",
   "originalText": "Compatibility checks are necessary\nbut not sufficient: a compatible yet\nUNREVIEWED change (a field nobody\nexpected) can reach production\nthrough a stray deploy.",
