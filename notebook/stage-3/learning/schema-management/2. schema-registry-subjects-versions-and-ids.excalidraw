   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Trade-off to remember: with TopicNameStrategy a topic is limited to ONE evolving schema (one subject).\nMultiple record types then need a top-level union or a different strategy. Hard to reverse: subject names are baked into registered history.",
   "originalText": "Trade-off to remember: with TopicNameStrategy a topic is limited to ONE evolving schema (one subject).\nMultiple record types then need a top-level union or a different strategy. Hard to reverse: subject names are baked into registered history.",
   "fontSize": 30,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "sr2-00250",
   "autoResize": true,
