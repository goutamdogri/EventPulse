   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The serialization failure is a FEATURE. A producer whose schema differs from\neverything registered (auto-register off) fails at the FIRST send, before one bad\nmessage enters the log. Failing in a canary or staging beats failing in ten consumers\na day later.",
   "originalText": "The serialization failure is a FEATURE. A producer whose schema differs from\neverything registered (auto-register off) fails at the FIRST send, before one bad\nmessage enters the log. Failing in a canary or staging beats failing in ten consumers\na day later.",
   "fontSize": 29,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "sr2-00491",
   "autoResize": true,
