   "link": null,
   "locked": false
  },
  {
   "id": "el00827",
   "type": "text",
   "x": 828.9,
   "y": 18654.62,
   "width": 682.2,
   "height": 253.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "diagramGroup10",
    "columnGroupSchemaWireFormat"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1982631007,
   "version": 1,
   "versionNonce": 1572423166,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why not JSON + JSON Schema?\n\nYou can, and many teams do. But you still need\nthe registry, ids and compatibility checks, AND\nyou keep JSON's size and parse cost. Stage 3\nwants the evolution rules where they are\ncleanest.",
   "originalText": "Why not JSON + JSON Schema?\n\nYou can, and many teams do. But you still need\nthe registry, ids and compatibility checks, AND\nyou keep JSON's size and parse cost. Stage 3\nwants the evolution rules where they are\ncleanest.",
   "fontSize": 29,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "el00826",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "el00828",
   "type": "rectangle",
   "x": 1550,
   "y": 18616.5,
   "width": 720,
   "height": 330,
   "angle": 0,
   "strokeColor": "#c92a2a",
   "backgroundColor": "#ffe3e3",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
