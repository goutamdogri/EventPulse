   "locked": false
  },
  {
   "id": "el00829",
   "type": "text",
   "x": 1588.24,
   "y": 18654.62,
   "width": 643.51,
   "height": 253.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "diagramGroup10",
