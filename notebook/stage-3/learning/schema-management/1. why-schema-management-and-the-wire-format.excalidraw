   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The framing and encoding change completely: old consumers fail on new bytes. It\nbreaks the topic itself: new topic or dual-format cutover.",
   "originalText": "The framing and encoding change completely: old consumers fail on new bytes. It\nbreaks the topic itself: new topic or dual-format cutover.",
   "fontSize": 29,
   "fontFamily": 5,
