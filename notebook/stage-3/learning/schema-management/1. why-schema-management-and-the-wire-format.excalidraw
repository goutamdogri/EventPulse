   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Cannot be decoded: a PERMANENT failure. Send to the DLQ with diagnostic metadata\n(S3-F5), never into an infinite retry loop.\nExample: plain JSON starts with '{' = 0x7B, so fail fast with a clear message instead of\ndecoding garbage.",
   "originalText": "Cannot be decoded: a PERMANENT failure. Send to the DLQ with diagnostic metadata\n(S3-F5), never into an infinite retry loop.\nExample: plain JSON starts with '{' = 0x7B, so fail fast with a clear message instead of\ndecoding garbage.",
   "fontSize": 29,
   "fontFamily": 5,
