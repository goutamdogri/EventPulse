   "text": "9. Why is JSON to Avro not an \"evolution\"?",
   "originalText": "9. Why is JSON to Avro not an \"evolution\"?",
   "fontSize": 29,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
