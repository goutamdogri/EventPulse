   ],
   "frameId": null,
   "roundness": null,
   "seed": 463459418,
   "version": 1,
   "versionNonce": 482106592,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Trap with JSON + registry\n\nCompatibility of JSON Schema is harder to\ndefine (open vs closed additionalProperties),\nso \"compatible\" can differ between tools.\nAvro's closed, positional model avoids that\nambiguity.",
   "originalText": "Trap with JSON + registry\n\nCompatibility of JSON Schema is harder to\ndefine (open vs closed additionalProperties),\nso \"compatible\" can differ between tools.\nAvro's closed, positional model avoids that\nambiguity.",
   "fontSize": 29,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "el00828",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
