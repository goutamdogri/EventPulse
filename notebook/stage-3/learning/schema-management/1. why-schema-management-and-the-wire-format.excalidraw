  {
   "id": "el00825",
   "type": "text",
   "x": 89.9,
   "y": 18654.62,
   "width": 680.19,
   "height": 253.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "diagramGroup10",
    "columnGroupSchemaWireFormat"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 451892760,
   "version": 1,
   "versionNonce": 2013155208,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why Avro for Stage 3\n\nRegistry compatibility rules and tooling are the\nmost mature. The reader/writer resolution\nmodel states the rules precisely: they are\nexactly the rules under which resolution\nsucceeds.",
   "originalText": "Why Avro for Stage 3\n\nRegistry compatibility rules and tooling are the\nmost mature. The reader/writer resolution\nmodel states the rules precisely: they are\nexactly the rules under which resolution\nsucceeds.",
   "fontSize": 29,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "el00824",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "el00826",
   "type": "rectangle",
   "x": 810,
   "y": 18616.5,
   "width": 720,
   "height": 330,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "#fff3bf",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "diagramGroup10",
    "columnGroupSchemaWireFormat"
   ],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1400735137,
   "version": 1,
   "versionNonce": 1259334566,
   "isDeleted": false,
   "boundElements": [
