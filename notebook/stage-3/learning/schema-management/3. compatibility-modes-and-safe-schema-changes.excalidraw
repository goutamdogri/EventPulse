  {
   "id": "tex02322",
   "type": "text",
   "x": 1044,
   "y": 46335.0,
   "width": 1250.85,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
