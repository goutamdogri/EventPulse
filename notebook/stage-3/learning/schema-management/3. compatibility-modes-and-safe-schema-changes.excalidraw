   "isDeleted": false,
   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "Any old/new writer with any old/new reader of\nADJACENT versions resolves. Non-adjacent\nversions need FULL_TRANSITIVE.\n\nRight default for independent teams where\nnobody controls deploy order.",
   "originalText": "Any old/new writer with any old/new reader of\nADJACENT versions resolves. Non-adjacent\nversions need FULL_TRANSITIVE.\n\nRight default for independent teams where\nnobody controls deploy order.",
