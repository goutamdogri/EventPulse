   "isDeleted": false,
   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "No. It protects the NEW reader on OLD data. Old consumers on new data is FORWARD.",
   "originalText": "No. It protects the NEW reader on OLD data. Old consumers on new data is FORWARD.",
   "fontSize": 28,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
