   "isDeleted": false,
   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "'FORWARD is safe, it sounds future-proof.'",
   "originalText": "'FORWARD is safe, it sounds future-proof.'",
   "fontSize": 28,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
