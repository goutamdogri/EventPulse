   "isDeleted": false,
   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "Replay, rewind, bootstrap from earliest, DLQ read\n-> you need the BACKWARD direction (BACKWARD\nor FULL).",
   "originalText": "Replay, rewind, bootstrap from earliest, DLQ read\n-> you need the BACKWARD direction (BACKWARD\nor FULL).",
