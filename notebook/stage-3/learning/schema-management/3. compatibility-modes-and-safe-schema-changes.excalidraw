   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "An enum buys validation and compactness and costs\nevolvability. Open, changing sets (EventPulse event\n'type' is tenant-defined): use string. Closed stable\nsets: enum WITH a default.",
   "originalText": "An enum buys validation and compactness and costs\nevolvability. Open, changing sets (EventPulse event\n'type' is tenant-defined): use string. Closed stable\nsets: enum WITH a default.",
