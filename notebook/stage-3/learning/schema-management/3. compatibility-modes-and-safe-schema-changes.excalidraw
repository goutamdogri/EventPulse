   "isDeleted": false,
   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "Rolling deploys, slow consumers: old and new coexist\n-> you need the FORWARD direction.",
   "originalText": "Rolling deploys, slow consumers: old and new coexist\n-> you need the FORWARD direction.",
