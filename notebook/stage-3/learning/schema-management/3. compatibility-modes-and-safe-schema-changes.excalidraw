   "isDeleted": false,
   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "Own both sides and can reliably deploy consumers\nfirst -> BACKWARD works.\nDifferent teams own them -> prefer FULL.",
   "originalText": "Own both sides and can reliably deploy consumers\nfirst -> BACKWARD works.\nDifferent teams own them -> prefer FULL.",
   "fontSize": 26,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
