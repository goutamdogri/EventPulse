   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "Only in a BACKWARD-only world: consumers\nupgraded first, no old consumer ever reads new\ndata. Under FULL / FULL_TRANSITIVE a rename\nis rejected, and should be.",
   "originalText": "Only in a BACKWARD-only world: consumers\nupgraded first, no old consumer ever reads new\ndata. Under FULL / FULL_TRANSITIVE a rename\nis rejected, and should be.",
   "fontSize": 26,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
