   "isDeleted": false,
   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "The cost: TRANSITIVE gets stricter over time (v1 can veto a change that is fine against v3). That is the point: it reflects real data that\nexists. Registry cost is trivial; the human cost is discipline. You cannot 'clean up' an old mistake (remove a default, make a field required) unless\nyou move to a new subject or topic.",
   "originalText": "The cost: TRANSITIVE gets stricter over time (v1 can veto a change that is fine against v3). That is the point: it reflects real data that\nexists. Registry cost is trivial; the human cost is discipline. You cannot 'clean up' an old mistake (remove a default, make a field required) unless\nyou move to a new subject or topic.",
   "fontSize": 30,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec00680",
   "autoResize": true,
   "lineHeight": 1.25
  },
