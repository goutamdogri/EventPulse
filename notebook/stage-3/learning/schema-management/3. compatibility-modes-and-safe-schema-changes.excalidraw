   "link": null,
   "locked": false,
   "text": "Seven rules of thumb",
   "originalText": "Seven rules of thumb",
   "fontSize": 36,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rec02312",
   "type": "rectangle",
   "x": 70,
   "y": 45835.75,
   "width": 2260,
   "height": 319.25,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "#fff9db",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "compatGroup20",
    "columnGroupCompatModes"
   ],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1398514444,
   "version": 1,
   "versionNonce": 562560209,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false
  },
  {
   "id": "tex02313",
   "type": "text",
   "x": 94,
   "y": 45859.75,
   "width": 1489.47,
   "height": 271.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "compatGroup20",
    "columnGroupCompatModes"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 563853576,
   "version": 1,
   "versionNonce": 624943807,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "1. Only add or remove OPTIONAL fields; everything else needs expand/contract or a new topic.\n2. Give every non-core field a default from day one, so removal stays possible.\n3. Never change meaning. The checker cannot see it.\n4. Use TRANSITIVE wherever data outlives a deploy. On Kafka that is almost always.\n5. Declare default symbols on enums, or avoid enums.\n6. A rename is a migration, not an edit.\n7. If the registry says no, believe it: design the migration instead of the bypass.",
   "originalText": "1. Only add or remove OPTIONAL fields; everything else needs expand/contract or a new topic.\n2. Give every non-core field a default from day one, so removal stays possible.\n3. Never change meaning. The checker cannot see it.\n4. Use TRANSITIVE wherever data outlives a deploy. On Kafka that is almost always.\n5. Declare default symbols on enums, or avoid enums.\n6. A rename is a migration, not an edit.\n7. If the registry says no, believe it: design the migration instead of the bypass.",
   "fontSize": 31,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "tex02314",
