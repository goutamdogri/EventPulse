   "versionNonce": 639310124,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "With an enum-level default symbol (Avro 1.9+),\nunknown symbols resolve to it, turning some FAIL\ninto OK. Declare one on every enum you expose\n(idiom: UNKNOWN).",
   "originalText": "With an enum-level default symbol (Avro 1.9+),\nunknown symbols resolve to it, turning some FAIL\ninto OK. Declare one on every enum you expose\n(idiom: UNKNOWN).",
