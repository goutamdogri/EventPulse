   "isDeleted": false,
   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "Non-transitive modes compare N only with the LATEST version. That is a LOCAL guarantee: 'v2 reads v1' and 'v3 reads v2' do NOT imply 'v3 reads\nv1'.",
   "originalText": "Non-transitive modes compare N only with the LATEST version. That is a LOCAL guarantee: 'v2 reads v1' and 'v3 reads v2' do NOT imply 'v3 reads\nv1'.",
   "fontSize": 30,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "tex00618",
   "type": "text",
   "x": 70,
   "y": 15022.25,
   "width": 1888.39,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "compatGroup07",
    "columnGroupCompatModes"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1038573287,
   "version": 1,
   "versionNonce": 385477533,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "Arrows show data flowing from the writer to the reader. Solid = checked by every mode. Dashed red = checked only by TRANSITIVE.",
   "originalText": "Arrows show data flowing from the writer to the reader. Solid = checked by every mode. Dashed red = checked only by TRANSITIVE.",
   "fontSize": 28,
