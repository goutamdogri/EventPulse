   "versionNonce": 904646232,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "The default must match the FIRST branch. For\noptional fields put \"null\" first:\n[\"null\",\"string\"] default null\nReordering branches resolves (matched by type) but\nchanges which branch the default refers to. Avoid.",
   "originalText": "The default must match the FIRST branch. For\noptional fields put \"null\" first:\n[\"null\",\"string\"] default null\nReordering branches resolves (matched by type) but\nchanges which branch the default refers to. Avoid.",
   "fontSize": 26,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
