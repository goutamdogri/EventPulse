   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "Narrowing (long -> int) is the mirror image: FAIL backward, OK forward. Widening therefore needs consumers upgraded first; under FULL it is\nrejected.",
   "originalText": "Narrowing (long -> int) is the mirror image: FAIL backward, OK forward. Widening therefore needs consumers upgraded first; under FULL it is\nrejected.",
   "fontSize": 30,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
