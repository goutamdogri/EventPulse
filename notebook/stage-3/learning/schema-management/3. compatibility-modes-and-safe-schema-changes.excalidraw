   "isDeleted": false,
   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "How: events.raw.v2. Producer\ndual-publishes to old and new;\nconsumers migrate; old topic retired\nafter retention.\n\nTrade-off: clean but expensive;\nordering across topics lost; double\nstorage during migration.",
   "originalText": "How: events.raw.v2. Producer\ndual-publishes to old and new;\nconsumers migrate; old topic retired\nafter retention.\n\nTrade-off: clean but expensive;\nordering across topics lost; double\nstorage during migration.",
