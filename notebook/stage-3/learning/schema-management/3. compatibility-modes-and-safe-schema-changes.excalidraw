   "versionNonce": 942185672,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "Resolution is by symbol NAME, but treat enums as\nappend-only: reordering can change ordinals in some\ncontexts and confuses generated code. Never 'keep\nthem sorted'.",
   "originalText": "Resolution is by symbol NAME, but treat enums as\nappend-only: reordering can change ordinals in some\ncontexts and confuses generated code. Never 'keep\nthem sorted'.",
   "fontSize": 26,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
