   "seed": 562515068,
   "version": 1,
   "versionNonce": 1384100950,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "NOT protected: an OLD consumer reading NEW\ndata. If you cannot upgrade every consumer\nbefore any producer (many teams, third parties),\nBACKWARD alone is not enough.\n\nWhy it is the Kafka default: a new or restarted\nconsumer reading from the beginning meets old\ndata.",
   "originalText": "NOT protected: an OLD consumer reading NEW\ndata. If you cannot upgrade every consumer\nbefore any producer (many teams, third parties),\nBACKWARD alone is not enough.\n\nWhy it is the Kafka default: a new or restarted\nconsumer reading from the beginning meets old\ndata.",
   "fontSize": 27,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rec00375",
   "type": "rectangle",
   "x": 833.33,
   "y": 9032.75,
   "width": 733.33,
   "height": 318.0,
