   "isDeleted": false,
   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "Non-transitive FORWARD accepts v3, yet a consumer still on v1 crashes on v3 data. FORWARD_TRANSITIVE checks every earlier reader and\nREJECTS v3. Rule: use TRANSITIVE whenever readers or data may be several versions behind.",
   "originalText": "Non-transitive FORWARD accepts v3, yet a consumer still on v1 crashes on v3 data. FORWARD_TRANSITIVE checks every earlier reader and\nREJECTS v3. Rule: use TRANSITIVE whenever readers or data may be several versions behind.",
   "fontSize": 30,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec00653",
   "autoResize": true,
   "lineHeight": 1.25
  },
