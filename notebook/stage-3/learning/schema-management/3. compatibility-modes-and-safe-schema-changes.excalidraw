   "locked": false,
   "text": "(a) Rename caveat",
   "originalText": "(a) Rename caveat",
   "fontSize": 32,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
