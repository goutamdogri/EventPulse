   ],
   "frameId": null,
   "roundness": null,
   "seed": 69612972,
   "version": 1,
   "versionNonce": 902189341,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "A rename can PASS the checker while destroying\ndata when old and new fields both have defaults.\nVerdicts shown are for fields without defaults.",
   "originalText": "A rename can PASS the checker while destroying\ndata when old and new fields both have defaults.\nVerdicts shown are for fields without defaults.",
   "fontSize": 26,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
