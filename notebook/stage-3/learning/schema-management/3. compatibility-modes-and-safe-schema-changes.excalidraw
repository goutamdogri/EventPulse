   "link": null,
   "locked": false,
   "text": "Avro, NON-transitive, judged against the previous version only. OK = registry accepts, FAIL = rejected. For *_TRANSITIVE a cell is OK only if it\nholds against EVERY earlier version.",
   "originalText": "Avro, NON-transitive, judged against the previous version only. OK = registry accepts, FAIL = rejected. For *_TRANSITIVE a cell is OK only if it\nholds against EVERY earlier version.",
