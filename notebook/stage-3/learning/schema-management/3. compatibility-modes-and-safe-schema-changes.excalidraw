  {
   "id": "tex00376",
   "type": "text",
   "x": 857.33,
   "y": 9056.75,
   "width": 682.04,
   "height": 270.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "compatGroup04",
