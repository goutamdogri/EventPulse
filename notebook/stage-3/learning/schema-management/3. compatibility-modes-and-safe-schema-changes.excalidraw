  },
  {
   "id": "tex01003",
   "type": "text",
   "x": 94,
   "y": 19727.25,
   "width": 648.48,
   "height": 97.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "compatGroup08",
