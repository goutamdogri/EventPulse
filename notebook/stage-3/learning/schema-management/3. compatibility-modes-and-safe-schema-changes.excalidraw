   "isDeleted": false,
   "boundElements": null,
   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "Adding the default later (row 19) is enough for non-transitive FULL. Under\nFULL_TRANSITIVE, removal is checked against EVERY earlier version: if v1 had\namount_cents with no default, a v1 reader cannot read the new data, so step 6\nis still rejected (FORWARD counterexample, diagram 7).",
   "originalText": "Adding the default later (row 19) is enough for non-transitive FULL. Under\nFULL_TRANSITIVE, removal is checked against EVERY earlier version: if v1 had\namount_cents with no default, a v1 reader cannot read the new data, so step 6\nis still rejected (FORWARD counterexample, diagram 7).",
   "fontSize": 26,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
