   "updated": 1764115200000,
   "link": null,
   "locked": false,
   "text": "1. Do you control deploy order?",
   "originalText": "1. Do you control deploy order?",
   "fontSize": 32,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "tex00520",
   "type": "text",
   "x": 94,
   "y": 12182.25,
   "width": 644.33,
   "height": 97.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
