   "text": "A compatibility checker verifies that decoding will NOT THROW. It cannot verify that the decoded value still MEANS the same thing.",
   "originalText": "A compatibility checker verifies that decoding will NOT THROW. It cannot verify that the decoded value still MEANS the same thing.",
   "fontSize": 30,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
