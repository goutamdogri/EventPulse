  {
   "id": "tex-00382",
   "type": "text",
   "x": 68,
   "y": 9249.75,
   "width": 730.26,
   "height": 800.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
