  {
   "id": "tex-00925",
   "type": "text",
   "x": 275.3,
   "y": 19772.75,
   "width": 1249.39,
   "height": 78.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
