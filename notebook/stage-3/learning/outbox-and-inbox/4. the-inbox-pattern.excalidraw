   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Outbox: change + publish intent atomic, delivery at-least-once. Inbox: marker + effect atomic,\nrepeats are no-ops. Only local transactions.",
   "originalText": "Outbox: change + publish intent atomic, delivery at-least-once. Inbox: marker + effect atomic,\nrepeats are no-ops. Only local transactions.",
