   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "As long as a duplicate can still arrive (topic retention, downtime, relay horizon, replay window)\nplus margin. Too early: a late copy applies again.",
   "originalText": "As long as a duplicate can still arrive (topic retention, downtime, relay horizon, replay window)\nplus margin. Too early: a late copy applies again.",
