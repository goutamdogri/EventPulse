   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "A relay / producer duplicate gets a new offset. Right only for redelivery of the same record to\nthe same group (transactional offset store).",
   "originalText": "A relay / producer duplicate gets a new offset. Right only for redelivery of the same record to\nthe same group (transactional offset store).",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rec-01599",
   "autoResize": true,
   "lineHeight": 1.25
  },
