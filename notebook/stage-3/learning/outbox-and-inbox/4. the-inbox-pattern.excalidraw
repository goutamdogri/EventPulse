   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "The inbox does not replace offset commits. DB commit first, Kafka offset second, always.",
   "originalText": "The inbox does not replace offset commits. DB commit first, Kafka offset second, always.",
   "fontSize": 22,
   "fontFamily": 5,
