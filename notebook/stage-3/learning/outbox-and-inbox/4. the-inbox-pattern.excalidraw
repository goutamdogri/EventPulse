   "link": null,
   "locked": false,
   "text": "The marker can only commit atomically with the\neffect if both are in one database. This is a\nrequirement, not a suggestion.",
   "originalText": "The marker can only commit atomically with the\neffect if both are in one database. This is a\nrequirement, not a suggestion.",
