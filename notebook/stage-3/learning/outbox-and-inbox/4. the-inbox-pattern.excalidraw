   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Index size  =  rate x window x about 80 bytes",
   "originalText": "Index size  =  rate x window x about 80 bytes",
   "fontSize": 25,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "tex-00932",
   "type": "text",
   "x": 892,
   "y": 20008.5,
   "width": 646.07,
   "height": 105.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp-diagram-13",
    "grp-column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1697592190,
   "version": 1,
   "versionNonce": 2073843954,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "1,000 msg/s  x  7 days (604,800 s)  =  about 600 million rows\n600 M x 80 bytes  =  roughly 48 GB: tens of GB\n\nAt that scale prefer partition drops or natural-key dedupe.",
   "originalText": "1,000 msg/s  x  7 days (604,800 s)  =  about 600 million rows\n600 M x 80 bytes  =  roughly 48 GB: tens of GB\n\nAt that scale prefer partition drops or natural-key dedupe.",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
