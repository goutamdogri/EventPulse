   "locked": false
  },
  {
   "id": "tex-01141",
   "type": "text",
   "x": 427.81,
   "y": 25275.75,
   "width": 944.38,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp-diagram-16",
    "grp-column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 890441885,
   "version": 1,
   "versionNonce": 1416801857,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "The inbox gives an exactly-once effect ONLY for effects in its own database.\nFor everything else the guarantee is: at-least-once  +  downstream idempotency.",
   "originalText": "The inbox gives an exactly-once effect ONLY for effects in its own database.\nFor everything else the guarantee is: at-least-once  +  downstream idempotency.",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec-01140",
   "autoResize": true,
   "lineHeight": 1.25
  },
