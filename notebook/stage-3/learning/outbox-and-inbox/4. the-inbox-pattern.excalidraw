   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "The behaviour comes from the unique\nindex, not from the isolation level.",
   "originalText": "The behaviour comes from the unique\nindex, not from the isolation level.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
