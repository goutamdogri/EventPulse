   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Marker and effect roll back together. Redelivery\nsees no marker and does the full work.\n\nNo loss, no double effect.",
   "originalText": "Marker and effect roll back together. Redelivery\nsees no marker and does the full work.\n\nNo loss, no double effect.",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
