   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Only if marker and business-row locks\nare taken in different orders. Always:\nmarker first, then rows in a fixed\norder.",
   "originalText": "Only if marker and business-row locks\nare taken in different orders. Always:\nmarker first, then rows in a fixed\norder.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
