   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "const messageId = header(msg, \"event-id\");   // set by the outbox\nconst client = await pool.connect();\ntry {\n    await client.query(\"BEGIN\");\n\n    // 1. claim the id: the unique key decides who is first\n    const claim = await client.query(\n        `INSERT INTO inbox (consumer, message_id) VALUES ($1, $2)\n         ON CONFLICT (consumer, message_id) DO NOTHING`,\n        [\"config-cache-updater\", messageId]);\n\n    if (claim.rowCount === 0) {        // 2a. duplicate\n        await client.query(\"COMMIT\");  // just ends the tx\n        metrics.duplicatesSkipped.inc();\n        return;\n    }\n\n    // 2b. first time: effect in the SAME transaction\n    await client.query(\n        `INSERT INTO tenant_config_cache (tenant_id, version, settings)\n         VALUES ($1, $2, $3) ON CONFLICT (tenant_id) DO UPDATE\n         SET version = EXCLUDED.version, settings = EXCLUDED.settings\n         WHERE tenant_config_cache.version < EXCLUDED.version`,\n        [event.tenantId, event.version, event.settings]);\n\n    await client.query(\"COMMIT\");      // 3. marker + effect\n} catch (e) {\n    await client.query(\"ROLLBACK\");    // marker undone too\n    throw e;                           // do NOT commit offset\n} finally {\n    client.release();\n}",
   "originalText": "const messageId = header(msg, \"event-id\");   // set by the outbox\nconst client = await pool.connect();\ntry {\n    await client.query(\"BEGIN\");\n\n    // 1. claim the id: the unique key decides who is first\n    const claim = await client.query(\n        `INSERT INTO inbox (consumer, message_id) VALUES ($1, $2)\n         ON CONFLICT (consumer, message_id) DO NOTHING`,\n        [\"config-cache-updater\", messageId]);\n\n    if (claim.rowCount === 0) {        // 2a. duplicate\n        await client.query(\"COMMIT\");  // just ends the tx\n        metrics.duplicatesSkipped.inc();\n        return;\n    }\n\n    // 2b. first time: effect in the SAME transaction\n    await client.query(\n        `INSERT INTO tenant_config_cache (tenant_id, version, settings)\n         VALUES ($1, $2, $3) ON CONFLICT (tenant_id) DO UPDATE\n         SET version = EXCLUDED.version, settings = EXCLUDED.settings\n         WHERE tenant_config_cache.version < EXCLUDED.version`,\n        [event.tenantId, event.version, event.settings]);\n\n    await client.query(\"COMMIT\");      // 3. marker + effect\n} catch (e) {\n    await client.query(\"ROLLBACK\");    // marker undone too\n    throw e;                           // do NOT commit offset\n} finally {\n    client.release();\n}",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
