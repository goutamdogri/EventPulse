   "link": null,
   "locked": false,
   "text": "CREATE TABLE inbox (\n    consumer text NOT NULL,   -- logical consumer / handler name\n    message_id uuid NOT NULL,   -- producer-assigned event_id (outbox event_id)\n    processed_at timestamptz NOT NULL DEFAULT now(),\n    PRIMARY KEY (consumer, message_id)   -- the enforcement mechanism\n);\nCREATE INDEX inbox_processed_at_idx ON inbox (processed_at);   -- for retention deletes",
   "originalText": "CREATE TABLE inbox (\n    consumer text NOT NULL,   -- logical consumer / handler name\n    message_id uuid NOT NULL,   -- producer-assigned event_id (outbox event_id)\n    processed_at timestamptz NOT NULL DEFAULT now(),\n    PRIMARY KEY (consumer, message_id)   -- the enforcement mechanism\n);\nCREATE INDEX inbox_processed_at_idx ON inbox (processed_at);   -- for retention deletes",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
