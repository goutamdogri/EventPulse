   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Before COMMIT: rolled back, retried fresh. After COMMIT, offset not committed: redelivered\nand skipped. COMMIT outcome unknown: either way applied once.",
   "originalText": "Before COMMIT: rolled back, retried fresh. After COMMIT, offset not committed: redelivered\nand skipped. COMMIT outcome unknown: either way applied once.",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rec-01587",
   "autoResize": true,
