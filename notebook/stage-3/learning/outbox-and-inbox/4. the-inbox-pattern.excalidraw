   "text": "INSERT INTO tenant_config_cache (tenant_id, version, settings) VALUES ($1, $2, $3)\nON CONFLICT (tenant_id) DO UPDATE SET version = EXCLUDED.version, settings = EXCLUDED.settings\nWHERE tenant_config_cache.version < EXCLUDED.version;",
