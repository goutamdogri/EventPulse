   "link": null,
   "locked": false,
   "text": "Commit offsets for the whole batch\nonly after the transaction commits. A\ncrash replays the batch; the inbox\nabsorbs it.",
   "originalText": "Commit offsets for the whole batch\nonly after the transaction commits. A\ncrash replays the batch; the inbox\nabsorbs it.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
