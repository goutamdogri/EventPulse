   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "DB then offset = at-least-once (inbox absorbs replays). Offset then DB = at-most-once: a\ncrash loses the message for good.",
   "originalText": "DB then offset = at-least-once (inbox absorbs replays). Offset then DB = at-most-once: a\ncrash loses the message for good.",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rec-01591",
   "autoResize": true,
