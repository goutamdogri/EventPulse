   "type": "text",
   "x": 68,
   "y": 20008.5,
   "width": 599.72,
   "height": 105.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
