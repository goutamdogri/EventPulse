   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Two transactions can both read 'not\nfound' and both proceed: a\ncheck-then-act race. The insert is\nthe check.",
   "originalText": "Two transactions can both read 'not\nfound' and both proceed: a\ncheck-then-act race. The insert is\nthe check.",
