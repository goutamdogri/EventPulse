   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "The second insert waits on the first's uncommitted unique entry. First commits: second skips.\nFirst rolls back: second proceeds. Only one applies.",
   "originalText": "The second insert waits on the first's uncommitted unique entry. First commits: second skips.\nFirst rolls back: second proceeds. Only one applies.",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rec-01595",
   "autoResize": true,
   "lineHeight": 1.25
  },
