   "seed": 1454595527,
   "version": 1,
   "versionNonce": 1043820753,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Caution (Postgres rule, worth adding to the note): a unique key on a partitioned table must include the partition key.\nprocessed_at = DEFAULT now() differs on every delivery, so a key containing it would NOT catch a duplicate.\nPartition on a value identical on every copy, e.g. an event time stamped once at the source and carried with the message.",
   "originalText": "Caution (Postgres rule, worth adding to the note): a unique key on a partitioned table must include the partition key.\nprocessed_at = DEFAULT now() differs on every delivery, so a key containing it would NOT catch a duplicate.\nPartition on a value identical on every copy, e.g. an event time stamped once at the source and carried with the message.",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec-00924",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "tex-00926",
