   "seed": 1707279418,
   "version": 1,
   "versionNonce": 1821842730,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "WITH incoming AS (SELECT * FROM unnest($1::uuid[], $2::jsonb[]) AS t(id, payload)),\nfresh AS (\n    INSERT INTO inbox (consumer, message_id)\n    SELECT 'projector', id FROM incoming\n    ON CONFLICT DO NOTHING\n    RETURNING message_id   -- exactly the NEW ids\n)\nINSERT INTO projection (...)   -- effect only for new ids\nSELECT ... FROM incoming JOIN fresh ON fresh.message_id = incoming.id;",
   "originalText": "WITH incoming AS (SELECT * FROM unnest($1::uuid[], $2::jsonb[]) AS t(id, payload)),\nfresh AS (\n    INSERT INTO inbox (consumer, message_id)\n    SELECT 'projector', id FROM incoming\n    ON CONFLICT DO NOTHING\n    RETURNING message_id   -- exactly the NEW ids\n)\nINSERT INTO projection (...)   -- effect only for new ids\nSELECT ... FROM incoming JOIN fresh ON fresh.message_id = incoming.id;",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
