  {
   "id": "tex-01178",
   "type": "text",
   "x": 314.27,
   "y": 26477.75,
   "width": 1171.46,
   "height": 78.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp-diagram-17",
