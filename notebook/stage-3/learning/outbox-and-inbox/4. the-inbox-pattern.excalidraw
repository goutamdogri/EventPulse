   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "No retryable path ends with zero or two effects: that is the exactly-once EFFECT claim.\nIt holds ONLY if the effect is entirely inside the same database transaction as the marker.",
   "originalText": "No retryable path ends with zero or two effects: that is the exactly-once EFFECT claim.\nIt holds ONLY if the effect is entirely inside the same database transaction as the marker.",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec-00764",
   "autoResize": true,
   "lineHeight": 1.25
  },
