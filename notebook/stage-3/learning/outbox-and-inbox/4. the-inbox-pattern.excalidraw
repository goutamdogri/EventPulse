   "text": "e.g. an idempotent cache refresh, or an informational notification",
   "originalText": "e.g. an idempotent cache refresh, or an informational notification",
   "fontSize": 22,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
