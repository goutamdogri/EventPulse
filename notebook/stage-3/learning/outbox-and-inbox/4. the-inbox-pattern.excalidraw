   "seed": 728129393,
   "version": 1,
   "versionNonce": 1065696453,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Retention cleanup is a mass DELETE:\n- run it in batches with a small LIMIT\n- run it off-peak\n- watch autovacuum (same bloat reasoning as the outbox)",
   "originalText": "Retention cleanup is a mass DELETE:\n- run it in batches with a small LIMIT\n- run it off-peak\n- watch autovacuum (same bloat reasoning as the outbox)",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
