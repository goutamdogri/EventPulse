   "link": null,
   "locked": false,
   "text": "6.  Why is the Kafka offset a bad dedupe id, and when is it\nright?",
   "originalText": "6.  Why is the Kafka offset a bad dedupe id, and when is it\nright?",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rec-01597",
   "autoResize": true,
