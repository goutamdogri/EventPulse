   "frameId": null,
   "roundness": null,
   "seed": 1936525772,
   "version": 1,
   "versionNonce": 825107579,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Watch out (worth adding to the note's SQL): the JOIN is against 'incoming', which still holds BOTH B rows,\nso B's effect row would come out twice. Deduplicate the input first to get the intended effect (A once, B once):\nincoming AS (SELECT DISTINCT ON (id) id, payload FROM unnest($1::uuid[], $2::jsonb[]) AS t(id, payload))",
   "originalText": "Watch out (worth adding to the note's SQL): the JOIN is against 'incoming', which still holds BOTH B rows,\nso B's effect row would come out twice. Deduplicate the input first to get the intended effect (A once, B once):\nincoming AS (SELECT DISTINCT ON (id) id, payload FROM unnest($1::uuid[], $2::jsonb[]) AS t(id, payload))",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec-01177",
   "autoResize": true,
   "lineHeight": 1.25
  },
