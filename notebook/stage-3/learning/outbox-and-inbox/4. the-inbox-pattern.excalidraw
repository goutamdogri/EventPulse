   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "17. Batch consumers: the same principle, one transaction per batch",
   "originalText": "17. Batch consumers: the same principle, one transaction per batch",
   "fontSize": 38,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "tex-01143",
   "type": "text",
   "x": 50,
   "y": 25684.25,
   "width": 1218.49,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp-diagram-17",
    "grp-column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 968775118,
   "version": 1,
   "versionNonce": 1775670158,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "High-throughput consumers (like the EventPulse sink, which writes chunks) handle many messages per transaction.",
   "originalText": "High-throughput consumers (like the EventPulse sink, which writes chunks) handle many messages per transaction.",
   "fontSize": 22,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
