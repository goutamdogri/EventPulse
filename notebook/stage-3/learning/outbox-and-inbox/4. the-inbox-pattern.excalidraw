   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "The trade-off",
   "originalText": "The trade-off",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "tex-01136",
   "type": "text",
   "x": 1248,
   "y": 24878.75,
   "width": 480.92,
   "height": 125.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp-diagram-16",
    "grp-column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1372248984,
   "version": 1,
   "versionNonce": 1651729436,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Claim then call, no recovery: at-most-once if you\ncrash after the claim.\nState machine + recovery: at-least-once. The call\ncan still repeat in the ambiguity window unless\nthe downstream is idempotent.",
   "originalText": "Claim then call, no recovery: at-most-once if you\ncrash after the claim.\nState machine + recovery: at-least-once. The call\ncan still repeat in the ambiguity window unless\nthe downstream is idempotent.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "tex-01137",
   "type": "text",
   "x": 50,
   "y": 25112.0,
   "width": 676.62,
   "height": 33.75,
   "angle": 0,
   "strokeColor": "#44409e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "grp-diagram-16",
    "grp-column"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 52814604,
   "version": 1,
   "versionNonce": 314099781,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Option 4: accept duplicates when they are harmless",
   "originalText": "Option 4: accept duplicates when they are harmless",
   "fontSize": 27,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
