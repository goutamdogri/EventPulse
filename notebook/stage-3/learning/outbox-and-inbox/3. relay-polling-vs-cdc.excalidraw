   "versionNonce": 1503694342,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "WAL as written: records from concurrent transactions are interleaved (LSN grows to the right)",
   "originalText": "WAL as written: records from concurrent transactions are interleaved (LSN grows to the right)",
