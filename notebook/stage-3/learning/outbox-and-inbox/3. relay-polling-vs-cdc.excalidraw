   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Send-then-mark is at-least-once (a crash republishes). Mark-then-send is\nat-most-once (a crash loses the event).",
   "originalText": "Send-then-mark is at-least-once (a crash republishes). Mark-then-send is\nat-most-once (a crash loses the event).",
