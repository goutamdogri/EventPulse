   "seed": 1781417403,
   "version": 1,
   "versionNonce": 283657322,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "- Mutual exclusion on rows currently being processed\n- Non-blocking competition between workers\n- Automatic lock release if a worker's connection dies: its transaction aborts and\n   the rows are free again\n- Writers inserting new outbox rows are NOT blocked (row locks only, the table is\n   not locked)",
   "originalText": "- Mutual exclusion on rows currently being processed\n- Non-blocking competition between workers\n- Automatic lock release if a worker's connection dies: its transaction aborts and\n   the rows are free again\n- Writers inserting new outbox rows are NOT blocked (row locks only, the table is\n   not locked)",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
