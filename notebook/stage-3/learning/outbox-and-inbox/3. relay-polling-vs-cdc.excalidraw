   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "It gives non-blocking mutual exclusion on rows. No ordering across workers; not exactly-once.",
   "originalText": "It gives non-blocking mutual exclusion on rows. No ordering across workers; not exactly-once.",
   "fontSize": 22,
   "fontFamily": 5,
