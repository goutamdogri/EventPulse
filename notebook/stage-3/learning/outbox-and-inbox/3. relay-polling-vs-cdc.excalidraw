   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Tenant-config changes are low volume. Postgres and\nKafka already run; no Connect / Debezium. The goal\nis to understand failure modes. One relay (or a\nleader via advisory lock) gives ordering.",
   "originalText": "Tenant-config changes are low volume. Postgres and\nKafka already run; no Connect / Debezium. The goal\nis to understand failure modes. One relay (or a\nleader via advisory lock) gives ordering.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
