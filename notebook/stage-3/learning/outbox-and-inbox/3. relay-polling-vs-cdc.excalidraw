   "link": null,
   "locked": false,
   "text": "Sketch detail to fix in real code: topicFor(rows[0].aggregate_type) uses only the first row's type, so with mixed types you must group by topic. Idle backoff: empty ->\nsleep; rows found -> loop immediately and drain the backlog.",
   "originalText": "Sketch detail to fix in real code: topicFor(rows[0].aggregate_type) uses only the first row's type, so with mixed types you must group by topic. Idle backoff: empty ->\nsleep; rows found -> loop immediately and drain the backlog.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec-00412",
   "autoResize": true,
   "lineHeight": 1.25
