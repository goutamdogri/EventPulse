   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "One relay often publishes thousands of rows/s. Add more for throughput or HA, and SKIP LOCKED can reorder.",
   "originalText": "One relay often publishes thousands of rows/s. Add more for throughput or HA, and SKIP LOCKED can reorder.",
