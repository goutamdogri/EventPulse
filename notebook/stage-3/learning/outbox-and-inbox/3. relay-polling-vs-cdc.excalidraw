   "text": "What happens to a row another transaction has locked, under SKIP\nLOCKED? How do NOWAIT and the default differ?",
   "originalText": "What happens to a row another transaction has locked, under SKIP\nLOCKED? How do NOWAIT and the default differ?",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
