   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "The slot is what makes the consumer DURABLE: if the connector is down for an\nhour, Postgres retains that hour of WAL and the connector resumes where it left\noff. (That same promise is the biggest risk, see diagram 17.)",
   "originalText": "The slot is what makes the consumer DURABLE: if the connector is down for an\nhour, Postgres retains that hour of WAL and the connector resumes where it left\noff. (That same promise is the biggest risk, see diagram 17.)",
