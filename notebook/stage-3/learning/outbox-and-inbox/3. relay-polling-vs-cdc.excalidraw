   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Subtle detail at READ COMMITTED: the WHERE clause is re-checked after the lock",
   "originalText": "Subtle detail at READ COMMITTED: the WHERE clause is re-checked after the lock",
   "fontSize": 26,
   "fontFamily": 5,
