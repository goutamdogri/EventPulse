   "link": null,
   "locked": false,
   "text": "Debezium is a RELAY. The pattern is table + transaction; the relay may be polling or CDC.",
   "originalText": "Debezium is a RELAY. The pattern is table + transaction; the relay may be polling or CDC.",
   "fontSize": 22,
