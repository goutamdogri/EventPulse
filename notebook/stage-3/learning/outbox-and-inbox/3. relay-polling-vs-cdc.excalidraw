   "text": "CREATE PUBLICATION dbz_pub FOR TABLE outbox;\n\nSELECT pg_create_logical_replication_slot(\n         'dbz_slot', 'pgoutput');",
   "originalText": "CREATE PUBLICATION dbz_pub FOR TABLE outbox;\n\nSELECT pg_create_logical_replication_slot(\n         'dbz_slot', 'pgoutput');",
