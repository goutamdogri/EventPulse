   "seed": 1459187494,
   "version": 1,
   "versionNonce": 1483241946,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Commit order, no gaps: nothing can be skipped, because a row appears in the stream exactly when its transaction commits. The gap problem cannot occur.",
   "originalText": "Commit order, no gaps: nothing can be skipped, because a row appears in the stream exactly when its transaction commits. The gap problem cannot occur.",
