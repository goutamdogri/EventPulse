   "roundness": null,
   "seed": 1064693737,
   "version": 1,
   "versionNonce": 1288728589,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Do not poll faster than you need. Each poll is one cheap indexed query IF the\npartial index is small: 10 polls/s on an empty queue is negligible; 100 relays x 10/s is\nnot.",
   "originalText": "Do not poll faster than you need. Each poll is one cheap indexed query IF the\npartial index is small: 10 polls/s on an empty queue is negligible; 100 relays x 10/s is\nnot.",
   "fontSize": 22,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec-00665",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "tex-00667",
   "type": "text",
   "x": 50,
