   "text": "A.  Crash BEFORE the send:\ntx aborts, locks released,\nrows still unpublished.\nNext run sends them. Nothing lost.",
   "originalText": "A.  Crash BEFORE the send:\ntx aborts, locks released,\nrows still unpublished.\nNext run sends them. Nothing lost.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec-00730",
   "autoResize": true,
   "lineHeight": 1.25
  },
