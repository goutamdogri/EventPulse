  {
   "id": "tex-00666",
   "type": "text",
   "x": 830.87,
   "y": 13701.0,
   "width": 898.26,
   "height": 82.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
