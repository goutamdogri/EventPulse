   "version": 1,
   "versionNonce": 1514828775,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Adaptive backoff: poll fast while busy, back off up to a cap while idle (values illustrative)",
   "originalText": "Adaptive backoff: poll fast while busy, back off up to a cap while idle (values illustrative)",
   "fontSize": 25,
   "fontFamily": 5,
   "textAlign": "left",
