  {
   "id": "tex-00337",
   "type": "text",
   "x": 926.0,
   "y": 5392.5,
   "width": 801.66,
   "height": 200.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
