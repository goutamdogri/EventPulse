   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "The app inserts into the outbox exactly as before. A connector reads those inserts from the WAL (which Postgres writes anyway for crash recovery and\nreplication) and produces them to Kafka. Only the RELAY is replaced.",
   "originalText": "The app inserts into the outbox exactly as before. A connector reads those inserts from the WAL (which Postgres writes anyway for crash recovery and\nreplication) and produces them to Kafka. Only the RELAY is replaced.",
   "fontSize": 22,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec-00871",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "tex-00873",
   "type": "text",
   "x": 50,
   "y": 17726.75,
   "width": 1163.88,
   "height": 31.25,
   "angle": 0,
   "strokeColor": "#364fc7",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
