   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "A dual write = one logical action that updates two systems which cannot share a transaction, as two separate steps.",
   "originalText": "A dual write = one logical action that updates two systems which cannot share a transaction, as two separate steps.",
   "fontSize": 22,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
