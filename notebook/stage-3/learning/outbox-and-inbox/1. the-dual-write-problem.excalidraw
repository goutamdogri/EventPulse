   "link": null,
   "locked": false,
   "text": "Calling kafka.send() INSIDE the DB transaction does not make the pair atomic. It only moves the window.",
   "originalText": "Calling kafka.send() INSIDE the DB transaction does not make the pair atomic. It only moves the window.",
