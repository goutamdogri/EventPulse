   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Retries help with a broker blip while the process is alive. They lower the probability; they do not close the window. Kafka producer retries are the\nsame: they protect against broker blips, not producer death.",
   "originalText": "Retries help with a broker blip while the process is alive. They lower the probability; they do not close the window. Kafka producer retries are the\nsame: they protect against broker blips, not producer death.",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "p11_r0020",
   "autoResize": true,
   "lineHeight": 1.25
  },
