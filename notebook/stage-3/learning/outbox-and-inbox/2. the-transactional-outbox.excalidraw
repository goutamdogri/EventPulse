   "isDeleted": false,
   "boundElements": [],
   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Why the SAME aggregate is usually safe: its row lock serializes the writers",
   "originalText": "Why the SAME aggregate is usually safe: its row lock serializes the writers",
   "fontSize": 26,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
