   "text": "Row 10 is SKIPPED FOREVER: a lost event, even though the row is committed in the table.",
   "originalText": "Row 10 is SKIPPED FOREVER: a lost event, even though the row is committed in the table.",
   "fontSize": 22,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "p09_r00579",
   "autoResize": true,
