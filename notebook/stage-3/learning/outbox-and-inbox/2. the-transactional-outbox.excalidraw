   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Fixes (note 3): use a published flag instead of a cursor, OR a lock that serializes writers,\nOR transaction-id based visibility, OR CDC (read the WAL).",
   "originalText": "Fixes (note 3): use a published flag instead of a cursor, OR a lock that serializes writers,\nOR transaction-id based visibility, OR CDC (read the WAL).",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
