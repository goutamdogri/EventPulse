   "updated": 1795651200000,
   "link": null,
   "locked": false,
   "text": "Client may retry, so the business operation must be idempotent\n(idempotency key / version check). Else a retry makes a 2nd\nchange and 2nd event.",
   "originalText": "Client may retry, so the business operation must be idempotent\n(idempotency key / version check). Else a retry makes a 2nd\nchange and 2nd event.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
