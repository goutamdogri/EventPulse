   "updated": 1,
   "link": null,
   "locked": false,
   "text": "OBSERVED: the existing originalHeaders helper in the DLQ publisher\ncopies ALL original headers, so incoming replay.* headers survive a second\ndead-lettering.",
   "originalText": "OBSERVED: the existing originalHeaders helper in the DLQ publisher\ncopies ALL original headers, so incoming replay.* headers survive a second\ndead-lettering.",
