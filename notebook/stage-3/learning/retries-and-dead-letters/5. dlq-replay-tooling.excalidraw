   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A replayed message that still had old dlq.* headers would carry STALE\nfacts. The publisher overwrites them, but a good tool STRIPS them\nfirst, so nobody confuses old evidence with new.",
   "originalText": "A replayed message that still had old dlq.* headers would carry STALE\nfacts. The publisher overwrites them, but a good tool STRIPS them\nfirst, so nobody confuses old evidence with new.",
