   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Never auto-replay.\nA scheduled job that replays the DLQ is a\nperpetual-motion machine for poison.\nIf automation is wanted: only for TIME-DEPENDENT\nclasses, using the retry-topic ladder (note 3), not the\nDLQ.",
   "originalText": "Never auto-replay.\nA scheduled job that replays the DLQ is a\nperpetual-motion machine for poison.\nIf automation is wanted: only for TIME-DEPENDENT\nclasses, using the retry-topic ladder (note 3), not the\nDLQ.",
   "fontSize": 30,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "el00703",
   "lineHeight": 1.25,
   "autoResize": true
  },
