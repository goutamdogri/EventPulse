  {
   "id": "el00054",
   "type": "text",
   "x": 835.33,
   "y": 1144.5,
   "width": 667.61,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "diagram01",
