   "versionNonce": 2046089771,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "retry-5s, retry-1m, retry-10m: one constant delay per\ntopic, so the head of the partition is always the next\nrecord to become due.",
   "originalText": "retry-5s, retry-1m, retry-10m: one constant delay per\ntopic, so the head of the partition is always the next\nrecord to become due.",
