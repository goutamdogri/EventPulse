   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Later records for the same key may be processed before\nthe parked one. Fine only if the sink tolerates that\n(idempotent, newest version wins).",
   "originalText": "Later records for the same key may be processed before\nthe parked one. Fine only if the sink tolerates that\n(idempotent, newest version wins).",
