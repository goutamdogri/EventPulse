   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Clock skew: producer and consumer clocks can differ by seconds",
   "originalText": "Clock skew: producer and consumer clocks can differ by seconds",
