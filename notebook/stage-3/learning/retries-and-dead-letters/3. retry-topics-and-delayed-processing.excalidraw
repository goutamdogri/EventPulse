   "versionNonce": 1143445684,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "One line: do not make the partition wait. Move the message somewhere that can wait cheaply, label it with when to come back, and keep the main line\nflowing.",
   "originalText": "One line: do not make the partition wait. Move the message somewhere that can wait cheaply, label it with when to come back, and keep the main line\nflowing.",
   "fontSize": 29,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "el00047",
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 62.35
  },
  {
   "id": "el00049",
   "type": "rectangle",
   "x": 70.0,
   "y": 1075.0,
   "width": 713.33,
