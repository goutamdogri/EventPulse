   "text": "Absolute timestamps are idempotent under redelivery. The relative form also needs to know when the record arrived. (Timeline above is an illustration.)",
   "originalText": "Absolute timestamps are idempotent under redelivery. The relative form also needs to know when the record arrived. (Timeline above is an illustration.)",
   "fontSize": 29,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "el00490",
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 26.1
  },
  {
