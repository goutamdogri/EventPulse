   ],
   "frameId": null,
   "roundness": null,
   "seed": 1269151002,
   "version": 1,
   "versionNonce": 1559883429,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "On a retriable failure, publish the message (plus headers)\nto a retry topic and commit the source offset. The main\npartition moves to the next record.",
   "originalText": "On a retriable failure, publish the message (plus headers)\nto a retry topic and commit the source offset. The main\npartition moves to the next record.",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 81.6
  },
  {
