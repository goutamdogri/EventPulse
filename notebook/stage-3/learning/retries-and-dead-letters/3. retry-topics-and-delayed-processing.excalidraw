   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Longer wait: park it",
   "originalText": "Longer wait: park it",
   "fontSize": 30,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
