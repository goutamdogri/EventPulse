   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "If every record in a topic has the same delay D, then not_before = arrival time + D.",
   "originalText": "If every record in a topic has the same delay D, then not_before = arrival time + D.",
   "fontSize": 27,
   "fontFamily": 5,
