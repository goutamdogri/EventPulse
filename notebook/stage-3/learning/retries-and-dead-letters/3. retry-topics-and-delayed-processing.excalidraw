  {
   "id": "el00057",
   "type": "text",
   "x": 1578.67,
   "y": 1144.5,
   "width": 649.25,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "diagram01",
    "columnGroupRetryTopics"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1418744566,
   "version": 1,
   "versionNonce": 920099031,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A not_before header holds an absolute time. The retry\nconsumer pauses the partition until then. Kafka does\nnot delay messages for you.",
   "originalText": "A not_before header holds an absolute time. The retry\nconsumer pauses the partition until then. Kafka does\nnot delay messages for you.",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 81.6
  },
