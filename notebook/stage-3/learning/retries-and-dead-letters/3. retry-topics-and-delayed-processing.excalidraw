   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Short wait: retry in place",
   "originalText": "Short wait: retry in place",
   "fontSize": 30,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 27.0
  },
  {
   "id": "el00051",
   "type": "text",
   "x": 92.0,
   "y": 1144.5,
   "width": 627.43,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "diagram01",
    "columnGroupRetryTopics"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 180174897,
   "version": 1,
   "versionNonce": 902025839,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Sleeping inside the handler blocks the partition and is\nlimited by the consumer's liveness timers. Good for\nSHORT waits only.",
   "originalText": "Sleeping inside the handler blocks the partition and is\nlimited by the consumer's liveness timers. Good for\nSHORT waits only.",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 81.6
  },
  {
   "id": "el00052",
