   "updated": 1,
   "link": null,
   "locked": false,
   "text": "One bad record freezes a partition. Probability is irrelevant; the consequence is what matters.",
   "originalText": "One bad record freezes a partition. Probability is irrelevant; the consequence is what matters.",
   "fontSize": 23,
   "fontFamily": 5,
