   "updated": 1,
   "link": null,
   "locked": false,
   "text": "It means retrying in place is pointless. The message is kept in the DLQ and can be replayed after a fix.",
   "originalText": "It means retrying in place is pointless. The message is kept in the DLQ and can be replayed after a fix.",
