   "seed": 1926926392,
   "version": 1,
   "versionNonce": 413596100,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Retry transient failures for a time window. If the SAME record keeps hitting the error AFTER\nthe dependency has proven healthy (other records succeed), treat that record as permanent. A\nrow failing alone while its siblings succeed is not suffering from \"the database is down\".",
   "originalText": "Retry transient failures for a time window. If the SAME record keeps hitting the error AFTER\nthe dependency has proven healthy (other records succeed), treat that record as permanent. A\nrow failing alone while its siblings succeed is not suffering from \"the database is down\".",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
