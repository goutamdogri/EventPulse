  {
   "id": "t01019",
   "type": "text",
   "x": 1130,
   "y": 18488.5,
   "width": 1091.8,
   "height": 86.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
