   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\"Timeouts are transient, so a retry is free.\"",
   "originalText": "\"Timeouts are transient, so a retry is free.\"",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
