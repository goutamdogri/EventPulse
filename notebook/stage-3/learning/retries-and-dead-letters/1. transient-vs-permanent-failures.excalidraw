   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Does the problem belong to this message, to a dependency, or to our own code?\nOnly message-scoped failures may ever be dead-lettered.",
   "originalText": "Does the problem belong to this message, to a dependency, or to our own code?\nOnly message-scoped failures may ever be dead-lettered.",
