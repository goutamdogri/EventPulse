   "version": 1,
   "versionNonce": 1516818273,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\"A database that is DOWN (or broken for every row) must never send records to the DLQ.\nOnly a record that fails ON ITS OWN goes there.\"\n\nSYSTEMIC_DB was added on top of the plan's two-class table: without it, a schema\nmistake would drain the whole topic into the DLQ one row at a time.",
   "originalText": "\"A database that is DOWN (or broken for every row) must never send records to the DLQ.\nOnly a record that fails ON ITS OWN goes there.\"\n\nSYSTEMIC_DB was added on top of the plan's two-class table: without it, a schema\nmistake would drain the whole topic into the DLQ one row at a time.",
   "fontSize": 22,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
