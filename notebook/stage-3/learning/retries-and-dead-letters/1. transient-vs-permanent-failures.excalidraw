   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The error is not in our table.\n\nReaction: bounded retry, then quarantine.\nNever \"retry forever\", never \"drop\".",
   "originalText": "The error is not in our table.\n\nReaction: bounded retry, then quarantine.\nNever \"retry forever\", never \"drop\".",
