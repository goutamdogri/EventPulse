   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Its outcome is UNKNOWN: the work may already have happened. Retrying it is only safe if\nthe operation is idempotent.",
   "originalText": "Its outcome is UNKNOWN: the work may already have happened. Retrying it is only safe if\nthe operation is idempotent.",
