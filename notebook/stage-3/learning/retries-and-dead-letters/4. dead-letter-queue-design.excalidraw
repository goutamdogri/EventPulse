   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A consumer reads one partition strictly in order, so one record that can never succeed can hold up everything behind it.",
   "originalText": "A consumer reads one partition strictly in order, so one record that can never succeed can hold up everything behind it.",
