   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1. No delay = attack",
   "originalText": "1. No delay = attack",
   "fontSize": 30,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t00027",
   "type": "text",
   "x": 92.0,
   "y": 665.5,
   "width": 461.79,
   "height": 150.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "diagram01",
    "columnGroupBackoffJitter"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 558886396,
   "version": 1,
   "versionNonce": 78260815,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A retry without a delay attacks your\nown dependency. A FIXED delay\nsynchronises all clients. Exponential +\njitter spreads load and leaves room to\nrecover.",
   "originalText": "A retry without a delay attacks your\nown dependency. A FIXED delay\nsynchronises all clients. Exponential +\njitter spreads load and leaves room to\nrecover.",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
