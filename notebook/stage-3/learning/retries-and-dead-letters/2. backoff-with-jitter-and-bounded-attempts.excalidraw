   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Kafka version: 30 consumer pods + a Postgres failover = a 30-client herd. Add the 6-partition fan-out and several chunks in flight and you reach\nHUNDREDS of simultaneous attempts. Jitter is cheap insurance.",
   "originalText": "Kafka version: 30 consumer pods + a Postgres failover = a 30-client herd. Add the 6-partition fan-out and several chunks in flight and you reach\nHUNDREDS of simultaneous attempts. Jitter is cheap insurance.",
   "fontSize": 29,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "r00713",
   "autoResize": true,
   "lineHeight": 1.25
  },
