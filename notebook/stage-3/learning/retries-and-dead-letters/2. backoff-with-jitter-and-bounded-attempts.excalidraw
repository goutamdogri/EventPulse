  {
   "id": "t00682",
   "type": "text",
   "x": 838.67,
   "y": 9528.75,
   "width": 634.87,
   "height": 93.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
