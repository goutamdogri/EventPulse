   "updated": 1,
   "link": null,
   "locked": false,
   "text": "// config.ts: startup validation\nif (retry.baseMs > retry.maxMs) throw new Error('SINK_RETRY_BASE_MS must be <= SINK_RETRY_MAX_MS');\nif (retry.transientWindowMs + retry.maxMs >= consumer.rebalanceTimeoutMs) {\n  // One eachBatch call must finish within the rebalance timeout (it is also the max poll interval).\n  throw new Error('SINK_TRANSIENT_RETRY_WINDOW_MS + SINK_RETRY_MAX_MS must be < CONSUMER_REBALANCE_TIMEOUT_MS');\n}",
   "originalText": "// config.ts: startup validation\nif (retry.baseMs > retry.maxMs) throw new Error('SINK_RETRY_BASE_MS must be <= SINK_RETRY_MAX_MS');\nif (retry.transientWindowMs + retry.maxMs >= consumer.rebalanceTimeoutMs) {\n  // One eachBatch call must finish within the rebalance timeout (it is also the max poll interval).\n  throw new Error('SINK_TRANSIENT_RETRY_WINDOW_MS + SINK_RETRY_MAX_MS must be < CONSUMER_REBALANCE_TIMEOUT_MS');\n}",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
