   ],
   "frameId": null,
   "roundness": null,
   "seed": 1887438859,
   "version": 1,
   "versionNonce": 1144924544,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "From a neighbouring note (producer note 5, section 11): the producer library, micro-batcher, circuit breaker and HTTP clients each have their own timers.\nThe shortest one wins, but all of them may keep working.",
   "originalText": "From a neighbouring note (producer note 5, section 11): the producer library, micro-batcher, circuit breaker and HTTP clients each have their own timers.\nThe shortest one wins, but all of them may keep working.",
   "fontSize": 25,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
