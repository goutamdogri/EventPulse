   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Clients that failed together follow the same rule, so they return together and spike a\nrecovering dependency. Jitter spreads each wave over an interval.",
   "originalText": "Clients that failed together follow the same rule, so they return together and spike a\nrecovering dependency. Jitter spreads each wave over an interval.",
   "fontSize": 26,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "r02507",
   "autoResize": true,
   "lineHeight": 1.25
  },
