   "versionNonce": 997271614,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A maximum COUNT and a maximum\nELAPSED TIME. Either alone is not\nenough. Whichever fires first is the real\nbound.",
   "originalText": "A maximum COUNT and a maximum\nELAPSED TIME. Either alone is not\nenough. Whichever fires first is the real\nbound.",
