   "versionNonce": 1337071037,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Without it, 1,000 clients that failed\ntogether retry together, again and\nagain. With it, retries decorrelate.",
   "originalText": "Without it, 1,000 clients that failed\ntogether retry together, again and\nagain. With it, retries decorrelate.",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
