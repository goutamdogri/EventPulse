   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "base = 100 ms. Without a cap the doubling runs away; with max = 5000 ms it becomes 'exponential, then constant'.",
   "originalText": "base = 100 ms. Without a cap the doubling runs away; with max = 5000 ms it becomes 'exponential, then constant'.",
   "fontSize": 28,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
