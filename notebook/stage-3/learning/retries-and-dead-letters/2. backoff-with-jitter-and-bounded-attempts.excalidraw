   "versionNonce": 727995389,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "delay = base * 2^(attempt-1), capped at\nmax. Quick first retries for blips, rapidly\nfalling pressure during outages.",
   "originalText": "delay = base * 2^(attempt-1), capped at\nmax. Quick first retries for blips, rapidly\nfalling pressure during outages.",
