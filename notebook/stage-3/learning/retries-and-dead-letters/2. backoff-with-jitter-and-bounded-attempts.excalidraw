   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A Kafka consumer must keep proving it is alive. A retry loop that sleeps inside the handler is STEALING time from these timers.",
   "originalText": "A Kafka consumer must keep proving it is alive. A retry loop that sleeps inside the handler is STEALING time from these timers.",
