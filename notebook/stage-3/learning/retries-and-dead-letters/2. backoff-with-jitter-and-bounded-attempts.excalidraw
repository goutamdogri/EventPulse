   "version": 1,
   "versionNonce": 199787132,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A Kafka consumer's retry loop must end before the\ngroup gives up on it. A long wait becomes a PAUSE or a\nRETRY TOPIC, not a longer sleep.",
   "originalText": "A Kafka consumer's retry loop must end before the\ngroup gives up on it. A long wait becomes a PAUSE or a\nRETRY TOPIC, not a longer sleep.",
   "fontSize": 24,
   "fontFamily": 5,
