   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The budget caps extra retry load as a share of traffic; the breaker stops all calls while\nopen. One limits amplification, the other is a shared stop signal.",
   "originalText": "The budget caps extra retry load as a share of traffic; the breaker stops all calls while\nopen. One limits amplification, the other is a shared stop signal.",
   "fontSize": 26,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "r02552",
   "autoResize": true,
   "lineHeight": 1.25
