   "roundness": null,
   "seed": 2075619515,
   "version": 1,
   "versionNonce": 261384720,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The retries in a spike fail, so the next wave is\nexactly the same size. This is the THUNDERING\nHERD (synchronised retry storm).",
   "originalText": "The retries in a spike fail, so the next wave is\nexactly the same size. This is the THUNDERING\nHERD (synchronised retry storm).",
   "fontSize": 25,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
