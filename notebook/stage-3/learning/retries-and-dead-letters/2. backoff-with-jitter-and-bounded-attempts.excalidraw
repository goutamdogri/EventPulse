   "text": "3 x 3 x 3 x 3 = 81 database calls for ONE user action when everything fails.   (Three such layers = 27.)",
   "originalText": "3 x 3 x 3 x 3 = 81 database calls for ONE user action when everything fails.   (Three such layers = 27.)",
   "fontSize": 32,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "r01572",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t01574",
   "type": "text",
   "x": 70,
   "y": 22524.25,
   "width": 1899.01,
   "height": 62.5,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
