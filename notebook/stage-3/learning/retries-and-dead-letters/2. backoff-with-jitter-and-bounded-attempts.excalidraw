   "roundness": null,
   "seed": 1276090200,
   "version": 1,
   "versionNonce": 1000044696,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each wave is a spike the database must absorb at\nthe exact moment it is starting up. Pools and\nbuckets sized for steady load fail on it.",
   "originalText": "Each wave is a spike the database must absorb at\nthe exact moment it is starting up. Pools and\nbuckets sized for steady load fail on it.",
   "fontSize": 25,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
