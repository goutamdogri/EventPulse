   "versionNonce": 1298548207,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "In a long outage each client calls less and less\noften. After 10 doublings (uncapped) the rate is\nabout 1,000 times lower.",
   "originalText": "In a long outage each client calls less and less\noften. After 10 doublings (uncapped) the rate is\nabout 1,000 times lower.",
   "fontSize": 25,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
