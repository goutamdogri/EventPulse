   "versionNonce": 374035945,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "full jitter performed best in their model of contending clients. Take it as the empirical reason jitter is the default,",
   "originalText": "full jitter performed best in their model of contending clients. Take it as the empirical reason jitter is the default,",
