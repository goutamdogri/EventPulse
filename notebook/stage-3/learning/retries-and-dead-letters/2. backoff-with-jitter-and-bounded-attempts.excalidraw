   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A timeout is relative and gets re-granted at each hop. A deadline is absolute, so total\nwaiting cannot exceed the original promise.",
   "originalText": "A timeout is relative and gets re-granted at each hop. A deadline is absolute, so total\nwaiting cannot exceed the original promise.",
