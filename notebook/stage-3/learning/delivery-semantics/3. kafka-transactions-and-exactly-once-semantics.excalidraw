      "updated": 1795621586000,
      "link": null,
      "locked": false,
      "text": "Why replication matters\n\ncoordinator broker dies\n-> another replica of that partition becomes leader\n-> replays the log, recovers the state\n-> finishes the job",
      "originalText": "Why replication matters\n\ncoordinator broker dies\n-> another replica of that partition becomes leader\n-> replays the log, recovers the state\n-> finishes the job",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "el00266",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "c04L"
    },
