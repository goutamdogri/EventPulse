      "isDeleted": false,
      "boundElements": [],
      "updated": 1795621586000,
      "link": null,
      "locked": false,
      "text": "Kafka's exactly-once guarantee covers: READS from Kafka topics (read_committed), WRITES to Kafka topics, and\nOFFSET COMMITS to Kafka. Anything the handler does to another system is outside the transaction.",
      "originalText": "Kafka's exactly-once guarantee covers: READS from Kafka topics (read_committed), WRITES to Kafka topics, and OFFSET COMMITS to Kafka. Anything the handler does to another system is outside the transaction.",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "el00997",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "c0G8"
