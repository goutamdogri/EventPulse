   "updated": 1,
   "link": null,
   "locked": false,
   "text": "3 \u00b7 Exponential backoff + jitter: base \u00d7 2^attempt + random\nStops lockstep retry storms (thundering herd).",
   "originalText": "3 \u00b7 Exponential backoff + jitter: base \u00d7 2^attempt + random\nStops lockstep retry storms (thundering herd).",
