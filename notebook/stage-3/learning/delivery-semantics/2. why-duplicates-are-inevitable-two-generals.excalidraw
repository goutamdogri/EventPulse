   "updated": 1,
   "link": null,
   "locked": false,
   "text": "5 \u00b7 Retry budget: cap retries to ~10% of normal traffic\nWhen a dependency is down, retries must not add load.",
   "originalText": "5 \u00b7 Retry budget: cap retries to ~10% of normal traffic\nWhen a dependency is down, retries must not add load.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
