   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "2 \u00b7 Retry only TRANSIENT errors (timeout, 503)\nValidation / 400 / schema errors go to the DLQ.",
   "originalText": "2 \u00b7 Retry only TRANSIENT errors (timeout, 503)\nValidation / 400 / schema errors go to the DLQ.",
