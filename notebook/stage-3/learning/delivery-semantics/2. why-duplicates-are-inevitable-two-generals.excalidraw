   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1 \u00b7 Retry only idempotent or keyed operations\nOtherwise you are manufacturing duplicates.",
   "originalText": "1 \u00b7 Retry only idempotent or keyed operations\nOtherwise you are manufacturing duplicates.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
