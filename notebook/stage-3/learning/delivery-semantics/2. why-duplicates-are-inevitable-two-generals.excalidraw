   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Retries are the only cure for loss; make them safe for the whole system, not just for one message.",
   "originalText": "Retries are the only cure for loss; make them safe for the whole system, not just for one message.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
