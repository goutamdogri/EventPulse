   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "FLP intuition: you cannot tell SLOW from DEAD.\nSo you use timeouts; so a timeout can be wrong;\nso duplicates and split-brain are possible.",
   "originalText": "FLP intuition: you cannot tell SLOW from DEAD.\nSo you use timeouts; so a timeout can be wrong;\nso duplicates and split-brain are possible.",
   "fontSize": 15,
   "fontFamily": 2,
