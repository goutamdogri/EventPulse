      "updated": 1795621586439,
      "link": null,
      "locked": false,
      "text": "It shrinks the window but blocks if the coordinator dies at the\nwrong moment: a tradeoff, not an escape.",
      "originalText": "It shrinks the window but blocks if the coordinator dies at the\nwrong moment: a tradeoff, not an escape.",
      "fontSize": 14,
      "fontFamily": 5,
