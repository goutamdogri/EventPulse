    {
      "id": "e624",
      "type": "text",
      "x": 46,
      "y": 9850,
      "width": 528,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
