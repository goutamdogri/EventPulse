      "isDeleted": false,
      "boundElements": [],
      "updated": 1795621833353,
      "link": null,
      "locked": false,
      "text": "A message delivered once can have TWO effects (a handler does two non-atomic writes and crashes between them).",
      "originalText": "A message delivered once can have TWO effects (a handler does two non-atomic writes and crashes between them).",
