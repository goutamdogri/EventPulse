      "updated": 1795621833353,
      "link": null,
      "locked": false,
      "text": "REVERSE the order (commit offset first, then DB): crash\nafter offset commit, before DB COMMIT leaves offset 'done'\nbut rows missing = LOST rows (at-most-once).",
      "originalText": "REVERSE the order (commit offset first, then DB): crash\nafter offset commit, before DB COMMIT leaves offset 'done'\nbut rows missing = LOST rows (at-most-once).",
