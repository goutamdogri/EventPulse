  {
   "id": "e627",
   "type": "text",
   "x": 626,
   "y": 9858.75,
   "width": 528,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
