   "type": "text",
   "x": 431,
   "y": 6372.0,
   "width": 338,
   "height": 87.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
