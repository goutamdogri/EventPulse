   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Messages vs effects: one message can be delivered three times and still have ONE effect (idempotent processing).",
   "originalText": "Messages vs effects: one message can be delivered three times and still have ONE effect (idempotent processing).",
   "fontSize": 16,
   "fontFamily": 2,
