   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Claim: what is promised, to whom, at which boundary\nCounted at: which of the five 'delivered' meanings\nHolds when: acks=all, min ISR=2, RF=3, commit after DB commit, PK\non event_id\nFails when: PK dropped (K5), unclean election, retention before\nconsume\nTest: SIGKILL at after-db-commit, restart, assert rows ==\ndistinct event_ids\nMetric: duplicates counter, consumer lag, DLQ count",
   "originalText": "Claim: what is promised, to whom, at which boundary\nCounted at: which of the five 'delivered' meanings\nHolds when: acks=all, min ISR=2, RF=3, commit after DB commit, PK\non event_id\nFails when: PK dropped (K5), unclean election, retention before\nconsume\nTest: SIGKILL at after-db-commit, restart, assert rows ==\ndistinct event_ids\nMetric: duplicates counter, consumer lag, DLQ count",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": false
