   "versionNonce": 211558640,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "ONE system holds both: store the\nconsumer's offset in the SAME Postgres\ntransaction as the data rows. On restart\nread the offset from Postgres, so the\npair can never disagree.",
   "originalText": "ONE system holds both: store the\nconsumer's offset in the SAME Postgres\ntransaction as the data rows. On restart\nread the offset from Postgres, so the\npair can never disagree.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": false
  },
  {
