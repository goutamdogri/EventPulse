   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "INSERT INTO device_state (device_id, value, version)\nVALUES ($1, $2, $3)\nON CONFLICT (device_id) DO UPDATE\n   SET value = EXCLUDED.value,\n       version = EXCLUDED.version\n WHERE device_state.version < EXCLUDED.version;",
   "originalText": "INSERT INTO device_state (device_id, value, version)\nVALUES ($1, $2, $3)\nON CONFLICT (device_id) DO UPDATE\n   SET value = EXCLUDED.value,\n       version = EXCLUDED.version\n WHERE device_state.version < EXCLUDED.version;",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
