   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "It does NOT require:\nthat the message arrives only once\nthat the consumer never crashes\nthat the consumer never re-reads",
   "originalText": "It does NOT require:\nthat the message arrives only once\nthat the consumer never crashes\nthat the consumer never re-reads",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec_00598",
   "autoResize": true,
   "lineHeight": 1.25
  },
