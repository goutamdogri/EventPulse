   "text": "BEGIN;\nINSERT INTO inbox (message_id) VALUES ($1);\n   -- PRIMARY KEY (message_id)\n   -- conflict? ROLLBACK / skip: already applied\nUPDATE accounts\n   SET balance = balance + $2 WHERE id = $3;\nCOMMIT;",
