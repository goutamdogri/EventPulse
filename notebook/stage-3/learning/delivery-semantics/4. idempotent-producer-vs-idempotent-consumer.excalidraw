   "locked": false,
   "text": "3. Key is minted at the ORIGIN,\n   before the first attempt, and\n   NEVER changes (retries, DLQ,\n   replays).",
   "originalText": "3. Key is minted at the ORIGIN,\n   before the first attempt, and\n   NEVER changes (retries, DLQ,\n   replays).",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec_01985",
   "autoResize": true,
   "lineHeight": 1.25
  },
