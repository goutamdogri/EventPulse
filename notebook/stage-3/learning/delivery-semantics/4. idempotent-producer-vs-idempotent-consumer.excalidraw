   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "1. Created at the ORIGIN, ONCE: by the client (or\n   first accepting service), before the first attempt;\n   every retry reuses it",
   "originalText": "1. Created at the ORIGIN, ONCE: by the client (or\n   first accepting service), before the first attempt;\n   every retry reuses it",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec_01354",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rec_01356",
