   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "A transactional producer CONTAINS the idempotent producer. The idempotent consumer is a separate axis: it lives in the destination.",
   "originalText": "A transactional producer CONTAINS the idempotent producer. The idempotent consumer is a separate axis: it lives in the destination.",
   "fontSize": 22,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
