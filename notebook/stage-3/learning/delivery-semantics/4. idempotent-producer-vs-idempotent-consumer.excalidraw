   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "2. NOT derived from anything that changes across\n   retries: Kafka offset, timestamp, random id minted\n   inside the consumer",
   "originalText": "2. NOT derived from anything that changes across\n   retries: Kafka offset, timestamp, random id minted\n   inside the consumer",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec_01356",
   "autoResize": true,
   "lineHeight": 1.25
  },
