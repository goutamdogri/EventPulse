   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "The idempotent producer covers exactly one thing: the SAME producer\nsession resending the SAME batch to the SAME partition.\n\nAnything that creates a NEW send, or happens on the CONSUMER side, is\ninvisible to it.",
   "originalText": "The idempotent producer covers exactly one thing: the SAME producer\nsession resending the SAME batch to the SAME partition.\n\nAnything that creates a NEW send, or happens on the CONSUMER side, is\ninvisible to it.",
