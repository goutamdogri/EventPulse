   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "\"Retries performed by the producer client for a given PID and partition do not create duplicate records in that partition's log, for the lifetime of\nthat PID, and records of that PID are appended in the order sent.\"",
   "originalText": "\"Retries performed by the producer client for a given PID and partition do not create duplicate records in that partition's log, for the lifetime of\nthat PID, and records of that PID are appended in the order sent.\"",
