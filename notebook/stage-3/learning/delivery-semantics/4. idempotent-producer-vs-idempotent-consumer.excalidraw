   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "GOLDEN RULE: each earlier layer may fail without breaking correctness, as long as the LAST layer holds.",
   "originalText": "GOLDEN RULE: each earlier layer may fail without breaking correctness, as long as the LAST layer holds.",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec_01467",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rec_01469",
