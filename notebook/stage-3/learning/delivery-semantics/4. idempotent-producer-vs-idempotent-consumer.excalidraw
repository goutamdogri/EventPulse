   "text": "1. Producer idempotence handles\n   LIBRARY retries in ONE session.\n   Nothing more.",
   "originalText": "1. Producer idempotence handles\n   LIBRARY retries in ONE session.\n   Nothing more.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec_01981",
   "autoResize": true,
   "lineHeight": 1.25
  },
