   "versionNonce": 427168290,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "Corollary: remove L4 (the K5 experiment does this on purpose with a copy\nof the table without a primary key) and the system is wrong in proportion\nto how often L1-L3 leak. It demonstrates the claim from the other side.",
   "originalText": "Corollary: remove L4 (the K5 experiment does this on purpose with a copy\nof the table without a primary key) and the system is wrong in proportion\nto how often L1-L3 leak. It demonstrates the claim from the other side.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec_01469",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "rec_01471",
