   "roundness": null,
   "seed": 173641792,
   "version": 1,
   "versionNonce": 1793093593,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1795600000000,
   "link": null,
   "locked": false,
   "text": "If L4 cannot be a unique constraint (append-only store, search index,\nAPI): use the destination's own idempotency (idempotency-key header,\ndeterministic document id), or keep an inbox. Record + send are two\nsystems, so prefer \"send with a deterministic id\" over \"record then send\".",
   "originalText": "If L4 cannot be a unique constraint (append-only store, search index,\nAPI): use the destination's own idempotency (idempotency-key header,\ndeterministic document id), or keep an inbox. Record + send are two\nsystems, so prefer \"send with a deterministic id\" over \"record then send\".",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "rec_01471",
   "autoResize": true,
   "lineHeight": 1.25
  },
