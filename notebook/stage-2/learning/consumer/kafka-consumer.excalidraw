			"frameId": null,
			"index": "bTy",
			"roundness": null,
			"seed": 344065792,
			"version": 429,
			"versionNonce": 1606265732,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795614751286,
			"link": null,
			"locked": false,
			"text": "Stage 1: API wrote to Postgres directly -> slow DB = slow API -> 503s.\nStage 2: backpressure STOPS at Kafka: ingestion keeps its latency, lag grows.\nThe real limit is retention (24 h): a backlog older than that is deleted.\nSo alert on lag AGE against retention.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "HLh34R2VyPzPOOHhiKx4a",
			"originalText": "Stage 1: API wrote to Postgres directly -> slow DB = slow API -> 503s.\nStage 2: backpressure STOPS at Kafka: ingestion keeps its latency, lag grows.\nThe real limit is retention (24 h): a backlog older than that is deleted.\nSo alert on lag AGE against retention.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795607512383,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
