			"text": "EAGER: everyone stops,\nthen rejoins.\nCOOPERATIVE: only the\nmoved partitions stop.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "tXnc0YRHehvCyooowiaHv",
			"originalText": "EAGER: everyone stops,\nthen rejoins.\nCOOPERATIVE: only the\nmoved partitions stop.",
