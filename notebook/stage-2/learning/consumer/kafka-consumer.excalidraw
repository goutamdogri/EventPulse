			"isDeleted": false,
			"boundElements": [],
			"updated": 1795614751286,
			"link": null,
			"locked": false,
			"text": "buffered bytes <= (partitions x max.partition.fetch.bytes)   [fetch buffers]\n + (1.5 s x rate x record size)   [client cache]\n + (max batch x record size) x concurrency   [current batch]\nExample: 6 MiB + 4.5 MB + 0.6 MB = about 10 MB (illustrative, measure it)",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "VrsuEp1_nVE84l1k0rue1",
			"originalText": "buffered bytes <= (partitions x max.partition.fetch.bytes)   [fetch buffers]\n + (1.5 s x rate x record size)   [client cache]\n + (max batch x record size) x concurrency   [current batch]\nExample: 6 MiB + 4.5 MB + 0.6 MB = about 10 MB (illustrative, measure it)",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795607512381,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
