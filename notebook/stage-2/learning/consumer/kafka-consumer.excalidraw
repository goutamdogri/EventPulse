		{
			"id": "sPNABBPw",
			"type": "text",
			"x": 10748.665543097906,
			"y": 9945.611631147827,
			"width": 694.8675537109375,
			"height": 90,
			"angle": 0,
			"strokeColor": "#22c55e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
