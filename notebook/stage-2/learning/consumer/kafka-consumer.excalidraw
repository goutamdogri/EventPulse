			"text": "Mechanism: await in handler,\nbounded prefetch,\npause / resume\nCallers see: nothing\nShows as: consumer LAG\nand freshness",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "e_LOv3zfZq-MsuPrPer9N",
