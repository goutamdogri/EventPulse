			"updated": 1795614745115,
			"link": null,
			"locked": false,
			"text": "EventPulse = A + INSERT ... ON CONFLICT (event_id) DO NOTHING\nDelivery at-least-once, EFFECT on the table exactly-once\nEarly commit = lost events · late commit = a few repeats",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "jNTtBIizf0pR6Kb2jzw_Z",
			"originalText": "EventPulse = A + INSERT ... ON CONFLICT (event_id) DO NOTHING\nDelivery at-least-once, EFFECT on the table exactly-once\nEarly commit = lost events · late commit = a few repeats",
