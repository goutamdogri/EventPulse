			"updated": 1795614751286,
			"link": null,
			"locked": false,
			"text": "Caution (verify): maxBytesPerPartition -> max.partition.fetch.bytes, then\nmaxBytes -> fetch.message.max.bytes. librdkafka treats them as aliases,\nso the later one (10 MiB) may override the 1 MiB. Log the effective config.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "sfYK2TeV1AWaPRD_o8l8D",
			"originalText": "Caution (verify): maxBytesPerPartition -> max.partition.fetch.bytes, then\nmaxBytes -> fetch.message.max.bytes. librdkafka treats them as aliases,\nso the later one (10 MiB) may override the 1 MiB. Log the effective config.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795607512381,
