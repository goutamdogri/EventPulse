			"updated": 1795614751286,
			"link": null,
			"locked": false,
			"text": "DANGER: js.consumer.max.batch.size = -1 (unlimited) makes the cache UNBOUNDED. Never use it.\nAlso: the cache is bounded in time, not bytes. Huge records = big memory. Size by record size.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "XOIVH16jfMJYAf3SQBie8",
			"originalText": "DANGER: js.consumer.max.batch.size = -1 (unlimited) makes the cache UNBOUNDED. Never use it.\nAlso: the cache is bounded in time, not bytes. Huge records = big memory. Size by record size.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795607512381,
			"labelPosition": null,
			"baseFontSize": null,
