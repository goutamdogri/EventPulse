			"updated": 1795616866842,
			"link": null,
			"locked": false,
			"text": "One broker failing triggers an independent leader election for EACH partition it led, so partition count affects failover time.",
			"fontSize": 16,
			"fontFamily": 1,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "k710",
			"originalText": "One broker failing triggers an independent leader election for EACH partition it led, so partition count affects failover time.",
