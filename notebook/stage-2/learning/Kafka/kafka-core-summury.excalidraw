			"boundElements": [],
			"updated": 1795616866842,
			"link": null,
			"locked": false,
			"text": "One slow or down leader stalls the whole send()\nso the batcher rule \"one send = one outcome\" is\nhonest, but a rejected send may be PARTLY written\n(a known Stage 2 flaw for the ledger)",
			"fontSize": 18,
			"fontFamily": 1,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "k438",
			"originalText": "One slow or down leader stalls the whole send()\nso the batcher rule \"one send = one outcome\" is\nhonest, but a rejected send may be PARTLY written\n(a known Stage 2 flaw for the ledger)",
			"autoResize": true,
			"lineHeight": 1.25,
