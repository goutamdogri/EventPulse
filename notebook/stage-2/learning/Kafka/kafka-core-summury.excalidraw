			"updated": 1795616866842,
			"link": null,
			"locked": false,
			"text": "Retention = your recovery window\n24 h of replay: rewind the group, reprocess.\nAfter that Postgres is the only copy.\nThe DLQ keeps 7 days for human inspection.",
			"fontSize": 16,
			"fontFamily": 1,
			"textAlign": "center",
			"verticalAlign": "middle",
