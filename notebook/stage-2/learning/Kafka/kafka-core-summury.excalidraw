			"x": 3696.7597180000002,
			"y": 8390.173725,
			"width": 700,
			"height": 100,
			"angle": 0,
			"strokeColor": "#f59e0b",
			"backgroundColor": "#ffd8a8",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
