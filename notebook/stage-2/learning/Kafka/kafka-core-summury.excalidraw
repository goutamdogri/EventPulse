			"updated": 1795749432444,
			"link": null,
			"locked": false,
			"text": "No key? Records are spread for balance (sticky or random) with no ordering promise.\nEventPulse always sets a key.",
			"fontSize": 16,
			"fontFamily": 1,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "k548",
			"originalText": "No key? Records are spread for balance (sticky or random) with no ordering promise.\nEventPulse always sets a key.",
