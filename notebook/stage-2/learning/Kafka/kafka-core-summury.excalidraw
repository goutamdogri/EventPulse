		{
			"type": "text",
			"id": "k680t",
			"x": 3808.6471996894534,
			"y": 8245.173725,
			"width": 476.22503662109375,
			"height": 80,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [
				"0sZaXyNOTtGD3A1yZ-GC8",
				"VouTvTO5uuitvkSYuu_lh"
			],
			"frameId": null,
			"roundness": null,
			"seed": 4741,
			"version": 56,
			"versionNonce": 2043045587,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795616866842,
			"link": null,
			"locked": false,
			"text": "Sizing rule of thumb (measure, then compute)\npartitions >= max( t / p , t / c ) + headroom\np = one producer into ONE partition, c = one consumer\nfrom ONE partition (your Postgres batch write), t = target",
			"fontSize": 16,
			"fontFamily": 1,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "k680",
			"originalText": "Sizing rule of thumb (measure, then compute)\npartitions >= max( t / p , t / c ) + headroom\np = one producer into ONE partition, c = one consumer\nfrom ONE partition (your Postgres batch write), t = target",
			"autoResize": true,
			"lineHeight": 1.25,
			"index": "c1CF",
			"created": null,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
		{
