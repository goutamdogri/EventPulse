			"isDeleted": false,
			"boundElements": [],
			"updated": 1795616866842,
			"link": null,
			"locked": false,
			"text": "More partitions = smaller batches at the same rate\n500 msgs: 6 partitions ~83 per batch,\n60 partitions ~8 per batch\n-> worse compression, more requests (K1/K2)",
			"fontSize": 18,
			"fontFamily": 1,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "k437",
			"originalText": "More partitions = smaller batches at the same rate\n500 msgs: 6 partitions ~83 per batch,\n60 partitions ~8 per batch\n-> worse compression, more requests (K1/K2)",
			"autoResize": true,
			"lineHeight": 1.25,
			"index": "c15n",
			"created": null,
			"labelPosition": null,
			"baseFontSize": null,
