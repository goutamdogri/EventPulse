			"link": null,
			"locked": false,
			"text": "Why it matters to EventPulse\nConsumer down longer than retention loses\nunread data: its offset falls below the log start\noffset, then auto.offset.reset decides (K11, audit H)",
			"fontSize": 16,
			"fontFamily": 1,
			"textAlign": "center",
			"verticalAlign": "middle",
