		{
			"type": "text",
			"id": "k681t",
			"x": 3816.2792797675784,
			"y": 8410.173725,
			"width": 460.96087646484375,
			"height": 60,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [
				"0sZaXyNOTtGD3A1yZ-GC8",
				"VouTvTO5uuitvkSYuu_lh"
			],
			"frameId": null,
			"roundness": null,
			"seed": 4748,
			"version": 56,
			"versionNonce": 941821459,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795616866842,
			"link": null,
			"locked": false,
			"text": "For EventPulse the SINK decides the count (c is smaller),\nnot Kafka. Past the DB limit, more partitions only move\nthe queue into Postgres connections (PG_POOL_MAX).",
			"fontSize": 16,
			"fontFamily": 1,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "k681",
			"originalText": "For EventPulse the SINK decides the count (c is smaller),\nnot Kafka. Past the DB limit, more partitions only move\nthe queue into Postgres connections (PG_POOL_MAX).",
			"autoResize": true,
			"lineHeight": 1.25,
			"index": "c1CH",
			"created": null,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
