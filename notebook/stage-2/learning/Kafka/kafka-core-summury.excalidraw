			"updated": 1795616866842,
			"link": null,
			"locked": false,
			"text": "send() resolves only when\nALL partitions in it are\nacknowledged\n= one outcome for all waiters",
			"fontSize": 18,
			"fontFamily": 1,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "k436",
			"originalText": "send() resolves only when\nALL partitions in it are\nacknowledged\n= one outcome for all waiters",
