			"updated": 1795749432444,
			"link": null,
			"locked": false,
			"text": "Why this combination: no write is accepted with fewer than 2 copies, one broker can die with no loss and no downtime,\nand an offline partition is preferred over electing a stale replica that lost acknowledged writes.",
			"fontSize": 16,
			"fontFamily": 1,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "k709",
			"originalText": "Why this combination: no write is accepted with fewer than 2 copies, one broker can die with no loss and no downtime,\nand an offline partition is preferred over electing a stale replica that lost acknowledged writes.",
			"autoResize": true,
			"lineHeight": 1.25,
			"index": "c1D5",
			"created": null,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
