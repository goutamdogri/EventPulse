			"seed": 4755,
			"version": 56,
			"versionNonce": 577693011,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795616866842,
			"link": null,
			"locked": false,
			"text": "Cost of too many partitions: file handles and memory,\nreplication work, slower failover (one election each),\nsmaller producer batches, more rebalance churn",
			"fontSize": 16,
			"fontFamily": 1,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "k682",
			"originalText": "Cost of too many partitions: file handles and memory,\nreplication work, slower failover (one election each),\nsmaller producer batches, more rebalance churn",
			"autoResize": true,
			"lineHeight": 1.25,
			"index": "c1CJ",
			"created": null,
			"labelPosition": null,
			"baseFontSize": null,
