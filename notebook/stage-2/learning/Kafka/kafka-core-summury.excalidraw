			"link": null,
			"locked": false,
			"text": "DLQ headers dlq.original_partition + dlq.original_offset carry exactly this triple, so a poisoned record is always findable.",
			"fontSize": 16,
			"fontFamily": 1,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "k170",
			"originalText": "DLQ headers dlq.original_partition + dlq.original_offset carry exactly this triple, so a poisoned record is always findable.",
