			"link": null,
			"locked": false,
			"text": "Offsets may have gaps (transaction markers,\ncompaction). Never assume offset == count.\nEventPulse: contiguous, so end - start is a fair count.",
			"fontSize": 16,
			"fontFamily": 1,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "k171",
			"originalText": "Offsets may have gaps (transaction markers,\ncompaction). Never assume offset == count.\nEventPulse: contiguous, so end - start is a fair count.",
