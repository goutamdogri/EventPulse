			"link": null,
			"locked": false,
			"text": "Hashing is random-ish: few keys on few partitions = lumpy distribution. Not a bug.",
			"fontSize": 18,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Hashing is random-ish: few keys on few partitions = lumpy distribution. Not a bug.",
