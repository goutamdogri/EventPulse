			"updated": 1795616866841,
			"link": null,
			"locked": false,
			"text": "Key and value are opaque bytes.\nKafka happily stores \"not json\".\nThat is why poison messages\nexist: the consumer finds the\nproblem later (Step 4).",
			"fontSize": 18,
			"fontFamily": 1,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "k242",
			"originalText": "Key and value are opaque bytes.\nKafka happily stores \"not json\".\nThat is why poison messages\nexist: the consumer finds the\nproblem later (Step 4).",
