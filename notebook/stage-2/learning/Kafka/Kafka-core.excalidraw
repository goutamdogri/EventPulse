			"updated": 1795739525649,
			"link": null,
			"locked": false,
			"text": "A consumer reading both\npartitions may see B1 before A1:\nno defined order across partitions.\nA1, A2, A3 always arrive in order.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
