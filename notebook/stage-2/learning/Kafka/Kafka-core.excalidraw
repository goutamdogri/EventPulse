			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739525645,
			"link": null,
			"locked": false,
			"text": "Consumers cannot read past the high watermark: only records every ISR replica has are visible,\nso a consumer never sees data that could vanish in a leader change.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "wk3",
			"originalText": "Consumers cannot read past the high watermark: only records every ISR replica has are visible,\nso a consumer never sees data that could vanish in a leader change.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"labelPosition": null,
