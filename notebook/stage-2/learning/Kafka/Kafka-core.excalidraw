			"boundElements": [],
			"updated": 1795739525675,
			"link": null,
			"locked": false,
			"text": "Design the margin\nPick retention.ms so the longest outage you want to survive fits with room to spare\n(24 h is a reasonable floor, 72 h is comfortable).\nKeep auto.offset.reset=earliest so a fall-behind processes everything that remains.\nConsider 'none' for production-like runs: a loud failure beats a silent one.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "xYwTRUGTWL12Rxs3OQy4S",
			"originalText": "Design the margin\nPick retention.ms so the longest outage you want to survive fits with room to spare\n(24 h is a reasonable floor, 72 h is comfortable).\nKeep auto.offset.reset=earliest so a fall-behind processes everything that remains.\nConsider 'none' for production-like runs: a loud failure beats a silent one.",
			"autoResize": true,
