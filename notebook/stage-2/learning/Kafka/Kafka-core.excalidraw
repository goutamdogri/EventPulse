			"updated": 1795739608537,
			"link": null,
			"locked": false,
			"text": "Use when: small to medium volume,\nlow latency, short-lived signals, or\nyou already run Redis.",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "HyLnB8bRsHmLTqaPe3ufI",
			"originalText": "Use when: small to medium volume,\nlow latency, short-lived signals, or\nyou already run Redis.",
