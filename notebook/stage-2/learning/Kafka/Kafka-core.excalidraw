			"seed": 319682143,
			"version": 201,
			"versionNonce": 2024356289,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739525674,
			"link": null,
			"locked": false,
			"text": "EventPulse: the Kafka record timestamp is the SEND time (stamped by the client library)\n[reasoning] confirm by reading one record's CreateTime once.\nDo NOT set it from occurred_at: an event from last month would be deleted almost at once,\nand one dated 2100 would pin storage.\noccurred_at and received_at are envelope fields, not the Kafka record timestamp.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "y_DO5K0QtEyYwFMN72dUz",
			"originalText": "EventPulse: the Kafka record timestamp is the SEND time (stamped by the client library)\n[reasoning] confirm by reading one record's CreateTime once.\nDo NOT set it from occurred_at: an event from last month would be deleted almost at once,\nand one dated 2100 would pin storage.\noccurred_at and received_at are envelope fields, not the Kafka record timestamp.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795577829169,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
