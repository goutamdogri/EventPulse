			"text": "Pros: easy fan-out, nothing to run,\nscales automatically, pay as you go",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "y9yHd1v7k7FfA-XB4GO45",
