			"updated": 1795739525658,
			"link": null,
			"locked": false,
			"text": "lag(partition) = log end offset − committed offset      total lag = sum over partitions\nexample: partition 3 has lag 50,000, the other five have lag 0",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "N_1RztuotyAwi6peluXuQ",
