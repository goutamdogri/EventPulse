			"updated": 1795739525652,
			"link": null,
			"locked": false,
			"text": "A group's parallelism is capped at the partition count: extra consumers get nothing until a member leaves",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "cnote",
			"originalText": "A group's parallelism is capped at the partition count: extra consumers get nothing until a member leaves",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
