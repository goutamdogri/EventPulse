			"type": "text",
			"x": 15766.007703232057,
			"y": 5676.148436676635,
			"width": 821.082763671875,
			"height": 112.5,
			"angle": 0,
			"strokeColor": "#4a9eed",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
