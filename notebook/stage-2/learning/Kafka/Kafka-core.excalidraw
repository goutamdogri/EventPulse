			"updated": 1795739525650,
			"link": null,
			"locked": false,
			"text": "Same key = same partition = totally ordered. EventPulse key = tenant_id: each tenant's events are ordered,\ndifferent tenants are not ordered relative to each other (fine). KAFKA_KEY_MODE=event: even spread, no ordering (K9).",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "ok",
			"originalText": "Same key = same partition = totally ordered. EventPulse key = tenant_id: each tenant's events are ordered,\ndifferent tenants are not ordered relative to each other (fine). KAFKA_KEY_MODE=event: even spread, no ordering (K9).",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
