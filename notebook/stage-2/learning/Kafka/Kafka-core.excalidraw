			"link": null,
			"locked": false,
			"text": "Duplicates are safe: INSERT … ON CONFLICT\n(event_id) DO NOTHING absorbs the redo window.\nThey are counted, not hidden.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "_hLEgvVA4IzPiB5nrsqKS",
