			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739525658,
			"link": null,
			"locked": false,
			"text": "One partition growing while the others sit at 0 = stuck partition (poison message),\na hot key, or a stalled consumer. Total lag hides this: watch per-partition lag.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "JmMnNm0SU02vQlwQBuPCn",
			"originalText": "One partition growing while the others sit at 0 = stuck partition (poison message),\na hot key, or a stalled consumer. Total lag hides this: watch per-partition lag.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795572381908,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
