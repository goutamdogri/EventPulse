			"updated": 1795739525663,
			"link": null,
			"locked": false,
			"text": "Cheat sheet\nhigh watermark = min(LEO of ISR)\nno-loss failures = min ISR - 1\nwrite-available failures = RF - min ISR\nEventPulse: 1 and 1",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "LHrJMEFkk-mkJY2CGqR8d",
			"originalText": "Cheat sheet\nhigh watermark = min(LEO of ISR)\nno-loss failures = min ISR - 1\nwrite-available failures = RF - min ISR\nEventPulse: 1 and 1",
