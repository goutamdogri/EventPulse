			"boundElements": [],
			"updated": 1795739525659,
			"link": null,
			"locked": false,
			"text": "One-line version\nacks says WHO must say yes.\nmin.insync.replicas says HOW MANY must exist to ask.\nThe ISR is WHO is currently allowed to say yes.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "6te_bh092rNafHSAe47pQ",
			"originalText": "One-line version\nacks says WHO must say yes.\nmin.insync.replicas says HOW MANY must exist to ask.\nThe ISR is WHO is currently allowed to say yes.",
