			"updated": 1795739525661,
			"link": null,
			"locked": false,
			"text": "Surprise [run]: min ISR 4 on an RF 3 topic did NOT make acks=all fail. Refusal needs an ISR that is really smaller.\n__consumer_offsets also has min ISR 2: with its ISR < 2, consumers cannot commit offsets.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "g94Tw3zrxM80rIPZcNTpv",
			"originalText": "Surprise [run]: min ISR 4 on an RF 3 topic did NOT make acks=all fail. Refusal needs an ISR that is really smaller.\n__consumer_offsets also has min ISR 2: with its ISR < 2, consumers cannot commit offsets.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795574401631,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
