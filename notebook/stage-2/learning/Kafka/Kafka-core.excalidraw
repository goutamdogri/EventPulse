				"SWVpMm-l29RHxflmwHbRL"
			],
			"frameId": null,
			"roundness": null,
			"seed": 1559508287,
			"version": 428,
			"versionNonce": 2125204481,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739525667,
			"link": null,
			"locked": false,
			"text": "• Preferred leader = the FIRST replica in the partition's replica\nlist.\n• Automatic: auto.leader.rebalance.enable=true; the controller\nchecks every 300 s (leader.imbalance.check.interval.seconds).\n• It moves leadership back if a broker leads more than it should\nby more than leader.imbalance.per.broker.percentage (default 10)\n[reasoning].\n• By hand: kafka-leader-election.sh --election-type preferred",
			"originalText": "• Preferred leader = the FIRST replica in the partition's replica\nlist.\n• Automatic: auto.leader.rebalance.enable=true; the controller\nchecks every 300 s (leader.imbalance.check.interval.seconds).\n• It moves leadership back if a broker leads more than it should\nby more than leader.imbalance.per.broker.percentage (default 10)\n[reasoning].\n• By hand: kafka-leader-election.sh --election-type preferred",
			"fontSize": 18,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "0EblB0E_NALUZId-hHCmb",
			"autoResize": true,
			"lineHeight": 1.25,
