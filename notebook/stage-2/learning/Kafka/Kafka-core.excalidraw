			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739608537,
			"link": null,
			"locked": false,
			"text": "Cons: capacity limited by memory;\npub/sub stores nothing, so a down\nsubscriber misses messages; durability\ndepends on persistence settings;\none stream lives on one node",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "bnUCauVz_L-WOwGSwPj0k",
			"originalText": "Cons: capacity limited by memory;\npub/sub stores nothing, so a down\nsubscriber misses messages; durability\ndepends on persistence settings;\none stream lives on one node",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795406001443,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
