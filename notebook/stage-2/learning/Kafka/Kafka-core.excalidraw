			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739525661,
			"link": null,
			"locked": false,
			"text": "min.insync.replicas = a FLOOR on ISR size\nfor acks=all writes. It does NOT mean\n'write to N replicas'. No effect on acks=1\nor acks=0. Ours: 2 (broker and topic).",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "DzaKYTLfXrJERpX_SyOiS",
			"originalText": "min.insync.replicas = a FLOOR on ISR size\nfor acks=all writes. It does NOT mean\n'write to N replicas'. No effect on acks=1\nor acks=0. Ours: 2 (broker and topic).",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795574401631,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
