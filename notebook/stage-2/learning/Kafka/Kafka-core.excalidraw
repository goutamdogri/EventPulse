		{
			"id": "kkgkG14n",
			"type": "text",
			"x": 1246.813204367953,
			"y": 9225.931472261034,
			"width": 411.54937744140625,
			"height": 247.5,
			"angle": 0,
			"strokeColor": "#f59e0b",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [
				"X1Laa02pa_2ICVcChQM2x"
			],
			"frameId": null,
			"index": "bapvd",
			"roundness": null,
			"seed": 1635093843,
			"version": 558,
			"versionNonce": 1806685249,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739525648,
			"link": null,
			"locked": false,
			"text": "Normally, sending a file over the network\ncopies the data several times. It goes from\ndisk into the operating system's memory, then\ninto the program's memory, then back to the\noperating system, then out to the network\ncard.\n\nZero copy skips the middle steps. The\noperating system sends the file bytes straight\nfrom disk to the network. The program never\ntouches them.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "Jq8rTDhy5iCFuIOiha_K2",
			"originalText": "Normally, sending a file over the network\ncopies the data several times. It goes from\ndisk into the operating system's memory, then\ninto the program's memory, then back to the\noperating system, then out to the network\ncard.\n\nZero copy skips the middle steps. The\noperating system sends the file bytes straight\nfrom disk to the network. The program never\ntouches them.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795501289837,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
