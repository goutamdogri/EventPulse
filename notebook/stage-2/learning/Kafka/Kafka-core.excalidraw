			"updated": 1795739608537,
			"link": null,
			"locked": false,
			"text": "INVERT the responsibility. Do not make the broker track and delete messages.\nKeep the data in an append-only log and let every reader remember its own position.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "snyPqfR0HFSGZMszk7s55",
