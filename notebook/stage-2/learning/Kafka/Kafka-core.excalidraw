			"updated": 1795739525643,
			"link": null,
			"locked": false,
			"text": "max.message.bytes (1048588) limits a whole batch after\ncompression, not one record; a bigger batch is rejected\nwhole. BATCH_MAX_BYTES ~900 KB and BODY_LIMIT 64 KB\nsit below.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "bn3",
			"originalText": "max.message.bytes (1048588) limits a whole batch after\ncompression, not one record; a bigger batch is rejected\nwhole. BATCH_MAX_BYTES ~900 KB and BODY_LIMIT 64 KB\nsit below.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
