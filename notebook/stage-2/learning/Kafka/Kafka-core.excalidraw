			"boundElements": [],
			"updated": 1795739525646,
			"link": null,
			"locked": false,
			"text": "More partitions = smaller batches at the same rate\n500 msgs / 6 partitions = ~83 per batch,\n/ 60 partitions = ~8 per batch.\nWorse compression, more requests.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "sc2",
			"originalText": "More partitions = smaller batches at the same rate\n500 msgs / 6 partitions = ~83 per batch,\n/ 60 partitions = ~8 per batch.\nWorse compression, more requests.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
