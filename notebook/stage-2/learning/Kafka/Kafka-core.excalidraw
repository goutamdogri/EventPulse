			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739525673,
			"link": null,
			"locked": false,
			"text": "The newest record decides: one recent record keeps all its older neighbours alive.\nRolled segments become candidates. That is why deletion is coarse and late.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "vLnNz-alNwMPu1Aid7YVs",
			"originalText": "The newest record decides: one recent record keeps all its older neighbours alive.\nRolled segments become candidates. That is why deletion is coarse and late.",
