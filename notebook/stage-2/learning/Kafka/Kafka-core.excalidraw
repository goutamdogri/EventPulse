			"link": null,
			"locked": false,
			"text": "Cons: a copy per subscription, not one\nshared log; replay and ordering are\nlimited or cost extra; vendor lock-in;\nless control over throughput and\npartitioning",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "center",
