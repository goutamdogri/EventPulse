			"updated": 1795739608537,
			"link": null,
			"locked": false,
			"text": "Pros: very low latency, very simple,\noften already in the stack; Streams\nadd groups and some replay",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "f6FpL_glM-h-EsrqmT4l6",
			"originalText": "Pros: very low latency, very simple,\noften already in the stack; Streams\nadd groups and some replay",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795406001443,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
