			"updated": 1795739608537,
			"link": null,
			"locked": false,
			"text": "Retention is cheap\n\nDelete by age or size,\nnot by 'who has read\nit yet'.",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "RLqGvDoSw97lwhighUPhb",
			"originalText": "Retention is cheap\n\nDelete by age or size,\nnot by 'who has read\nit yet'.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795406001445,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
