			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739608537,
			"link": null,
			"locked": false,
			"text": "How to read it: there is no perfect row among A to G.\nA and D give up durability. B and C give up speed or fan-out.\nE gives durability and buffering but deletes data after reading: no replay, no shared history.\nF is fast but memory-bound. G fans out but copies per subscriber. Only row H ticks every box.",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "coV-R_ypp0XXFBvWdCy7D",
			"originalText": "How to read it: there is no perfect row among A to G.\nA and D give up durability. B and C give up speed or fan-out.\nE gives durability and buffering but deletes data after reading: no replay, no shared history.\nF is fast but memory-bound. G fans out but copies per subscriber. Only row H ticks every box.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795406001444,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
