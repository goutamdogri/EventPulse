			"updated": 1795739608536,
			"link": null,
			"locked": false,
			"text": "Without a buffer the system must keep up at every\ninstant. Anything above capacity is rejected (503)\nor lost. Nobody gets it later.",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "h7ImXVC_JI21xEs0_E1HN",
