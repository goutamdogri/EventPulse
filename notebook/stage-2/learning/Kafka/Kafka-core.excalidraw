			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739525645,
			"link": null,
			"locked": false,
			"text": "Append-only, sequential I/O\nappending to the end of a file is the\nfastest thing a disk and the OS can do:\nthe main reason Kafka is fast.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "wk1",
			"originalText": "Append-only, sequential I/O\nappending to the end of a file is the\nfastest thing a disk and the OS can do:\nthe main reason Kafka is fast.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
