			"seed": 987659989,
			"version": 22,
			"versionNonce": 693132801,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739525645,
			"link": null,
			"locked": false,
			"text": "No fsync per message by default\nwrites go to the OS page cache; durability comes\nfrom replication, not fsync. With acks=all and\nmin ISR 2: in the memory of 2 brokers.\n(Postgres COMMIT waits for a WAL fsync.)",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "wk2",
			"originalText": "No fsync per message by default\nwrites go to the OS page cache; durability comes\nfrom replication, not fsync. With acks=all and\nmin ISR 2: in the memory of 2 brokers.\n(Postgres COMMIT waits for a WAL fsync.)",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
