			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739525676,
			"link": null,
			"locked": false,
			"text": "data lifetime   >= retention.ms (up to + time the segment is open + 5 min + 1 min)\ndisk per broker ~ rate x retention x RF / brokers (+ 20 to 30 percent headroom)\nfall-behind     =  oldest unread record older than retention.ms (alert at a fraction of it)",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "5-TLQ7asmrISQObjnvS7f",
			"originalText": "data lifetime   >= retention.ms (up to + time the segment is open + 5 min + 1 min)\ndisk per broker ~ rate x retention x RF / brokers (+ 20 to 30 percent headroom)\nfall-behind     =  oldest unread record older than retention.ms (alert at a fraction of it)",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795577829171,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
