			"updated": 1795739525652,
			"link": null,
			"locked": false,
			"text": "Before: partition = hash(key) mod 3\nAfter:  partition = hash(key) mod 6\nthe same key may now map to\na different partition",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "rf1",
			"originalText": "Before: partition = hash(key) mod 3\nAfter:  partition = hash(key) mod 6\nthe same key may now map to\na different partition",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
