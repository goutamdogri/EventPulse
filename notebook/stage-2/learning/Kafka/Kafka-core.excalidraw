			"versionNonce": 1734607265,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739525667,
			"link": null,
			"locked": false,
			"text": "Duplicates across an election only happen if the producer is NOT idempotent, or the retry is at application level (a new\nsend()).",
			"originalText": "Duplicates across an election only happen if the producer is NOT idempotent, or the retry is at application level (a new\nsend()).",
