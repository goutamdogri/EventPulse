			"updated": 1795739608537,
			"link": null,
			"locked": false,
			"text": "Writes are fast\n\nOnly sequential appends,\nno per-message\nbookkeeping.",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "aKQd-sDVvzQOJuHt5gdH1",
			"originalText": "Writes are fast\n\nOnly sequential appends,\nno per-message\nbookkeeping.",
