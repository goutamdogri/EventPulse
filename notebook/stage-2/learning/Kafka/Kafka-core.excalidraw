			"boundElements": [],
			"updated": 1795739525658,
			"link": null,
			"locked": false,
			"text": "Offset lag ≠ time lag:\n10,000 records = 0.5 s at 20,000 events/s,\nbut minutes at 50 events/s → also track\nep_event_freshness_seconds",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "MUE-d0Q4z48ulogI4bdsX",
			"originalText": "Offset lag ≠ time lag:\n10,000 records = 0.5 s at 20,000 events/s,\nbut minutes at 50 events/s → also track\nep_event_freshness_seconds",
			"autoResize": true,
			"lineHeight": 1.25,
