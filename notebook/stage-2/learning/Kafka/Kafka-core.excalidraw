			"seed": 1283628575,
			"version": 429,
			"versionNonce": 702891489,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739525667,
			"link": null,
			"locked": false,
			"text": "• Its fetch for that partition fails; it refreshes metadata\nand continues from its position.\n• A leader election does NOT cause a consumer group\nrebalance: membership is unchanged.\n• It reads only up to the high watermark, so it never sees\ndata that is later truncated.\n• Commits may fail briefly (the __consumer_offsets partition\nleader may have moved) and are retried.",
			"originalText": "• Its fetch for that partition fails; it refreshes metadata\nand continues from its position.\n• A leader election does NOT cause a consumer group\nrebalance: membership is unchanged.\n• It reads only up to the high watermark, so it never sees\ndata that is later truncated.\n• Commits may fail briefly (the __consumer_offsets partition\nleader may have moved) and are retried.",
			"fontSize": 18,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": "T0oYyUE-F8K4lG6I5ph6u",
			"autoResize": true,
			"lineHeight": 1.25,
			"index": "c0dNB",
			"created": 1795576972589,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
