			"updated": 1795739525674,
			"link": null,
			"locked": false,
			"text": "Producer clock in the past,\nor a backfill of old data:\nthe segment looks old at\nonce and is deleted at the\nNEXT check, seconds after\nbeing written",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "Yv3_TxylPkUOchgG9STCp",
			"originalText": "Producer clock in the past,\nor a backfill of old data:\nthe segment looks old at\nonce and is deleted at the\nNEXT check, seconds after\nbeing written",
