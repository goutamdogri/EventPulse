			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739608536,
			"link": null,
			"locked": false,
			"text": "Cons: the sender must know every receiver; a down receiver\nneeds retries and a store anyway; no buffer, no replay;\nretry storms when many receivers fail together",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "laORmqp_dqy1vXbF9e2_C",
			"originalText": "Cons: the sender must know every receiver; a down receiver\nneeds retries and a store anyway; no buffer, no replay;\nretry storms when many receivers fail together",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795406001443,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
