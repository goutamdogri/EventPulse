			"seed": 733774952,
			"version": 341,
			"versionNonce": 1477027009,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739608536,
			"link": null,
			"locked": false,
			"text": "Lists work as a simple queue. Pub/sub\npushes to live subscribers only. Streams\nkeep entries in a log with consumer\ngroups. Everything is held in memory.",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "v62Hg7kj_6Q_cRDlIynGH",
			"originalText": "Lists work as a simple queue. Pub/sub\npushes to live subscribers only. Streams\nkeep entries in a log with consumer\ngroups. Everything is held in memory.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795406001443,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
