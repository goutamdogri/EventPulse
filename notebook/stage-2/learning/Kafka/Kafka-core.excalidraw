			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739608537,
			"link": null,
			"locked": false,
			"text": "Why EventPulse lands on Kafka\n\nIngest must absorb bursts and stay up when\nthe database is slow. The same events feed the\nDB sink, analytics and rule engine, and must be\nreplayable. Target: up to 1M requests/second.",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "Z-SQYQkAgRFBjuJDOHjpf",
			"originalText": "Why EventPulse lands on Kafka\n\nIngest must absorb bursts and stay up when\nthe database is slow. The same events feed the\nDB sink, analytics and rule engine, and must be\nreplayable. Target: up to 1M requests/second.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795406001446,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
