			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739525661,
			"link": null,
			"locked": false,
			"text": "no-loss failures (acks=all) = min ISR - 1\nwrite-available failures = RF - min ISR\nRF 3, min ISR 2  ->  1 and 1\nRF 3, min ISR 3  ->  2 and 0",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "sLlF7tXjpKmFJBC9kffTG",
			"originalText": "no-loss failures (acks=all) = min ISR - 1\nwrite-available failures = RF - min ISR\nRF 3, min ISR 2  ->  1 and 1\nRF 3, min ISR 3  ->  2 and 0",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795574401631,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
