			"updated": 1795739525643,
			"link": null,
			"locked": false,
			"text": "File name = base offset\n00000000000000001028.log\nstarts at offset 1028 (zero padded to 20 digits)\nWhich file holds offset X? The one with the\nlargest base offset <= X (X=1500 -> ...1028.log)",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "fn",
			"originalText": "File name = base offset\n00000000000000001028.log\nstarts at offset 1028 (zero padded to 20 digits)\nWhich file holds offset X? The one with the\nlargest base offset <= X (X=1500 -> ...1028.log)",
			"autoResize": true,
