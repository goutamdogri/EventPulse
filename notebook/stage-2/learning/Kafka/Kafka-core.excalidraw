			"boundElements": [],
			"updated": 1795739525660,
			"link": null,
			"locked": false,
			"text": "Consumers read only BELOW\nthe high watermark, so they\nnever see data that a failover\ncould erase.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
