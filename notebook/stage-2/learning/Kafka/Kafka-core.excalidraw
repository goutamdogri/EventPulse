			"updated": 1795739525660,
			"link": null,
			"locked": false,
			"text": "HW = min(13, 13, 13) = 13\nConsumers can now read 11 and 12.\nThe acks=all producer gets its success.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "3Yl1Xjq-HFvWUBbL603UG",
			"originalText": "HW = min(13, 13, 13) = 13\nConsumers can now read 11 and 12.\nThe acks=all producer gets its success.",
