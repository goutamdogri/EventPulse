			"link": null,
			"locked": false,
			"text": "Cons: lost if the process dies (so the 202 was a lie);\nmemory grows with the backlog; one process only,\nnot shared between API instances",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "cFl7-0A3j9xGkntI1a3Zl",
			"originalText": "Cons: lost if the process dies (so the 202 was a lie);\nmemory grows with the backlog; one process only,\nnot shared between API instances",
