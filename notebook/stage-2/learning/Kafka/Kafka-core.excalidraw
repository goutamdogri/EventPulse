			"updated": 1795739608536,
			"link": null,
			"locked": false,
			"text": "Producers send to a queue. The broker\nholds each message until a consumer\ntakes it and acknowledges it, then\ndeletes it. Many consumers can share\none queue (competing consumers).",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "gev7RiaQZdj3gvqX2L41R",
			"originalText": "Producers send to a queue. The broker\nholds each message until a consumer\ntakes it and acknowledges it, then\ndeletes it. Many consumers can share\none queue (competing consumers).",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795406001443,
