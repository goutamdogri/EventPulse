			"link": null,
			"locked": false,
			"text": "Increase only\nyou can add partitions,\nnever remove them.\n--partitions 2 on a topic\nwith 3 is refused.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "rg1",
			"originalText": "Increase only\nyou can add partitions,\nnever remove them.\n--partitions 2 on a topic\nwith 3 is refused.",
