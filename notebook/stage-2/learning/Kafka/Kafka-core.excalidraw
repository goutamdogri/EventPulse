			"link": null,
			"locked": false,
			"text": "Remember the key sentence: Kafka is a LOG, not a task queue.\nIt is superb at moving and keeping huge streams of events for many readers.\nIt is not the tool for 'run this job once, retry it in 10 minutes, with priority'.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "mXuhrf-oeeYTopBRukJqF",
