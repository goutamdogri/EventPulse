			"link": null,
			"locked": false,
			"text": "DB commit first, offset second\na crash in between re-reads a few records\n(duplicates), absorbed by ON CONFLICT\n(event_id) DO NOTHING. At-least-once, by design.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "qo1",
			"originalText": "DB commit first, offset second\na crash in between re-reads a few records\n(duplicates), absorbed by ON CONFLICT\n(event_id) DO NOTHING. At-least-once, by design.",
