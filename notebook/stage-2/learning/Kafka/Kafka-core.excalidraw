			"updated": 1795739525643,
			"link": null,
			"locked": false,
			"text": "Compression is per batch: bigger batches compress\nbetter. The broker stores the batch as the producer\ncompressed it; the consumer decompresses.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "bn1",
			"originalText": "Compression is per batch: bigger batches compress\nbetter. The broker stores the batch as the producer\ncompressed it; the consumer decompresses.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
