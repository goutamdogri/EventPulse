			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739525652,
			"link": null,
			"locked": false,
			"text": "Result: for about half the keys, new\nrecords land in a different partition than\nolder records of the same key. Old data does\nnot move; per-key order across the\nchange is lost (Lab 5).",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "rf2",
			"originalText": "Result: for about half the keys, new\nrecords land in a different partition than\nolder records of the same key. Old data does\nnot move; per-key order across the\nchange is lost (Lab 5).",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
