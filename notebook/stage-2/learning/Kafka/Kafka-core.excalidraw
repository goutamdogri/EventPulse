			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739525676,
			"link": null,
			"locked": false,
			"text": "EventPulse events.raw [observed]: retention.ms 24 h, retention.bytes -1,\nsegments 1 GiB / 7 days, cleanup.policy delete. events.dlq keeps 7 days.\nDecide on purpose: keep defaults (window is up to a week at low volume),\nset segment.ms (for example 1 hour) for honest retention, or use a scratch\ntopic with tiny segments for fall-behind experiments (recommended).",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "LvXhSdyE9PrmbYkka4o53",
			"originalText": "EventPulse events.raw [observed]: retention.ms 24 h, retention.bytes -1,\nsegments 1 GiB / 7 days, cleanup.policy delete. events.dlq keeps 7 days.\nDecide on purpose: keep defaults (window is up to a week at low volume),\nset segment.ms (for example 1 hour) for honest retention, or use a scratch\ntopic with tiny segments for fall-behind experiments (recommended).",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795577829171,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
