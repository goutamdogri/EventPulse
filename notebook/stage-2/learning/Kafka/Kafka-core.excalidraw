			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739525658,
			"link": null,
			"locked": false,
			"text": "Lag uses COMMITTED offsets, a lower bound\non progress: it over-reports between commits\n→ a sawtooth that follows the commit interval.\nWith commits after the DB commit it means\n'not yet safely stored'.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "Et3r9geyt16rWTUyYIEaS",
			"originalText": "Lag uses COMMITTED offsets, a lower bound\non progress: it over-reports between commits\n→ a sawtooth that follows the commit interval.\nWith commits after the DB commit it means\n'not yet safely stored'.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795572381908,
