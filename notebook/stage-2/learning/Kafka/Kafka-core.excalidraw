			"link": null,
			"locked": false,
			"text": "Changing retention is RETROACTIVE [reasoning]: the next janitor run applies it\nto existing segments. Lowering can delete a lot at once; raising cannot bring\ndeleted data back.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
