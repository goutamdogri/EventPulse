			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739608537,
			"link": null,
			"locked": false,
			"text": "But one log on one machine is not enough. To scale it must be split (partitions),\nto survive failures it must be copied (replication), and to fit on disk it must be\ntrimmed (segments + retention). The chapters on the right build exactly that.",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "qma9jqOq1dxRscB-L_dyZ",
			"originalText": "But one log on one machine is not enough. To scale it must be split (partitions),\nto survive failures it must be copied (replication), and to fit on disk it must be\ntrimmed (segments + retention). The chapters on the right build exactly that.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795406001445,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
