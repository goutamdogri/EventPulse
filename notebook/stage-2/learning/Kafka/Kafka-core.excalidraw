		{
			"id": "B57AlFVA",
			"type": "text",
			"x": 12653.035755966415,
			"y": 3038.85937487848,
			"width": 550.5264282226562,
			"height": 180,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [
				"SWVpMm-l29RHxflmwHbRL"
			],
			"frameId": null,
