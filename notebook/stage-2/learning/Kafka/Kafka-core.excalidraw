			"frameId": null,
			"index": "barKV",
			"roundness": null,
			"seed": 795366299,
			"version": 22,
			"versionNonce": 1945052353,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739525652,
			"link": null,
			"locked": false,
			"text": "Sizing: partitions >= max( t/p , t/c ), then add headroom. p = what one producer pushes into ONE partition,\nc = what one consumer processes from ONE partition. For EventPulse c (a Postgres batch write) is smaller:\nthe sink, not Kafka, decides the partition count.",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "csz",
			"originalText": "Sizing: partitions >= max( t/p , t/c ), then add headroom. p = what one producer pushes into ONE partition,\nc = what one consumer processes from ONE partition. For EventPulse c (a Postgres batch write) is smaller:\nthe sink, not Kafka, decides the partition count.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
