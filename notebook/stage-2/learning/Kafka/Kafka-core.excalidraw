			"updated": 1795739608537,
			"link": null,
			"locked": false,
			"text": "Example numbers: 6,000 / 600 = 10 s;  360,000 / 600 = 600 s;  21,600,000 / 600 = 36,000 s. Bar lengths are not to scale.",
			"fontSize": 16,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Example numbers: 6,000 / 600 = 10 s;  360,000 / 600 = 600 s;  21,600,000 / 600 = 36,000 s. Bar lengths are not to scale.",
