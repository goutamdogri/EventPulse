		{
			"id": "Cx2lTQLG",
			"type": "text",
			"x": 12028.653858993759,
			"y": 4471.10937487848,
			"width": 1178.7637939453125,
			"height": 47.5,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [
				"SWVpMm-l29RHxflmwHbRL"
			],
			"frameId": null,
			"roundness": null,
			"seed": 879819263,
			"version": 430,
			"versionNonce": 1010789217,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739525668,
			"link": null,
			"locked": false,
			"text": "The old leader never takes over by itself. It returns as a follower and regains leadership only through a preferred election.\nThe only election that is not clean is the unclean one, and it never happens automatically unless you enable it.",
			"originalText": "The old leader never takes over by itself. It returns as a follower and regains leadership only through a preferred election.\nThe only election that is not clean is the unclean one, and it never happens automatically unless you enable it.",
			"fontSize": 19,
			"fontFamily": 1,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "NR5mInn6XtdZqP8Q4qWC9",
			"autoResize": true,
			"lineHeight": 1.25,
