			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739525675,
			"link": null,
			"locked": false,
			"text": "Consequence: at laptop-test volume events.raw effectively keeps data up to a WEEK, not 24 h.\nA 'consumer stays down longer than retention' test will NOT lose data\nunless you shrink segment.ms or segment.bytes on a scratch topic.\nAudit check H (log start offset moved) will normally stay quiet.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "7OI7NmLJLhFS8p3GxW9Jl",
			"originalText": "Consequence: at laptop-test volume events.raw effectively keeps data up to a WEEK, not 24 h.\nA 'consumer stays down longer than retention' test will NOT lose data\nunless you shrink segment.ms or segment.bytes on a scratch topic.\nAudit check H (log start offset moved) will normally stay quiet.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795577829170,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
