			"updated": 1795739525643,
			"link": null,
			"locked": false,
			"text": "Every broker leads exactly 2 of the 6 partitions: an even spread, which is why\n6 partitions on 3 brokers was chosen. Each broker holds all 6 directories (2 as leader, 4 as follower).",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "cl4",
