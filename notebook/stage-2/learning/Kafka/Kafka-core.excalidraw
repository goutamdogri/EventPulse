			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739608537,
			"link": null,
			"locked": false,
			"text": "Kafka = a distributed, partitioned, replicated, durable commit log.\nProducers append to it; consumers pull from it and keep their own offsets.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "2i5Uk3IF30oEdvtWQT2vl",
			"originalText": "Kafka = a distributed, partitioned, replicated, durable commit log.\nProducers append to it; consumers pull from it and keep their own offsets.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795406001445,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
