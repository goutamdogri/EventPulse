			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "6ZAFkVdVjO1QtHMhgsTTE",
			"originalText": "Fan-out is free\n\nA new reader brings its\nown offset. The writer\nnever has to know it.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795406001445,
			"labelPosition": null,
			"baseFontSize": null,
