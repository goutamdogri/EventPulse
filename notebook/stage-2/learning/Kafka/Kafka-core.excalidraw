		{
			"id": "VgXZr1xc",
			"type": "text",
			"x": 12013.035755966415,
			"y": 4103.85937487848,
			"width": 579.9021606445312,
			"height": 180,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
