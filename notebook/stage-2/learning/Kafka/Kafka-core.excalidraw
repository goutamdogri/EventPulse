		{
			"id": "dlvDQ2lE",
			"type": "text",
			"x": 182.08718872070312,
			"y": 14602.5,
			"width": 845.8256225585938,
			"height": 60,
			"angle": 0,
			"strokeColor": "#f59e0b",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
