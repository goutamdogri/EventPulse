			"seed": 170570271,
			"version": 201,
			"versionNonce": 906233345,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739525674,
			"link": null,
			"locked": false,
			"text": "The segment's largest\ntimestamp is in the future,\nso it is not deleted until\nthat time + retention.\nOne bad record pins the\nwhole segment and its disk",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "QGdHXFePVrO0TXqKUhNeo",
			"originalText": "The segment's largest\ntimestamp is in the future,\nso it is not deleted until\nthat time + retention.\nOne bad record pins the\nwhole segment and its disk",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795577829169,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
