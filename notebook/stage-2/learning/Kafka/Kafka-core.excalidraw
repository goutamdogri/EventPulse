			"isDeleted": false,
			"boundElements": [],
			"updated": 1795739608536,
			"link": null,
			"locked": false,
			"text": "The pattern: every crack is tight coupling. The writer is tied to the reader in time (both up now),\nin speed (the slower one sets the pace), in knowledge (the writer knows its readers),\nand in history (nothing is kept). A better design must loosen all four.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "qsE63AbBqjeCEHJPaQFtI",
			"originalText": "The pattern: every crack is tight coupling. The writer is tied to the reader in time (both up now),\nin speed (the slower one sets the pace), in knowledge (the writer knows its readers),\nand in history (nothing is kept). A better design must loosen all four.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": 1795406001441,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
