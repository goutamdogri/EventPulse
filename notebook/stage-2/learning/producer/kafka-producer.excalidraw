			"seed": 506843977,
			"version": 6,
			"versionNonce": 496516075,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795749755390,
			"link": null,
			"locked": false,
			"text": "Trade-off: load spreads, but order is now\nper (tenant, salt), not per tenant.\nConsumers must merge k streams if they\nneed tenant-wide order or aggregates.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "c6sh",
			"originalText": "Trade-off: load spreads, but order is now\nper (tenant, salt), not per tenant.\nConsumers must merge k streams if they\nneed tenant-wide order or aggregates.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
