			"link": null,
			"locked": false,
			"text": "EventPulse: idempotence (client layer) + BATCH_MAX_IN_FLIGHT = 1 (app layer)\n= two independent protections for per-key order across batches",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
