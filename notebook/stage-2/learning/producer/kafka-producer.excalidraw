			"updated": 1795749738495,
			"link": null,
			"locked": false,
			"text": "Principle: make the FINAL write idempotent; everything upstream only reduces how often it has to work.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Principle: make the FINAL write idempotent; everything upstream only reduces how often it has to work.",
