			"isDeleted": false,
			"boundElements": [],
			"updated": 1795749712362,
			"link": null,
			"locked": false,
			"text": "The wait is a cost ONLY when the batch does not fill.\nHEAVY load → batches fill instantly → linger.ms never matters.\nLIGHT load → every record waits the full linger.ms → pure added latency.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "c0",
			"originalText": "The wait is a cost ONLY when the batch does not fill.\nHEAVY load → batches fill instantly → linger.ms never matters.\nLIGHT load → every record waits the full linger.ms → pure added latency.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
