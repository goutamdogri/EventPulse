		{
			"id": "DazX1lnJ",
			"type": "text",
			"x": 7157.550354003906,
			"y": 557.5,
			"width": 784.8992919921875,
			"height": 175,
			"angle": 0,
			"strokeColor": "#f59e0b",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
