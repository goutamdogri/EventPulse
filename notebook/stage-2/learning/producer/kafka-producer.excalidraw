			"updated": 1795749732744,
			"link": null,
			"locked": false,
			"text": "Why all is slower: the ack waits for the\nSLOWEST ISR follower, once per batch.\nOne degraded follower delays every\npartition it follows (until it leaves the ISR).",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "c2wy",
			"originalText": "Why all is slower: the ack waits for the\nSLOWEST ISR follower, once per batch.\nOne degraded follower delays every\npartition it follows (until it leaves the ISR).",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
