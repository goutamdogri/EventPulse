			"updated": 1795749755390,
			"link": null,
			"locked": false,
			"text": "Adding partitions or brokers does NOT help:\nthe big key still hashes to ONE partition.\nThroughput ceiling = what one partition can take.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "c6b4",
			"originalText": "Adding partitions or brokers does NOT help:\nthe big key still hashes to ONE partition.\nThroughput ceiling = what one partition can take.",
