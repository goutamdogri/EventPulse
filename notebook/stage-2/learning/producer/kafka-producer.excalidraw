			"isDeleted": false,
			"boundElements": [],
			"updated": 1795749744077,
			"link": null,
			"locked": false,
			"text": "Compression is per BATCH and chosen by the PRODUCER (KAFKA_COMPRESSION, default none).\nThe broker keeps the bytes exactly as sent; the consumer pays to unpack.\nBigger batches compress better ⇒ batching and compression reinforce each other.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "c4q0",
			"originalText": "Compression is per BATCH and chosen by the PRODUCER (KAFKA_COMPRESSION, default none).\nThe broker keeps the bytes exactly as sent; the consumer pays to unpack.\nBigger batches compress better ⇒ batching and compression reinforce each other.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"labelPosition": null,
