			"link": null,
			"locked": false,
			"text": "SETTLE-ONCE: first outcome wins, later ones are\nignored (a flag per batch). Never double-resolve\nor throw on the late result.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "c7x2",
