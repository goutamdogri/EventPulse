		{
			"id": "xFI6cxgK",
			"type": "text",
			"x": 2951.1870727539062,
			"y": 3316.25,
			"width": 797.6258544921875,
			"height": 157.5,
			"angle": 0,
			"strokeColor": "#f59e0b",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [
				"TItDIZaUvjIKifXtZseAJ"
			],
			"frameId": null,
			"index": "b1ml",
			"roundness": null,
			"seed": 937428489,
			"version": 6,
			"versionNonce": 1476643531,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795749738495,
			"link": null,
			"locked": false,
			"text": "Idempotence is per SESSION: the broker drops producer state after a while (idle ≈ 1 day),\nso a very late retry can no longer be recognised.\nIf the broker loses the state (expiry, truncation, unclean election) the producer may hit a\nFATAL error and must be recreated.\nTransactions (transactional.id) add atomic multi-partition writes + a stable identity,\nbut only for Kafka → Kafka. They do NOT make a Postgres write exactly-once.\nEventPulse: at-least-once delivery + an IDEMPOTENT final write (ON CONFLICT).",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "c3sc",
			"originalText": "Idempotence is per SESSION: the broker drops producer state after a while (idle ≈ 1 day),\nso a very late retry can no longer be recognised.\nIf the broker loses the state (expiry, truncation, unclean election) the producer may hit a\nFATAL error and must be recreated.\nTransactions (transactional.id) add atomic multi-partition writes + a stable identity,\nbut only for Kafka → Kafka. They do NOT make a Postgres write exactly-once.\nEventPulse: at-least-once delivery + an IDEMPOTENT final write (ON CONFLICT).",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
