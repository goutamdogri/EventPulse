			"link": null,
			"locked": false,
			"text": "WAITS STACK: batcher wait (5 ms) + client linger (5 ms) on one in-flight batch.\nMeasured, 500 callers: batcher + linger 5 → 16.7k msg/s (worst). So KAFKA_LINGER_MS = 0.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "wr",
			"originalText": "WAITS STACK: batcher wait (5 ms) + client linger (5 ms) on one in-flight batch.\nMeasured, 500 callers: batcher + linger 5 → 16.7k msg/s (worst). So KAFKA_LINGER_MS = 0.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
