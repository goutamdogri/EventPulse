			"isDeleted": false,
			"boundElements": [],
			"updated": 1795749744078,
			"link": null,
			"locked": false,
			"text": "K2 sweep: none / snappy / lz4 / zstd / gzip at several rates and batch sizes.\nRecord: throughput, p50/p99, PRODUCER CPU, BROKER CPU, bytes per record on disk.\nRun each codec through the Node client once (check compresscodec in kafka-dump-log).\nNever force a topic-level codec: leave compression.type=producer.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "c4W",
			"originalText": "K2 sweep: none / snappy / lz4 / zstd / gzip at several rates and batch sizes.\nRecord: throughput, p50/p99, PRODUCER CPU, BROKER CPU, bytes per record on disk.\nRun each codec through the Node client once (check compresscodec in kafka-dump-log).\nNever force a topic-level codec: leave compression.type=producer.",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
