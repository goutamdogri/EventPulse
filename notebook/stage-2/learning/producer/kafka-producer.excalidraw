			"link": null,
			"locked": false,
			"text": "RACE: the 5 s send timeout fires (waiters get 503)\nAND the library's ack arrives later.\nTwo settle attempts for the same batch.",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
