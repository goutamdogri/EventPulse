		{
			"id": "mdybz5Ot",
			"type": "text",
			"x": 7082.650939941406,
			"y": 2368.75,
			"width": 934.6981201171875,
			"height": 112.5,
			"angle": 0,
			"strokeColor": "#8b5cf6",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [
				"_vZHoSyZaoyZtOoEVe2Rk"
			],
			"frameId": null,
			"index": "b27",
			"roundness": null,
			"seed": 948863529,
			"version": 6,
			"versionNonce": 1386186379,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795749755390,
			"link": null,
			"locked": false,
			"text": "EventPulse reading of this choice\n• ordering that matters is per entity/event stream, not global\n• sink dedups by event_id (INSERT … ON CONFLICT DO NOTHING), so it never relies on cross-key order\n• therefore a finer or salted key is cheap; per-tenant order is the only thing given up\nDecide by the question: which ordering does a CONSUMER actually need?",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "c6z",
			"originalText": "EventPulse reading of this choice\n• ordering that matters is per entity/event stream, not global\n• sink dedups by event_id (INSERT … ON CONFLICT DO NOTHING), so it never relies on cross-key order\n• therefore a finer or salted key is cheap; per-tenant order is the only thing given up\nDecide by the question: which ordering does a CONSUMER actually need?",
			"autoResize": true,
			"lineHeight": 1.25,
			"created": null,
			"labelPosition": null,
			"baseFontSize": null,
			"hasTextLink": false,
			"rawText": ""
		},
