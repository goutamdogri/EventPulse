			"text": "Total throughput can look fine\nwhile ONE partition is the limit:\nwatch the max, not the average",
			"fontSize": 18,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "c6m2",
			"originalText": "Total throughput can look fine\nwhile ONE partition is the limit:\nwatch the max, not the average",
