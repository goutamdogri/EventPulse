PORT=
API_KEYS=
BODY_LIMIT=
LOG_ENABLED=
RETRY_AFTER_S=

# --- Stage 2: Kafka client (packages/kafka-config) ---
# Default: localhost:9092,localhost:9094,localhost:9096 (host listeners of docker-compose.kafka.yml)
KAFKA_BROKERS=
KAFKA_CLIENT_ID=
KAFKA_CONNECTION_TIMEOUT_MS=
KAFKA_REQUEST_TIMEOUT_MS=
KAFKA_RETRIES=
KAFKA_RETRY_INITIAL_MS=
KAFKA_RETRY_MAX_MS=
# nothing | error | warn | info | debug
KAFKA_LOG_LEVEL=

# --- Stage 2: producer (set per producer, not per send) ---
# -1 (all ISR, default) | 1 (leader) | 0 (no ack). acks 0/1 need KAFKA_IDEMPOTENT=false.
KAFKA_ACKS=
KAFKA_IDEMPOTENT=
# none | gzip | snappy | lz4 | zstd
KAFKA_COMPRESSION=
# librdkafka batching delay; 0 (default) = the micro-batcher alone decides batches
KAFKA_LINGER_MS=
# librdkafka message.timeout.ms: max time to deliver a message, retries included (default 30000)
KAFKA_DELIVERY_TIMEOUT_MS=
KAFKA_ACK_TIMEOUT_MS=
# tenant (default) | event
KAFKA_KEY_MODE=

# --- Stage 2: micro-batcher ---
BATCH_MAX_MESSAGES=
BATCH_MAX_WAIT_MS=
BATCH_MAX_BYTES=
# 0 = UNBOUNDED mode (experiment K10 only; logs a warning): no queue limit, no breaker,
# no send timeout / queue expiry (KAFKA_SEND_TIMEOUT_MS is ignored)
BATCH_MAX_QUEUE=
BATCH_MAX_QUEUE_BYTES=
BATCH_MAX_IN_FLIGHT=

# Topic to produce to (default events.raw). e2e tests set a throw-away topic.
KAFKA_TOPIC=

# --- Stage 2 S2-F5: Kafka unavailable ---
# Per producer.send timeout (also the cap on queue wait), default 5000
KAFKA_SEND_TIMEOUT_MS=
# consecutive failed sends that open the breaker (default 3, 0 = off) / cooldown before a probe (default 5000)
KAFKA_BREAKER_FAILURES=
KAFKA_BREAKER_COOLDOWN_MS=
# first connect wait at boot before starting anyway (default 10000); background reconnect backoff
KAFKA_STARTUP_WAIT_MS=
KAFKA_RECONNECT_INITIAL_MS=
KAFKA_RECONNECT_MAX_MS=
# SIGTERM: max time to drain the queue when Kafka is down (default 10000)
SHUTDOWN_DRAIN_TIMEOUT_MS=
# Background Kafka health check driving /readyz and the breaker without traffic (default every 2000 ms, 0 = off)
KAFKA_HEALTH_INTERVAL_MS=
KAFKA_HEALTH_TIMEOUT_MS=
# in-sync replicas each partition needs to count as healthy (default 2 with KAFKA_ACKS=-1, else 1)
KAFKA_HEALTH_MIN_ISR=

# --- Stage 2 S2-F6: metrics ---
# librdkafka statistics interval for client queue / broker RTT metrics (default 5000, 0 = off)
KAFKA_STATS_INTERVAL_MS=

# --- Stage 3 S3-F1: API idempotency (Redis, layer 1; the sink's (tenant_id, event_id) key stays the truth) ---
# true (default) | false (C14: measure the cost)
IDEM_ENABLED=
# default redis://localhost:6379; through Toxiproxy: redis://localhost:16379 (make toxiproxy). Tests use /15.
REDIS_URL=
# per command (default 50) / connect (default 1000). Commands are never queued while Redis is disconnected.
REDIS_COMMAND_TIMEOUT_MS=
REDIS_CONNECT_TIMEOUT_MS=
# dedup window of a completed key (default 3600 = 1 h; Redis memory = ~276 B x events/s x window) / of an in-progress key (default 30, > KAFKA_SEND_TIMEOUT_MS)
IDEM_TTL_S=
IDEM_INFLIGHT_TTL_S=
# Redis unreachable: open (default) = accept without dedup, counted | closed = 503 + Retry-After
IDEM_FAILURE_POLICY=
# consecutive Redis failures that open the Redis breaker (default 5, 0 = off) / its cooldown (default 2000)
IDEM_BREAKER_FAILURES=
IDEM_BREAKER_COOLDOWN_MS=
# key prefix in Redis (default idem): idem:<tenant>:<key>
IDEM_KEY_PREFIX=

# --- Stage 3: debug faults (packages/fault-injector). Never set in normal runs. ---
# must be true for FAULTS to be accepted
DEBUG_FAULTS=
# api:before-produce | api:after-produce-before-complete | api:after-complete-before-response, with @N (Nth request)
FAULTS=

# --- Stage 3 S3-F7: Avro + Schema Registry ---
# avro (default): registered Avro schema, Confluent wire format | json: the Stage 2 JSON value (C14, transition)
SERIALIZATION=
# default http://localhost:8081; through Toxiproxy: http://localhost:18081 (make toxiproxy)
SCHEMA_REGISTRY_URL=
SCHEMA_REGISTRY_TIMEOUT_MS=
# default events.raw-value. The writer schema is the newest file in schemas/subjects.json; it must be registered
# first (make schemas): the API only LOOKS UP its id, it never registers.
SCHEMA_SUBJECT=
# startup lookup retried with backoff up to this delay (default 5000); /readyz is 503 until it succeeds
SCHEMA_INIT_RETRY_MAX_MS=

# --- Stage 3 (S3-F8): clock-skew bounds on occurred_at vs the server's received_at (inclusive) ---
# occurred_at more than this many seconds AFTER received_at -> 422 occurred_at_in_future (default 300)
OCCURRED_AT_MAX_FUTURE_S=
# occurred_at more than this many days BEFORE received_at -> 422 occurred_at_too_old (default 365)
OCCURRED_AT_MAX_PAST_DAYS=
