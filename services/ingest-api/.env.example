PORT=
API_KEYS=
BODY_LIMIT=
LOG_ENABLED=
RETRY_AFTER_S=

# --- Stage 2: Kafka client (packages/kafka-config) ---
# Default: localhost:9092,localhost:9094,localhost:9096 (host listeners of docker-compose.kafka.yml)
KAFKA_BROKERS=
KAFKA_CLIENT_ID=
KAFKA_CONNECTION_TIMEOUT_MS=
KAFKA_REQUEST_TIMEOUT_MS=
KAFKA_RETRIES=
KAFKA_RETRY_INITIAL_MS=
KAFKA_RETRY_MAX_MS=
# nothing | error | warn | info | debug
KAFKA_LOG_LEVEL=

# --- Stage 2: producer (set per producer, not per send) ---
# -1 (all ISR, default) | 1 (leader) | 0 (no ack). acks 0/1 need KAFKA_IDEMPOTENT=false.
KAFKA_ACKS=
KAFKA_IDEMPOTENT=
# none | gzip | snappy | lz4 | zstd
KAFKA_COMPRESSION=
# librdkafka batching delay; 0 (default) = the micro-batcher alone decides batches
KAFKA_LINGER_MS=
# librdkafka message.timeout.ms: max time to deliver a message, retries included (default 30000)
KAFKA_DELIVERY_TIMEOUT_MS=
KAFKA_ACK_TIMEOUT_MS=
# tenant (default) | event
KAFKA_KEY_MODE=

# --- Stage 2: micro-batcher ---
BATCH_MAX_MESSAGES=
BATCH_MAX_WAIT_MS=
BATCH_MAX_BYTES=
# 0 = UNBOUNDED mode (experiment K10 only; logs a warning): no queue limit, no breaker,
# no send timeout / queue expiry (KAFKA_SEND_TIMEOUT_MS is ignored)
BATCH_MAX_QUEUE=
BATCH_MAX_QUEUE_BYTES=
BATCH_MAX_IN_FLIGHT=

# Topic to produce to (default events.raw). e2e tests set a throw-away topic.
KAFKA_TOPIC=

# --- Stage 2 S2-F5: Kafka unavailable ---
# Per producer.send timeout (also the cap on queue wait), default 5000
KAFKA_SEND_TIMEOUT_MS=
# consecutive failed sends that open the breaker (default 3, 0 = off) / cooldown before a probe (default 5000)
KAFKA_BREAKER_FAILURES=
KAFKA_BREAKER_COOLDOWN_MS=
# first connect wait at boot before starting anyway (default 10000); background reconnect backoff
KAFKA_STARTUP_WAIT_MS=
KAFKA_RECONNECT_INITIAL_MS=
KAFKA_RECONNECT_MAX_MS=
# SIGTERM: max time to drain the queue when Kafka is down (default 10000)
SHUTDOWN_DRAIN_TIMEOUT_MS=
# Background Kafka health check driving /readyz and the breaker without traffic (default every 2000 ms, 0 = off)
KAFKA_HEALTH_INTERVAL_MS=
KAFKA_HEALTH_TIMEOUT_MS=
# in-sync replicas each partition needs to count as healthy (default 2 with KAFKA_ACKS=-1, else 1)
KAFKA_HEALTH_MIN_ISR=
