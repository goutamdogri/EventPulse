# admin-api (S3-F4). Copy to .env.
PORT=8020
# Authorization: Bearer <ADMIN_API_KEY> (>= 16 characters). NOT a tenant key.
ADMIN_API_KEY=
# Same database as consumer-sink (tenants, tenant_config, outbox)
DATABASE_URL=
PG_POOL_MAX=
PG_STATEMENT_TIMEOUT_MS=
BODY_LIMIT=
LOG_ENABLED=
# Topic of config.changed outbox rows (default config.changed)
CONFIG_TOPIC=
# NOTIFY outbox_new on enqueue (default true)
OUTBOX_NOTIFY=
SCHEMA_REGISTRY_URL=
SCHEMA_REGISTRY_TIMEOUT_MS=
SCHEMA_INIT_RETRY_MAX_MS=
RETRY_AFTER_S=
# Debug-only: crash point admin:after-update-before-commit
DEBUG_FAULTS=
FAULTS=
FAULT_ERRORS=
