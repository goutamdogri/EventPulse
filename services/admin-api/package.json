{
  "name": "@eventpulse/admin-api",
  "version": "0.0.1",
  "description": "Stage 3 (S3-F4): tenant config admin API. Writes tenant_config and the config.changed outbox row in one transaction.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @eventpulse/kafka-config --filter @eventpulse/fault-injector --filter @eventpulse/schema --filter @eventpulse/retry --filter @eventpulse/outbox build && nest build",
    "start": "nest start",
    "start:prod": "node --env-file=.env dist/main.js",
    "seed": "node --env-file-if-exists=.env dist/seed.js",
    "pretest": "pnpm --filter @eventpulse/kafka-config --filter @eventpulse/fault-injector --filter @eventpulse/schema --filter @eventpulse/retry --filter @eventpulse/outbox build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@eventpulse/fault-injector": "workspace:*",
    "@eventpulse/kafka-config": "workspace:*",
    "@eventpulse/outbox": "workspace:*",
    "@eventpulse/retry": "workspace:*",
    "@eventpulse/schema": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prometheus-io/client": "^0.16.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
