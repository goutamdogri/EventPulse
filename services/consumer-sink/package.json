{
  "name": "@eventpulse/consumer-sink",
  "version": "0.0.1",
  "description": "Stage 2: consumer group sink-postgres reads events.raw and writes batches to Postgres.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @eventpulse/kafka-config --filter @eventpulse/fault-injector --filter @eventpulse/idempotency --filter @eventpulse/schema build && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node --env-file=.env dist/main.js",
    "start:pinned": "taskset -c ${CONSUMER_CPUS:-0,6} node --env-file=.env dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "pretest": "pnpm --filter @eventpulse/kafka-config --filter @eventpulse/fault-injector --filter @eventpulse/idempotency --filter @eventpulse/schema build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "pnpm --filter @eventpulse/ingest-api build && pnpm build",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "migrate": "dotenv run -f .env -- node-pg-migrate -m ../../db/migrations -j sql",
    "migrate:up": "pnpm migrate up",
    "migrate:down": "pnpm migrate down 1",
    "migrate:new": "pnpm migrate create",
    "migrate:test": "dotenv run -f .env.test -- node-pg-migrate -m ../../db/migrations -j sql up"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "1.11.0",
    "@eventpulse/fault-injector": "workspace:*",
    "@eventpulse/idempotency": "workspace:*",
    "@eventpulse/kafka-config": "workspace:*",
    "@eventpulse/schema": "workspace:*",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@prometheus-io/client": "^0.16.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.10",
    "node-pg-migrate": "^9.0.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
