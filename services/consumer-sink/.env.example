DATABASE_URL=
# HTTP port for /healthz, /readyz, /metrics, /debug/stats (default 8001; give each instance its own)
METRICS_PORT=
# true by default (assignment / rebalance logs)
LOG_ENABLED=

# --- Postgres pool ---
PG_POOL_MAX=
PG_CONN_TIMEOUT_MS=
PG_STATEMENT_TIMEOUT_MS=

# --- Kafka client (packages/kafka-config) ---
# Default: localhost:9092,localhost:9094,localhost:9096
KAFKA_BROKERS=
KAFKA_CLIENT_ID=
KAFKA_LOG_LEVEL=

# --- Consumer group ---
# default sink-postgres
CONSUMER_GROUP_ID=
# true (default) = earliest when the group has no committed offset; false = latest
CONSUMER_FROM_BEGINNING=
CONSUMER_SESSION_TIMEOUT_MS=
CONSUMER_HEARTBEAT_INTERVAL_MS=
# also the max processing time of one batch with this client
CONSUMER_REBALANCE_TIMEOUT_MS=
# bounded prefetch
CONSUMER_MAX_BYTES_PER_PARTITION=
CONSUMER_MAX_BYTES=
CONSUMER_MAX_WAIT_MS=
# max messages per eachBatch call (default 1000)
CONSUMER_MAX_BATCH_SIZE=
# must be <= PG_POOL_MAX (default 1)
CONSUMER_PARTITIONS_CONCURRENTLY=
# roundRobin (default) | range | cooperativeSticky
CONSUMER_ASSIGNOR=

# --- Sink ---
# rows per INSERT / transaction (default 1000)
SINK_MAX_ROWS=
# artificial work per chunk before the DB write, ms (default 0; tests and K8)
SINK_PROCESSING_DELAY_MS=
# source topic (default events.raw; tests use a throw-away topic)
CONSUMER_TOPIC=

# --- Debug faults (packages/fault-injector; S2-F3, K5, Stage 3). Never set in normal runs. ---
# must be true for any fault below to be accepted (and for POST /debug/faults to exist)
DEBUG_FAULTS=
# Stage 3 form: <point>[@N | @bN], comma-separated. @N = Nth hit of the point, @bN = first hit in the Nth batch.
# Points: consumer:before-parse, consumer:after-parse, consumer:before-insert, consumer:after-insert-before-commit,
#         consumer:after-db-commit, consumer:after-offset-commit
FAULTS=
# Injected errors: <point>=<CODE>[xN|x*][:marker=TEXT], e.g. consumer:before-insert=40001x2:marker=retry-me
FAULT_ERRORS=
# Stage 2 form (still accepted): none | before_parse | after_parse | after_db_commit, on batch CRASH_AFTER_BATCHES
CRASH_AT=
CRASH_AFTER_BATCHES=
# K5: false = plain INSERT (no ON CONFLICT) into SINK_NODEDUP_TABLE (default events_nodedup, a copy of events with no
# primary key), so a reprocessed row is stored twice. Needs DEBUG_FAULTS=true. Default true.
SINK_DEDUP=
SINK_NODEDUP_TABLE=

# --- Poison handling (S2-F4) ---
# true (default): bad records go to the DLQ. false: a bad record blocks its partition (S2-F3 behavior)
SINK_DLQ_ENABLED=
# default events.dlq
SINK_DLQ_TOPIC=
# retries of one isolated bad row before it is dead-lettered (default 3)
SINK_MAX_RETRIES=
# exponential backoff with jitter: base, doubling per attempt, capped (defaults 100 / 5000)
SINK_RETRY_BASE_MS=
SINK_RETRY_MAX_MS=
# DB down: retry inside one batch for this long, then pause the partition (default 20000;
# window + SINK_RETRY_MAX_MS must be < CONSUMER_REBALANCE_TIMEOUT_MS)
SINK_TRANSIENT_RETRY_WINDOW_MS=
# how long a partition stays paused before the chunk is retried (default 5000)
SINK_PAUSE_MS=

# --- Metrics (S2-F6) ---
# how often the group lag is polled for /metrics and /debug/stats (default 2000, 0 = off)
LAG_POLL_MS=
